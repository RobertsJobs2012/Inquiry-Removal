---
const groups = [
  {
    title: "Explore",
    links: [
      ["How It Works", "/how-it-works/"],
      ["Eligibility", "/eligibility/"],
      ["Results", "/results/"],
      ["Pricing", "/pricing/"],
    ],
  },
  {
    title: "Learn",
    links: [
      ["Resources", "/resources/"],
      ["FAQ", "/faq/"],
      ["Dealership Inquiries", "/dealership-hard-inquiries/"],
      ["Identity Theft", "/identity-theft-inquiries/"],
    ],
  },
  {
    title: "Company",
    links: [
      ["About", "/about/"],
      ["Privacy", "/privacy/"],
      ["Terms", "/terms/"],
      ["Accessibility", "/accessibility/"],
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a class="wordmark" href="/" aria-label="Inquiry Removal home">
        <span class="wordmark-mark" aria-hidden="true"
          ><i></i><i></i><i></i></span
        >
        <span>Inquiry <strong>Removal</strong></span>
      </a>
      <p>Hard Inquiry Specialists.<br /><strong>Nothing Else.</strong></p>
    </div>
    {
      groups.map((group) => (
        <div class="footer-group">
          <h2>{group.title}</h2>
          {group.links.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Inquiry Removal. All rights reserved.</p>
    <p>
      Educational information only. Individual circumstances and results vary.
    </p>
  </div>
</footer>
