---
const groups = [
  {
    title: "Inquiry Removal",
    links: [
      ["How It Works", "/how-it-works/"],
      ["Situations We Handle", "/situations-we-handle/"],
      ["Pricing", "/pricing/"],
      ["FAQ", "/faq/"],
      ["Free Inquiry Review", "/free-inquiry-review/"],
    ],
  },
  {
    title: "Resources",
    links: [
      ["Dealership Inquiries", "/dealership-inquiries/"],
      ["Unauthorized Inquiries", "/unauthorized-inquiries/"],
      ["Identity Theft", "/identity-theft-inquiries/"],
      ["Eligibility", "/eligibility/"],
    ],
  },
  {
    title: "Company",
    links: [
      ["About", "/about/"],
      ["Contact", "/contact/"],
    ],
  },
];
---

<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a class="footer-logo" href="/" aria-label="Inquiry Removal home">
        <img
          src="/brand/logo-full-light-480.png"
          width="480"
          height="293"
          alt="Inquiry Removal"
          loading="lazy"
          decoding="async"
        />
      </a>
      <p>Hard Inquiry Specialists.<br /><strong>Nothing Else.</strong></p>
      <p class="footer-description">
        Nationwide service for Experian, Equifax, and TransUnion hard inquiries.
      </p>
      <div class="footer-contact">
        <a
          class="button button--small"
          href="tel:+16023776626"
          aria-label="Call Inquiry Removal at 602-377-6626"
          >Call Inquiry Removal</a
        >
        <a class="text-link text-link--light" href="/contact/"
          >Contact Inquiry Removal →</a
        >
      </div>
    </div>
    {
      groups.map((group) => (
        <div class="footer-group">
          <h2>{group.title}</h2>
          {group.links.map(([label, href]) => (
            <a href={href}>{label}</a>
          ))}
        </div>
      ))
    }
  </div>
  <div class="footer-bottom">
    <p>© {new Date().getFullYear()} Inquiry Removal. All rights reserved.</p>
    <p>
      Inquiry Removal provides credit-report assistance focused on hard
      inquiries. No specific deletion, timeline, approval, or credit score
      change is guaranteed. Results vary based on individual reports,
      documentation, creditor responses, and credit bureau investigations.
      Consumers may dispute inaccurate credit-report information directly with
      consumer reporting agencies at no cost. Services require a written
      agreement and include a three-business-day right to cancel.
    </p>
  </div>
</footer>
