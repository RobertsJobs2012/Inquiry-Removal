---
import Logo from "./Logo.astro";
import PremiumIcon from "./PremiumIcon.astro";

const COMPANY_LINKS = [
  { label: "About", href: "/about" },
  { label: "Results", href: "/results" },
  { label: "Compare", href: "/compare" },
  { label: "Blog", href: "/blog" },
  { label: "FAQ", href: "/faq" },
];

const SERVICE_LINKS = [
  { label: "How It Works", href: "/how-it-works" },
  { label: "Pricing", href: "/pricing" },
  { label: "Three-bureau removal", href: "/services" },
  { label: "Unauthorized inquiries", href: "/unauthorized-hard-inquiry-removal" },
  { label: "Identity theft inquiries", href: "/identity-theft-inquiry-removal" },
  { label: "Car dealership inquiries", href: "/car-dealership-inquiry-removal" },
  { label: "Mortgage approval inquiries", href: "/hard-inquiry-removal-mortgage" },
  { label: "Free Analysis", href: "/get-started" },
];

const BUREAU_LINKS = [
  { label: "Experian inquiry removal", href: "/remove-hard-inquiry-experian" },
  { label: "TransUnion inquiry removal", href: "/remove-hard-inquiry-transunion" },
  { label: "Equifax inquiry removal", href: "/remove-hard-inquiry-equifax" },
];

const LEGAL_LINKS: { label: string; href: string }[] = [
  { label: "Privacy Policy", href: "/privacy-policy" },
];

const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
      <div class="container footer-shell">
        <div class="footer-grid">
          <section class="footer-brand" aria-label="Inquiry Removal company information">
            <a
              href="/"
              aria-label="Inquiry Removal — homepage"
              class="footer-logo"
            >
              <Logo size="sm" />
            </a>

            <p class="footer-tagline">
              The only nationwide service that specializes exclusively in hard
              inquiry removal. Since 2015.
            </p>

            <div class="footer-contact">
              <a href="tel:+16023776626" class="footer-contact-link">
                <span class="footer-contact-icon" aria-hidden="true">
                  <PremiumIcon name="phone" size={17} strokeWidth={1.55} />
                </span>
                <span>(602) 377-6626</span>
              </a>
              <a
                href="mailto:support@inquiryremoval.com"
                class="footer-contact-link"
              >
                <span class="footer-contact-icon" aria-hidden="true">
                  <PremiumIcon name="mail" size={17} strokeWidth={1.55} />
                </span>
                <span>Email us</span>
              </a>
            </div>

            <p class="footer-location">
              Nationwide service — founded in Phoenix, Arizona
            </p>

            <div class="footer-proof-pills" aria-label="Trust indicators">
              <span>Flat fee</span>
              <span>SSL secured</span>
              <span>
                <PremiumIcon name="star" size={12} /> 4.9 rating
              </span>
            </div>
          </section>

          <div class="footer-columns">
            <nav class="footer-nav-col footer-company" aria-label="Company links">
              <h3 class="footer-col-title">Company</h3>
              <ul>
                {COMPANY_LINKS.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>

            <nav class="footer-nav-col footer-services" aria-label="Service links">
              <h3 class="footer-col-title">Services</h3>
              <ul>
                {SERVICE_LINKS.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
              <h3 class="footer-col-title footer-col-title-sub">By bureau</h3>
              <ul>
                {BUREAU_LINKS.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            </nav>

            <section class="footer-start" aria-label="Get started">
              <h3 class="footer-col-title">Get started</h3>
              <p>
                Ready to take the next step? Book your free consultation today —
                no obligation, no pressure.
              </p>

              <a href="/get-started" class="btn btn-primary footer-primary">
                Get Free Analysis <span aria-hidden="true">→</span>
              </a>
              <a href="tel:+16023776626" class="footer-call-button">
                Call Robert
              </a>

              <div class="footer-or" aria-hidden="true">
                Or
              </div>

              <div class="footer-record">
                <div class="footer-record-label">Track record</div>
                <strong>100,437 hard inquiries removed for 1,123 clients</strong>
                <a href="/results">
                  See real results <span aria-hidden="true">→</span>
                </a>
              </div>
            </section>
          </div>
        </div>

        <div class="footer-bottom">
          <p class="footer-copyright">
            © {year} Inquiry Removal LLC · Made in Phoenix, Arizona
          </p>

          {LEGAL_LINKS.length > 0 ? (
            <nav class="footer-legal" aria-label="Legal links">
              {LEGAL_LINKS.map((link) => (
                <a href={link.href}>
                  {link.label}
                </a>
              ))}
            </nav>
          ) : null}

          <p class="footer-disclaimer">
            Inquiry Removal is a credit repair organization. Results vary based
            on individual circumstances. Federal law gives you the right to
            dispute information directly with credit bureaus at no cost.
          </p>
        </div>
      </div>
</footer>

<style>
  .footer-shell {
    position: relative;
    z-index: 1;
  }

  .footer-brand {
    align-self: start;
    padding-top: 0;
  }

  .footer-tagline {
    font-size: 17px;
    line-height: 1.7;
    color: var(--text-body);
    max-width: 390px;
    margin-bottom: 34px;
  }

  .footer-contact {
    display: grid;
    gap: 18px;
    margin-bottom: 28px;
  }

  .footer-contact-icon {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: var(--text-body);
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid var(--border-soft);
  }

  .footer-location {
    font-size: 14px;
    color: var(--text-muted);
    margin: 28px 0 20px;
  }

  .footer-col-title {
    font-family: var(--font-body), sans-serif;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--brand-pink);
    padding-bottom: 16px;
    margin-top: 0;
    margin-bottom: 22px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-col-title-sub {
    margin-top: 28px;
    color: var(--brand-blue);
    font-size: 12px;
    letter-spacing: 0.16em;
  }

  .footer-or {
    text-align: center;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 12px;
    font-weight: 800;
    margin: 28px 0 24px;
  }

  .footer-record-label {
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 12px;
    font-weight: 800;
    margin-bottom: 14px;
  }

  .footer-copyright,
  .footer-disclaimer {
    font-size: 12px;
    color: var(--text-muted);
  }
</style>
