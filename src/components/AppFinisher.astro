<script>
  // Add a clear post-submit handoff receipt without changing the form payload.
  const reviewSuccess = document.querySelector<HTMLElement>("[data-review-success]");
  if (reviewSuccess && !reviewSuccess.querySelector(".review-success-path")) {
    const path = document.createElement("ol");
    path.className = "review-success-path";
    path.setAttribute("aria-label", "What happens next");
    path.innerHTML = `
      <li><span>01</span><strong>Information received</strong><small>Your review request is safely in the queue.</small></li>
      <li><span>02</span><strong>Specialist review</strong><small>We organize the inquiry count, bureaus, and situation you described.</small></li>
      <li><span>03</span><strong>Personal follow-up</strong><small>We contact you using the method you selected and explain the next step.</small></li>
    `;
    reviewSuccess.appendChild(path);
  }

  // Give large hero visuals a few pixels of depth on desktop, never on touch/reduced-motion devices.
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const canParallax = window.matchMedia("(min-width: 1101px) and (hover: hover)").matches;
  const heroVisual = document.querySelector<HTMLElement>(
    ".hero-interface, .dealer-inquiry-visual, .evidence-console",
  );
  const heroRoot = heroVisual?.closest<HTMLElement>(
    ".hero, .dealer-hero, .results-hero",
  );

  if (!reduceMotion && canParallax && heroVisual && heroRoot) {
    let frame = 0;
    const updateHeroDepth = () => {
      frame = 0;
      const rect = heroRoot.getBoundingClientRect();
      if (rect.bottom < 0 || rect.top > window.innerHeight) return;
      const progress = Math.min(1, Math.max(0, -rect.top / Math.max(1, rect.height)));
      heroVisual.style.setProperty("--hero-depth-y", `${progress * -14}px`);
    };
    const requestHeroDepth = () => {
      if (frame) return;
      frame = requestAnimationFrame(updateHeroDepth);
    };
    updateHeroDepth();
    window.addEventListener("scroll", requestHeroDepth, { passive: true });
  }
</script>

<style is:global>
  @media (min-width: 1101px) and (prefers-reduced-motion: no-preference) {
    .hero-interface,
    .results-hero .evidence-console {
      translate: 0 var(--hero-depth-y, 0px);
      transition: translate 90ms linear;
    }
  }
</style>
