---
const offerEnds = "2026-09-06T23:59:59-07:00";
const offerHref =
  "/free-inquiry-review/?promo=labor-day-50&source=mobile-announcement#online-review";
---

<div
  class="labor-day-announcement"
  data-labor-day-announcement
  data-offer-ends={offerEnds}
  role="region"
  aria-label="Labor Day weekend promotion"
>
  <a
    class="labor-day-announcement__link"
    href={offerHref}
    data-track="mobile-labor-day-announcement"
    data-context="labor-day-50"
  >
    <span class="labor-day-announcement__topline">
      <span class="labor-day-announcement__event">Labor Day Weekend</span>
      <strong class="labor-day-announcement__offer">50% OFF</strong>
      <span class="labor-day-announcement__cta">Claim Offer <i aria-hidden="true">→</i></span>
    </span>

    <span class="labor-day-announcement__bottomline">
      <span class="labor-day-announcement__deadline">Ends Sunday at midnight</span>
      <span class="labor-day-announcement__countdown" aria-hidden="true">
        <b data-promo-days>00</b><small>D</small>
        <i>:</i>
        <b data-promo-hours>00</b><small>H</small>
        <i>:</i>
        <b data-promo-minutes>00</b><small>M</small>
        <i>:</i>
        <b data-promo-seconds>00</b><small>S</small>
      </span>
    </span>

    <span class="sr-only">
      Labor Day weekend: 50 percent off. Offer ends Sunday, September 6, 2026 at 11:59 PM Arizona time.
    </span>
  </a>
</div>

<script is:inline>
  (() => {
    const bar = document.querySelector("[data-labor-day-announcement]");
    if (!(bar instanceof HTMLElement)) return;

    const deadlineValue = bar.dataset.offerEnds;
    if (!deadlineValue) return;

    const deadline = new Date(deadlineValue).getTime();
    const days = bar.querySelector("[data-promo-days]");
    const hours = bar.querySelector("[data-promo-hours]");
    const minutes = bar.querySelector("[data-promo-minutes]");
    const seconds = bar.querySelector("[data-promo-seconds]");
    let timer;

    const setValue = (node, value) => {
      if (node) node.textContent = String(value).padStart(2, "0");
    };

    const updateCountdown = () => {
      const remaining = deadline - Date.now();

      if (remaining <= 0) {
        bar.hidden = true;
        document.documentElement.classList.remove("has-labor-day-announcement");
        if (timer) window.clearInterval(timer);
        return;
      }

      document.documentElement.classList.add("has-labor-day-announcement");
      const totalSeconds = Math.floor(remaining / 1000);
      setValue(days, Math.floor(totalSeconds / 86400));
      setValue(hours, Math.floor((totalSeconds % 86400) / 3600));
      setValue(minutes, Math.floor((totalSeconds % 3600) / 60));
      setValue(seconds, totalSeconds % 60);
    };

    updateCountdown();
    timer = window.setInterval(updateCountdown, 1000);
  })();
</script>

<style>
  .labor-day-announcement {
    display: none;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 1100px) {
    .labor-day-announcement {
      position: relative;
      display: block;
      overflow: hidden;
      color: #fff;
      background:
        radial-gradient(circle at 18% -60%, rgba(121, 199, 255, 0.32), transparent 46%),
        radial-gradient(circle at 88% 160%, rgba(15, 112, 215, 0.32), transparent 48%),
        linear-gradient(112deg, #061727 0%, #0a2945 48%, #081b2c 100%);
      border-bottom: 1px solid rgba(121, 199, 255, 0.26);
      box-shadow:
        inset 0 -1px 0 rgba(255, 255, 255, 0.035),
        0 9px 24px rgba(2, 13, 24, 0.22);
      isolation: isolate;
    }

    .labor-day-announcement::before {
      position: absolute;
      z-index: -1;
      top: -90%;
      left: -28%;
      width: 34%;
      height: 280%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.11),
        transparent
      );
      content: "";
      transform: rotate(18deg);
      animation: labor-day-sheen 7s ease-in-out infinite;
      pointer-events: none;
    }

    .labor-day-announcement__link {
      display: grid;
      width: min(100% - 20px, 620px);
      min-height: 66px;
      align-content: center;
      gap: 5px;
      margin-inline: auto;
      padding: 9px 0 8px;
      color: inherit;
      text-decoration: none;
      -webkit-tap-highlight-color: transparent;
    }

    .labor-day-announcement__topline,
    .labor-day-announcement__bottomline {
      display: flex;
      min-width: 0;
      align-items: center;
    }

    .labor-day-announcement__topline {
      gap: 8px;
    }

    .labor-day-announcement__event {
      overflow: hidden;
      color: rgba(255, 255, 255, 0.72);
      font-family: var(--display);
      font-size: 0.59rem;
      font-weight: 800;
      letter-spacing: 0.11em;
      text-overflow: ellipsis;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .labor-day-announcement__offer {
      flex: 0 0 auto;
      padding: 3px 8px 4px;
      border: 1px solid rgba(121, 199, 255, 0.38);
      border-radius: 999px;
      color: #d9f3ff;
      background: rgba(15, 112, 215, 0.2);
      box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.12),
        0 0 18px rgba(22, 164, 216, 0.12);
      font-family: var(--display);
      font-size: 0.67rem;
      font-weight: 900;
      letter-spacing: 0.055em;
      line-height: 1;
      white-space: nowrap;
    }

    .labor-day-announcement__cta {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: center;
      gap: 5px;
      margin-left: auto;
      color: #fff;
      font-family: var(--display);
      font-size: 0.67rem;
      font-weight: 850;
      letter-spacing: -0.01em;
      white-space: nowrap;
    }

    .labor-day-announcement__cta i {
      color: #79c7ff;
      font-style: normal;
      transition: transform 0.2s ease;
    }

    .labor-day-announcement__link:active .labor-day-announcement__cta i {
      transform: translateX(3px);
    }

    .labor-day-announcement__bottomline {
      justify-content: space-between;
      gap: 10px;
    }

    .labor-day-announcement__deadline {
      overflow: hidden;
      color: rgba(255, 255, 255, 0.78);
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: -0.01em;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .labor-day-announcement__countdown {
      display: inline-flex;
      flex: 0 0 auto;
      align-items: baseline;
      gap: 2px;
      padding: 3px 7px 4px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 7px;
      background: rgba(1, 12, 22, 0.27);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
      font-family: var(--display);
      line-height: 1;
      font-variant-numeric: tabular-nums;
    }

    .labor-day-announcement__countdown b {
      min-width: 1.25em;
      color: #fff;
      font-size: 0.7rem;
      font-weight: 900;
      text-align: center;
    }

    .labor-day-announcement__countdown small {
      color: #79c7ff;
      font-size: 0.48rem;
      font-weight: 800;
    }

    .labor-day-announcement__countdown i {
      margin-inline: 1px;
      color: rgba(121, 199, 255, 0.42);
      font-size: 0.58rem;
      font-style: normal;
    }

    :global(.site-header.is-scrolled) .labor-day-announcement__link {
      min-height: 46px;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 8px;
      padding-block: 5px;
    }

    :global(.site-header.is-scrolled) .labor-day-announcement__topline {
      min-width: 0;
    }

    :global(.site-header.is-scrolled) .labor-day-announcement__event {
      display: none;
    }

    :global(.site-header.is-scrolled) .labor-day-announcement__offer {
      padding: 4px 8px;
    }

    :global(.site-header.is-scrolled) .labor-day-announcement__bottomline {
      justify-content: flex-end;
    }

    :global(.site-header.is-scrolled) .labor-day-announcement__deadline {
      display: none;
    }

    :global(.site-header.is-scrolled) .labor-day-announcement__cta {
      margin-left: 0;
    }

    @media (max-width: 355px) {
      .labor-day-announcement__link {
        width: calc(100% - 16px);
      }

      .labor-day-announcement__event {
        font-size: 0.54rem;
      }

      .labor-day-announcement__offer,
      .labor-day-announcement__cta {
        font-size: 0.62rem;
      }

      .labor-day-announcement__deadline {
        font-size: 0.62rem;
      }

      .labor-day-announcement__countdown {
        padding-inline: 5px;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .labor-day-announcement::before {
      animation: none;
    }
  }

  @keyframes labor-day-sheen {
    0%, 72%, 100% {
      transform: translateX(0) rotate(18deg);
      opacity: 0;
    }
    78% {
      opacity: 1;
    }
    92% {
      transform: translateX(430%) rotate(18deg);
      opacity: 0;
    }
  }
</style>
