---
type OrbFieldVariant = "hero" | "section" | "soft";

type OrbFieldProps = {
  variant?: OrbFieldVariant;
  class?: string;
};

const {
  variant = "section",
  class: className = ""
} = Astro.props as OrbFieldProps;

const classes = ["ir-orb-field", `ir-orb-field-${variant}`, className]
    .filter(Boolean)
    .join(" ");
---

<div class={classes} aria-hidden="true" />

<style>
  .ir-orb-field {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background:
      radial-gradient(ellipse 46% 36% at 12% 4%, rgba(10, 141, 255, 0.16), transparent 72%),
      radial-gradient(ellipse 42% 34% at 88% 8%, rgba(123, 92, 255, 0.14), transparent 72%),
      radial-gradient(ellipse 42% 34% at 76% 92%, rgba(255, 79, 163, 0.1), transparent 74%);
    opacity: 0.92;
  }

  .ir-orb-field-hero {
    background:
      radial-gradient(ellipse 52% 42% at 13% 2%, rgba(10, 141, 255, 0.2), transparent 70%),
      radial-gradient(ellipse 45% 40% at 88% 8%, rgba(255, 79, 163, 0.12), transparent 72%),
      radial-gradient(ellipse 58% 42% at 50% 105%, rgba(123, 92, 255, 0.12), transparent 74%);
  }
</style>
