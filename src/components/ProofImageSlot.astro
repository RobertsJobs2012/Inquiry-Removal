---
type ProofImageSlotProps = {
  badge: string;
  score: string;
  label: string;
  detail: string;
  imageSrc?: string;
  imageAlt?: string;
};

const {
  badge,
  score,
  label,
  detail,
  imageSrc,
  imageAlt
} = Astro.props as ProofImageSlotProps;
---

<figure class="ir-proof-image-slot">
      <div class="ir-proof-image-frame">
        {imageSrc ? (
          <img
            src={imageSrc}
            alt={imageAlt ?? label}
            sizes="(min-width: 1024px) 360px, 92vw"
            loading="lazy"
            decoding="async"
            class="ir-proof-real-image"
          />
        ) : (
          <div class="ir-proof-placeholder" aria-hidden="true">
            <span class="ir-proof-placeholder-top" />
            <span class="ir-proof-placeholder-score">{score}</span>
            <span class="ir-proof-placeholder-meter" />
            <span class="ir-proof-placeholder-grid">
              <i />
              <i />
              <i />
            </span>
          </div>
        )}
      </div>
      <figcaption>
        <span class="ir-proof-badge">{badge}</span>
        <strong>{score}</strong>
        <span>{label}</span>
        <p>{detail}</p>
      </figcaption>
    </figure>

<style>
  .ir-proof-image-slot {
    margin: 0;
    padding: 12px;
    border: 1px solid var(--border-medium);
    border-radius: 28px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0.025)),
      rgba(17, 17, 24, 0.88);
    box-shadow: var(--shadow-card-strong);
  }

  .ir-proof-image-frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    background: #f8fafc;
  }

  .ir-proof-real-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ir-proof-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: 22px;
    padding: 28px;
    background:
      radial-gradient(circle at 78% 16%, rgba(10, 141, 255, 0.22), transparent 38%),
      radial-gradient(circle at 18% 78%, rgba(255, 79, 163, 0.16), transparent 42%),
      linear-gradient(180deg, #f8fafc 0%, #e8eefc 100%);
    color: #0f172a;
  }

  .ir-proof-placeholder-top,
  .ir-proof-placeholder-meter,
  .ir-proof-placeholder-grid i {
    display: block;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.12);
  }

  .ir-proof-placeholder-top {
    width: 62%;
    height: 18px;
  }

  .ir-proof-placeholder-score {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(4.25rem, 14vw, 6.5rem);
    font-weight: 900;
    line-height: 0.82;
    letter-spacing: -0.08em;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .ir-proof-placeholder-meter {
    width: 100%;
    height: 12px;
    background: var(--brand-gradient);
    box-shadow: 0 0 24px rgba(123, 92, 255, 0.26);
  }

  .ir-proof-placeholder-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .ir-proof-placeholder-grid i {
    height: 76px;
    border-radius: 18px;
    background: rgba(15, 23, 42, 0.08);
  }

  .ir-proof-image-slot figcaption {
    display: grid;
    gap: 8px;
    padding: 18px 4px 4px;
  }

  .ir-proof-badge {
    width: fit-content;
    display: inline-flex;
    padding: 6px 10px;
    border: 1px solid rgba(34, 197, 94, 0.28);
    border-radius: var(--radius-pill);
    color: #dfffee;
    background: rgba(34, 197, 94, 0.12);
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ir-proof-image-slot figcaption strong {
    color: var(--text-heading);
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(2.6rem, 7vw, 4rem);
    line-height: 0.9;
  }

  .ir-proof-image-slot figcaption span:not(.ir-proof-badge),
  .ir-proof-image-slot figcaption p {
    color: var(--text-body);
    line-height: 1.55;
  }
</style>
