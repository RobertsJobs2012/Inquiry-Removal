---
import PremiumIcon from "./PremiumIcon.astro";
---

<section class="guarantee" aria-labelledby="guarantee-heading">
      <div class="container">
        <div class="guarantee-card">
          <div class="guarantee-bg" aria-hidden="true" />
          <div class="guarantee-inner">
            <div class="guarantee-kicker">
              <div class="guarantee-badge" aria-hidden="true">
                <PremiumIcon name="guaranteeSeal" size={54} strokeWidth={1.5} />
              </div>
            </div>

            <h2 id="guarantee-heading" class="guarantee-headline">
              What Happens If We Don&apos;t Remove Any Inquiries? You Get Every Dollar Back.
            </h2>

            <div class="guarantee-prose">
              <p>
                If we do not remove any hard inquiries from your credit report
                within <strong>90 days</strong> of beginning service, you
                receive a full refund — no runaround, no finger-pointing, no
                fine print designed to keep your money.
              </p>
              <p>
                We verify results before processing any refund, because that is
                the honest way to handle it. In nearly 11 years and over{" "}
                <strong>1,123 clients</strong>, we have maintained a near-100%
                success rate. We tell you about the guarantee not because we
                expect to use it — but because you deserve to know it exists
                before you trust us with anything.
              </p>
            </div>

            <p class="guarantee-disclaimer">
              Individual results vary based on each client's specific credit
              report, inquiry type, and bureau response. Most clients see
              removals within 30 to 90 days.
            </p>
          </div>
        </div>
      </div>
</section>
