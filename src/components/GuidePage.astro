---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import PracticalContent from "./PracticalContent.astro";
import ContextualText from "./ContextualText.astro";
import { createContextualLinker } from "../data/contextualLinks";
import type { GuidePage } from "../data/guides";
import { SITE_ORIGIN } from "../data/discovery.mjs";
import { guideReviewDate } from "../data/contentDates";
import { guideToolMode } from "../data/guideTools";
import { practicalGuides } from "../data/practicalGuides";
import GuideProof from "./GuideProof.astro";

interface Props {
  page: GuidePage;
}

const { page } = Astro.props;
const reviewed = guideReviewDate(page.slug);
const linkText = createContextualLinker(page.slug);
const canonical = `${SITE_ORIGIN}/${page.slug}/`;
const isResource = page.category === "resources";
const isArticle = page.kind === "article";
const tool = guideToolMode(page.slug);
const hasPractical = Boolean(tool || practicalGuides[page.slug]?.length);
const breadcrumbName = isResource ? "Resources" : "Situations We Handle";
const breadcrumbLabel = isResource ? "Resources" : "Situations";
const breadcrumbHref = isResource ? "/resources/" : "/situations-we-handle/";
const bureauBySlug: Record<string, string> = {
  "experian-hard-inquiry-removal": "experian",
  "equifax-hard-inquiry-removal": "equifax",
  "transunion-hard-inquiry-removal": "transunion",
};
const situationBySlug: Record<string, string> = {
  "unauthorized-inquiries": "unauthorized",
  "identity-theft-inquiries": "identity-theft",
  "soft-pull-became-hard-inquiry": "soft-pull",
  "unrecognized-inquiries": "unrecognized",
  "duplicate-inquiries": "duplicate",
  "incorrect-person-inquiries": "incorrect-person",
  "authorized-inquiry-removal": "authorized",
};
const reviewParams = new URLSearchParams({
  source: `/${page.slug}/`,
  context: page.slug,
});
if (bureauBySlug[page.slug])
  reviewParams.set("bureau", bureauBySlug[page.slug]);
if (situationBySlug[page.slug])
  reviewParams.set("situation", situationBySlug[page.slug]);
const reviewHref = `/free-inquiry-review/?${reviewParams.toString()}#online-review`;
const overviewItems = page.sections.find((section) => section.visual)?.visual
  ?.items ?? ["Inquiry", "Creditor", "Evidence", "Next step"];
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${SITE_ORIGIN}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: breadcrumbName,
        item: `${SITE_ORIGIN}${breadcrumbHref}`,
      },
      { "@type": "ListItem", position: 3, name: page.title, item: canonical },
    ],
  },
  page.kind === "article"
    ? {
        "@context": "https://schema.org",
        "@type": "Article",
        headline: page.title,
        description: page.description,
        author: {
          "@type": "Person",
          "@id": `${SITE_ORIGIN}/about/#robert-garcia`,
          name: "Robert Garcia",
          url: `${SITE_ORIGIN}/about/`,
        },
        publisher: { "@id": `${SITE_ORIGIN}/#organization` },
        mainEntityOfPage: canonical,
        dateModified: reviewed.iso,
      }
    : {
        "@context": "https://schema.org",
        "@type": "Service",
        name: page.title,
        description: page.description,
        serviceType: "Hard inquiry review and removal",
        provider: { "@id": `${SITE_ORIGIN}/#organization` },
        areaServed: { "@type": "Country", name: "United States" },
        url: canonical,
      },
];
---

<BaseLayout
  title={page.seoTitle}
  description={page.description}
  robots="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  {schema}
  theme="dark"
>
  <Header dark />
  <main
    id="main-content"
    tabindex="-1"
    class:list={["guide-page", isArticle && "guide-page--article"]}
  >
    <section class="guide-hero dark-section">
      <div class="container guide-hero__grid">
        <div class="guide-hero__copy" data-reveal>
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href={breadcrumbHref}>{breadcrumbLabel}</a>
            <span class="breadcrumb-current-separator">/</span>
            <span class="breadcrumb-current">{page.title}</span>
          </nav>
          <p class="eyebrow eyebrow--light">
            <span></span>
            {page.eyebrow}
          </p>
          <h1>{page.title}</h1>
          {isArticle && (
            <section
              class="article-answer"
              id="quick-answer"
              aria-labelledby="quick-answer-heading"
            >
              <h2 id="quick-answer-heading">{page.quickTitle}</h2>
              <p>{page.quickAnswer}</p>
            </section>
          )}
          <p class="guide-hero__support">{page.supporting}</p>
          {page.slug === "identity-theft-inquiries" && (
            <p class="guide-safety-first">
              Protect yourself first:{" "}
              <a href="https://www.identitytheft.gov/">
                free FTC recovery steps
              </a>{" "}
              and{" "}
              <a href="#practical-next-steps">bureau protection resources</a>.
              No paid service is needed to use these resources.
            </p>
          )}
          <div class="button-row guide-hero__actions">
            <a
              class="button button--large"
              href={reviewHref}
              data-track="guide-hero"
              data-context={page.slug}
            >
              {page.primaryCta} <span>→</span>
            </a>
            <a
              class="text-link text-link--light"
              href={page.secondaryTarget}
              data-event={
                page.secondaryTarget.includes("results")
                  ? "Results Open"
                  : "Guide Section Open"
              }
              data-track="guide-secondary"
              data-context={page.slug}
            >
              {page.secondaryCta} <span>↘</span>
            </a>
          </div>
          <p class="cta-microcopy">
            {page.kind === "article"
              ? "Free guide and tools. Optional specialist help. No guaranteed outcome."
              : "Free review, not an eligibility verdict. Accurate legitimate inquiries usually need to age off."}
          </p>
        </div>

        <aside
          class="guide-hero__visual"
          aria-label={
            isArticle ? "Guide shortcuts" : `${page.title} review overview`
          }
          data-reveal
        >
          <div class="guide-visual__topline">
            <span>
              {page.kind === "article"
                ? "Practical guide"
                : "Specialist review"}
            </span>
            <i></i>
          </div>
          {isArticle ? (
            <nav class="article-path" aria-label="Guide reading path">
              <span>Find what you need</span>
              {page.sections.slice(0, 3).map((section, index) => (
                <a href={`#section-${index + 1}`}>
                  <b aria-hidden="true">0{index + 1}</b>
                  {section.heading}
                  <span aria-hidden="true">↗</span>
                </a>
              ))}
              <a href="#guide-sources">
                <b aria-hidden="true">↗</b>Official sources
                <span aria-hidden="true">↗</span>
              </a>
            </nav>
          ) : (
            <>
              <strong>{page.eyebrow}</strong>
              <div class="guide-visual__signal" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
              </div>
              <p>{overviewItems.join("  ·  ")}</p>
            </>
          )}
        </aside>
      </div>
    </section>

    {!isArticle && <GuideProof />}

    <nav class="guide-jump" aria-label="On this page">
      <div class="container">
        <span>On this page</span>
        <a href="#quick-answer">Quick answer</a>
        {hasPractical && <a href="#practical-next-steps">Practical steps</a>}
        {tool && (
          <a href="#practical-tools">
            Free{" "}
            {tool === "age"
              ? "estimator"
              : tool === "letter"
                ? "letter sample"
                : "worksheet"}
          </a>
        )}
        {page.sections.map((section, index) => (
          <a href={`#section-${index + 1}`}>{section.heading}</a>
        ))}
        <a href="#questions">Questions</a>
        <a href="#guide-sources">Sources</a>
      </div>
    </nav>

    <section class="section guide-opening">
      <div class="container guide-opening__grid">
        {!isArticle && (
          <div class="guide-answer" id="quick-answer" data-reveal>
            <p class="eyebrow">
              <span></span>
              {page.quickTitle}
            </p>
            <p>{page.quickAnswer}</p>
          </div>
        )}
        <div class="guide-takeaways" data-reveal>
          <span>What to know before you start</span>
          <ul>
            {page.takeaways.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
      {page.kind === "article" && (
        <div class="container guide-author" data-reveal>
          <div>
            <>
              <span>Written by</span>
              <strong>Robert Garcia</strong>
            </>
          </div>
          <div>
            <>
              <span>Role</span>
              <strong>Founder &amp; Senior Credit Analyst</strong>
            </>
          </div>
          <div>
            <>
              <span>Page updated</span>
              <strong>
                <time datetime={reviewed.iso}>{reviewed.label}</time>
              </strong>
            </>
          </div>
        </div>
      )}
    </section>

    {isArticle && <GuideProof />}

    <PracticalContent slug={page.slug} />

    <div class="guide-sections">
      {page.sections.map((section, index) => (
        <section
          class:list={[
            "section",
            "guide-section",
            index % 2 === 1 && "guide-section--tint",
          ]}
          id={`section-${index + 1}`}
        >
          <div class="container guide-section__grid">
            <div class="guide-section__number" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </div>
            <div class="guide-section__content" data-reveal>
              <h2>{section.heading}</h2>
              {section.body.map((paragraph) => (
                <p>
                  <ContextualText segments={linkText(paragraph)} />
                </p>
              ))}
              {section.bullets && (
                <ul class="guide-checklist">
                  {section.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
              {section.cards && (
                <div class="guide-card-grid">
                  {section.cards.map((card) => (
                    <article>
                      <h3>{card.title}</h3>
                      <p>{card.body}</p>
                    </article>
                  ))}
                </div>
              )}
              {section.visual && (
                <div
                  class="guide-media-panel"
                  role="group"
                  aria-label={section.visual.title}
                >
                  <div>
                    <span>Review pathway</span>
                    <strong>{section.visual.title}</strong>
                  </div>
                  <div class="guide-media-panel__items">
                    {section.visual.items.map((item) => (
                      <span>{item}</span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>

    <section class="section guide-choice dark-section">
      <div class="container guide-choice__grid">
        <div data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span>Your choice
          </p>
          <h2>
            {page.kind === "service"
              ? "Want Us to Handle the Inquiry Removal Process for You?"
              : "Handle It Yourself or Have a Specialist Help"}
          </h2>
          <p>
            {page.kind === "service"
              ? "You can dispute inaccurate credit-report information yourself for free. Our paid service is for people who want help organizing the inquiries, preparing appropriate communications, reviewing responses and managing follow-up under the service agreement. Scope and price are confirmed before you decide."
              : "Consumers can dispute inaccurate credit-report information directly and for free. Inquiry Removal is for people who want a specialist to organize the inquiries, prepare the appropriate communications, and review what happens next."}
          </p>
        </div>
        <div class="guide-choice__actions" data-reveal>
          <a
            class="button button--large"
            href={reviewHref}
            data-track="guide-mid"
            data-context={page.slug}
          >
            {page.primaryCta} <span>→</span>
          </a>
          <a
            class="text-link text-link--light"
            href="/pricing/"
            data-event="Pricing Open"
            data-track="guide-pricing"
            data-context={page.slug}
          >
            See one-time pricing <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section guide-faq" id="questions">
      <div class="container guide-faq__grid">
        <div data-reveal>
          <p class="eyebrow">
            <span></span>Questions answered
          </p>
          <h2>
            {page.kind === "service"
              ? "Questions Before You Start"
              : "Common questions about this guide"}
          </h2>
          <p>
            {page.kind === "service"
              ? "Straight answers about the service, packages, timing, bureaus, and what happens next."
              : "Clear answers about the topic and your available next steps."}
          </p>
        </div>
        <div class="guide-faq__list" data-reveal>
          {page.faqs.map((faq, index) => (
            <details open={index === 0}>
              <summary>
                {faq.question}
                <span aria-hidden="true">+</span>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="section guide-related">
      <div class="container guide-related__grid">
        <div>
          <p class="eyebrow">
            <span></span>Keep learning
          </p>
          <h2>Related hard inquiry guides.</h2>
          <div class="guide-related__links">
            {page.related.map((link) => (
              <a
                href={link.href}
                data-event="Guide Link Open"
                data-track="guide-related"
                data-context={page.slug}
              >
                {link.label}
                <span>→</span>
              </a>
            ))}
          </div>
        </div>
        <aside id="guide-sources">
          <span>Official consumer resources</span>
          {page.sources.map((source) => (
            <a href={source.href} rel="external noopener">
              {source.label}
              <span>↗</span>
            </a>
          ))}
          <a href="/editorial-policy/">
            Sources, standards and corrections <span>→</span>
          </a>
        </aside>
      </div>
    </section>

    <section class="guide-final dark-section">
      <div class="container" data-reveal>
        <p class="eyebrow eyebrow--light">
          <span></span>Free personal review
        </p>
        <h2>
          {page.kind === "service"
            ? "Ready to Review the Facts Behind Your Inquiries?"
            : "Ready to Review the Inquiries on Your Report?"}
        </h2>
        <p>
          {page.kind === "service"
            ? "Start with a free review. We identify the entries, investigate the circumstances, and explain whether supported disputes or normal aging are the relevant next step. A review does not guarantee removal."
            : "Start with the exact companies, dates, bureaus, and circumstances, then choose the next step that fits your situation."}
        </p>
        <a
          class="button button--large"
          href={reviewHref}
          data-track="guide-final"
          data-context={page.slug}
        >
          {page.primaryCta} <span>→</span>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .guide-page
    :global(
      :is(
        #quick-answer,
        #practical-next-steps,
        #practical-tools,
        #guide-sources,
        [id^="section-"],
        #questions
      )
    ) {
    scroll-margin-top: 64px;
  }
  .article-answer {
    margin-block: 1.5rem;
    padding: 1.2rem 1.4rem;
    border: 1px solid #5baacc50;
    border-left: 3px solid #37c8de;
    border-radius: 0 1rem 1rem 0;
    background: linear-gradient(110deg, #1a658532, #12577712);
    box-shadow: inset 0 1px #ffffff0a;
  }
  .article-answer h2 {
    color: #8fdef0;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    line-height: 1.5;
    margin: 0 0 0.65rem;
  }
  .article-answer p {
    color: #eff8ff;
    font-size: 1.08rem;
    line-height: 1.65;
    margin: 0;
    max-width: 70ch;
  }
  .guide-page--article .guide-hero__visual {
    min-height: 0;
    align-self: start;
  }
  .article-path {
    display: grid;
    margin-top: 2rem;
  }
  .article-path > span {
    color: #b9d5e5;
    font-size: 0.9rem;
    margin-bottom: 1rem;
  }
  .article-path a {
    display: grid;
    grid-template-columns: 1.6rem 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1.2rem;
    border-top: 1px solid #8bcbeb30;
    color: #f1f9ff;
    line-height: 1.5;
    font-size: 0.94rem;
  }
  .article-path b,
  .article-path a > span {
    color: #70d7e7;
    font-size: 0.76rem;
  }
  .article-path a:hover {
    color: #93e6f4;
  }
  .article-path a:focus-visible {
    outline: 2px solid #70d7e7;
    outline-offset: 4px;
  }
  .guide-page--article .guide-opening__grid {
    grid-template-columns: 1fr;
  }
  .guide-page--article .guide-opening {
    padding-block: 48px;
  }
  .guide-page--article .guide-takeaways ul {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .guide-page--article .guide-takeaways {
    padding: 1.7rem;
  }
  .guide-page--article .guide-hero__grid {
    align-items: start;
  }
  @media (max-width: 1100px) {
    .guide-page--article .guide-hero__visual {
      display: none;
    }
  }
  @media (max-width: 767px) {
    .guide-page--article .guide-hero__copy {
      display: block;
    }
    .guide-page--article .guide-hero {
      padding-bottom: 32px;
    }
    .guide-page--article .guide-hero h1 {
      margin-block: 1rem;
    }
    .guide-page--article .guide-hero__support {
      margin-top: 1.2rem;
    }
    .article-answer {
      padding: 1rem;
      margin-block: 1.25rem;
    }
    .article-answer p {
      font-size: 1rem;
    }
    .guide-page--article .guide-takeaways ul {
      grid-template-columns: 1fr;
    }
  }
</style>
