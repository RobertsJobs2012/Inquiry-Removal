---
import PremiumIcon from "./PremiumIcon.astro";

interface TrustStat {
  value: string;
  suffix: string;
  iconSuffix?: "star";
  label: string;
  sub: string;
}

const STATS: TrustStat[] = [
  {
    value: "11",
    suffix: "Years",
    label: "Specialized Experience",
    sub: "(Since 2015)",
  },
  {
    value: "1,123",
    suffix: "",
    label: "Clients Helped Nationwide",
    sub: "",
  },
  {
    value: "100,437",
    suffix: "",
    label: "Hard Inquiries Permanently Deleted",
    sub: "",
  },
  {
    value: "4.9",
    suffix: "",
    iconSuffix: "star",
    label: "Average Rating — 312 Google Reviews",
    sub: "",
  },
];

const PRESS_LOGOS = ["Forbes", "Bloomberg", "CNBC", "Business Insider", "MarketWatch"];
---

<section class="trust" aria-labelledby="trust-heading">
      <div class="container">
        <h2 id="trust-heading" class="sr-only">
          Trusted nationwide
        </h2>

        <div class="trust-stats">
          {STATS.map((stat) => (
            <div class="trust-stat">
              <div class="trust-stat-value">
                <span class="trust-stat-num">{stat.value}</span>
                {stat.suffix && (
                  <span class="trust-stat-suffix">{stat.suffix}</span>
                )}
                {stat.iconSuffix === "star" && (
                  <span class="trust-stat-suffix trust-stat-icon-suffix" aria-hidden="true">
                    <PremiumIcon name="star" size={18} />
                  </span>
                )}
              </div>
              <div class="trust-stat-label">{stat.label}</div>
              {stat.sub ? <div class="trust-stat-sub">{stat.sub}</div> : null}
            </div>
          ))}
        </div>

        <p class="trust-supporting">
          We are <strong>not</strong> a generalist credit repair company. We do
          one thing — remove hard inquiries from your Experian, Equifax, and
          TransUnion credit reports — and we have spent over a decade becoming
          the best in the country at it.
        </p>

        <div class="trust-press">
          <div class="trust-press-logos" aria-label="Press mentions">
            {PRESS_LOGOS.map((logo) => (
              <span>{logo}</span>
            ))}
          </div>
          <div class="trust-award">
            <span class="trust-award-icon" aria-hidden="true">
              <PremiumIcon name="trophy" size={20} />
            </span>
            <div>
              <div class="trust-award-title">Best of 2025</div>
            </div>
          </div>
        </div>
      </div>
</section>
