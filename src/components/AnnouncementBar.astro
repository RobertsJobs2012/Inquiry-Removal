---
import PremiumIcon from "./PremiumIcon.astro";
---

<input
        type="checkbox"
        id="dismiss-announcement"
        class="dismiss-checkbox"
        aria-hidden="true"
        tabindex={-1}
      />
      <aside
        aria-label="Site announcement"
        class="announcement-bar"
      >
        <div class="announcement-inner">
          <span class="announcement-pill">
            <PremiumIcon name="star" size={12} />
            Rated 4.9 Stars
          </span>
          <span class="announcement-text">
            <span class="announcement-count-full">100,437 Hard Inquiries Removed Nationwide</span>
            <span class="announcement-count-short">100k+ Removed</span>
            <span class="announcement-divider" aria-hidden="true">|</span>
            <span class="announcement-mobile-hide">Your Free Consultation Is Waiting</span>
          </span>
          <a href="/get-started" class="announcement-cta" data-event="announcement_start_click">
            Book Free Consultation <span aria-hidden="true">→</span>
          </a>
        </div>
        <label
          for="dismiss-announcement"
          class="announcement-close"
          aria-label="Dismiss announcement"
        >
          <PremiumIcon name="close" size={14} />
        </label>
      </aside>
