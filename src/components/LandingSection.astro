---
import LandingBlock from "./LandingBlock.astro";

type LandingBlockData = {
  kind: string;
  text: string;
};

type LandingFaqData = {
  q: string;
  a: string;
};

type LandingSectionData = {
  type?: string;
  heading: string;
  blocks: LandingBlockData[];
  faqs?: LandingFaqData[];
};

type LandingPageShell = {
  key: string;
  ctaHref: string;
  downloadHref: string;
  downloadCta: string;
  hero: {
    primaryCta: string;
  };
};

const { page, section, index } = Astro.props as {
  page: LandingPageShell;
  section: LandingSectionData;
  index: number;
};
const sectionId = page.key + "-section-" + index;
const isProof = /proof|results|real results|what happens/i.test(section.heading);
const isCta = /ready to|still within reach|right to have|credit report should reflect/i.test(section.heading);
const blocks = section.blocks ?? [];
const faqs = section.faqs ?? [];
---

{section.type === "faq" ? (
  <section class="landing-section landing-faq section-divider" aria-labelledby={sectionId}>
    <div class="container landing-copy-shell">
      <div class="landing-copy-head"><h2 id={sectionId}>{section.heading}</h2></div>
      {blocks.length ? <div class="landing-copy-card">{blocks.map((block: LandingBlockData) => <LandingBlock block={block} />)}</div> : null}
      <div class="landing-faq-list">
        {faqs.map((item: LandingFaqData) => (
          <details class="landing-faq-card" name={page.key + "-faq"}>
            <summary><span>{item.q}</span><b aria-hidden="true">+</b></summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
) : (
  <section class={"landing-section " + (isProof ? "landing-proof " : "") + (isCta ? "landing-closing " : "") + "section-divider"} aria-labelledby={sectionId}>
    <div class="container landing-copy-shell">
      <div class={isCta ? "landing-copy-head landing-centered-head" : "landing-copy-head"}><h2 id={sectionId}>{section.heading}</h2></div>
      <div class={isCta ? "landing-copy-card landing-closing-card" : "landing-copy-card"}>{blocks.map((block: LandingBlockData) => <LandingBlock block={block} />)}</div>
      {isCta ? (
        <div class="landing-closing-actions">
          <a href={page.ctaHref} class="btn btn-primary btn-large">{page.hero.primaryCta}</a>
          {page.downloadHref.startsWith("tel:") ? <a href={page.downloadHref} class="btn btn-secondary btn-large">{page.downloadCta}</a> : <a href={page.downloadHref} download class="btn btn-secondary btn-large">{page.downloadCta}</a>}
        </div>
      ) : null}
    </div>
  </section>
)}
