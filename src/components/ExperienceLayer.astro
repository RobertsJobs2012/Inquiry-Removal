<div class="site-scroll-progress" aria-hidden="true"><i data-site-progress></i></div>

<script>
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)").matches;

  const progressBar = document.querySelector<HTMLElement>("[data-site-progress]");
  let progressFrame = 0;

  const updateProgress = () => {
    progressFrame = 0;
    if (!progressBar) return;
    const max = Math.max(
      1,
      document.documentElement.scrollHeight - window.innerHeight,
    );
    const ratio = Math.min(1, Math.max(0, window.scrollY / max));
    progressBar.style.setProperty("--scroll-progress", String(ratio));
  };

  const requestProgress = () => {
    if (progressFrame) return;
    progressFrame = window.requestAnimationFrame(updateProgress);
  };

  updateProgress();
  window.addEventListener("scroll", requestProgress, { passive: true });
  window.addEventListener("resize", requestProgress, { passive: true });

  // Give grouped reveals a small, consistent cadence instead of one repeated fade.
  document
    .querySelectorAll<HTMLElement>(
      ".situation-grid, .pricing-plan-grid, .included-grid, .bureau-grid, .review-prep-grid, .about-method-grid, .case-grid",
    )
    .forEach((group) => {
      Array.from(group.children).forEach((child, index) => {
        if (child instanceof HTMLElement && child.hasAttribute("data-reveal")) {
          child.style.setProperty("--reveal-delay", `${Math.min(index, 5) * 55}ms`);
        }
      });
    });

  // Optical light follows the pointer only on devices that actually have hover.
  if (finePointer && !prefersReducedMotion) {
    const premiumSurfaces = document.querySelectorAll<HTMLElement>(
      ".report-panel, .evidence-console, .native-review-form, .about-identity, .dealer-inquiry-visual, .situation-card, .pricing-plan-card, .case-card, .resource-card, .included-grid article, .bureau-grid a, .about-method-grid article, .review-prep-grid article",
    );

    premiumSurfaces.forEach((surface) => {
      surface.addEventListener("pointermove", (event) => {
        const rect = surface.getBoundingClientRect();
        const x = ((event.clientX - rect.left) / Math.max(1, rect.width)) * 100;
        const y = ((event.clientY - rect.top) / Math.max(1, rect.height)) * 100;
        surface.style.setProperty("--pointer-x", `${x}%`);
        surface.style.setProperty("--pointer-y", `${y}%`);
      });
      surface.addEventListener("pointerleave", () => {
        surface.style.setProperty("--pointer-x", "50%");
        surface.style.setProperty("--pointer-y", "50%");
      });
    });
  }

  // Keep sticky section navigation aware of where the reader actually is.
  const jumpLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>('.page-jump a[href^="#"]'),
  );
  const jumpTargets = jumpLinks
    .map((link) => {
      const id = link.getAttribute("href");
      const target = id ? document.querySelector<HTMLElement>(id) : null;
      return target ? { link, target } : null;
    })
    .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => Boolean(item));

  if (jumpTargets.length && "IntersectionObserver" in window) {
    const visible = new Map<Element, number>();
    const syncJump = () => {
      const ranked = jumpTargets
        .filter(({ target }) => visible.has(target))
        .sort((a, b) => (visible.get(b.target) ?? 0) - (visible.get(a.target) ?? 0));
      const current = ranked[0]?.link;
      jumpLinks.forEach((link) => link.classList.toggle("is-active", link === current));
    };

    const jumpObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) visible.set(entry.target, entry.intersectionRatio);
          else visible.delete(entry.target);
        });
        syncJump();
      },
      { rootMargin: "-22% 0px -58% 0px", threshold: [0, 0.15, 0.35, 0.6] },
    );
    jumpTargets.forEach(({ target }) => jumpObserver.observe(target));
  }

  // Pricing choices focus the corresponding product card without changing existing logic.
  const planCards = Array.from(
    document.querySelectorAll<HTMLElement>(".pricing-plan-card[id^='plan-']"),
  );
  document.querySelectorAll<HTMLButtonElement>("[data-plan-choice]").forEach((choice) => {
    choice.addEventListener("click", () => {
      const key = choice.dataset.planChoice;
      planCards.forEach((card) => {
        card.classList.toggle("is-focus-plan", Boolean(key && card.id === `plan-${key}`));
      });
    });
  });

  // Turn the long How It Works timeline into a product-style scrollytelling stage on desktop.
  const processTimeline = document.querySelector<HTMLElement>(
    ".full-process-section .process-timeline",
  );

  if (processTimeline) {
    const articles = Array.from(processTimeline.querySelectorAll<HTMLElement>(":scope > article"));
    if (articles.length) {
      processTimeline.dataset.resolutionEnhanced = "true";
      const stage = document.createElement("aside");
      stage.className = "resolution-stage";
      stage.setAttribute("aria-hidden", "true");
      stage.dataset.step = "1";
      stage.innerHTML = `
        <div class="resolution-stage__top">
          <span>Resolution Interface</span>
          <b data-resolution-number>01</b>
        </div>
        <div class="resolution-stage__screen">
          <div class="resolution-stage__bureaus">
            <span>EXPERIAN</span><span>EQUIFAX</span><span>TRANSUNION</span>
          </div>
          <div class="resolution-stage__rows"><i></i><i></i><i></i></div>
          <div class="resolution-stage__trace"><i></i></div>
        </div>
        <strong class="resolution-stage__title" data-resolution-title></strong>
        <p class="resolution-stage__caption">Follow one inquiry record from report review through response and resolution.</p>
      `;
      processTimeline.prepend(stage);

      const stageNumber = stage.querySelector<HTMLElement>("[data-resolution-number]");
      const stageTitle = stage.querySelector<HTMLElement>("[data-resolution-title]");
      const stageTrace = stage.querySelector<HTMLElement>(".resolution-stage__trace i");

      const setCurrentStep = (index: number) => {
        const bounded = Math.max(0, Math.min(articles.length - 1, index));
        articles.forEach((article, articleIndex) =>
          article.classList.toggle("is-current", articleIndex === bounded),
        );
        const active = articles[bounded];
        const title = active?.querySelector("h3")?.textContent?.trim() ?? "Inquiry review";
        stage.dataset.step = String(bounded + 1);
        if (stageNumber) stageNumber.textContent = String(bounded + 1).padStart(2, "0");
        if (stageTitle) stageTitle.textContent = title;
        if (stageTrace) {
          stageTrace.style.setProperty(
            "--stage-progress",
            `${((bounded + 1) / articles.length) * 100}%`,
          );
          stageTrace.parentElement?.style.setProperty(
            "--stage-progress",
            `${((bounded + 1) / articles.length) * 100}%`,
          );
        }
      };

      setCurrentStep(0);

      if ("IntersectionObserver" in window) {
        const stepObserver = new IntersectionObserver(
          (entries) => {
            const candidates = entries
              .filter((entry) => entry.isIntersecting)
              .sort((a, b) => b.intersectionRatio - a.intersectionRatio);
            const top = candidates[0];
            if (!top) return;
            const index = articles.indexOf(top.target as HTMLElement);
            if (index >= 0) setCurrentStep(index);
          },
          { rootMargin: "-30% 0px -42% 0px", threshold: [0.15, 0.35, 0.55, 0.75] },
        );
        articles.forEach((article) => stepObserver.observe(article));
      }
    }
  }
</script>
