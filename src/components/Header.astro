---
const { dark = false, announcement = false } = Astro.props;
const nav = [
  ["How It Works", "/how-it-works/"],
  ["Situations", "/situations-we-handle/"],
  ["Pricing", "/pricing/"],
  ["FAQ", "/faq/"],
];
const secondaryNav = [
  ["Resources", "/resources/"],
  ["About", "/about/"],
  ["Areas We Serve", "/areas-we-serve/"],
  ["Contact", "/contact/"],
];
const currentPath = Astro.url.pathname;
const isIntakePage = [
  "/free-inquiry-review/",
  "/get-started/",
  "/free-inquiry-analysis/",
].includes(currentPath);
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<header
  class:list={[
    "site-header",
    { "site-header--dark": dark, "site-header--announcement": announcement },
  ]}
  data-header
>
  {
    announcement && (
      <a class="announcement-bar" href="#free-review">
        <span>100,437 Hard Inquiries Removed Since 2015</span>
        <strong>Get My Free Review →</strong>
      </a>
    )
  }
  <div class="nav-shell">
    <a class="wordmark" href="/" aria-label="Inquiry Removal home">
      <span class="brand-mark" aria-hidden="true">
        <img
          class="brand-mark__image brand-mark__image--light"
          src="/brand/logo-mark-light-128.png"
          width="128"
          height="128"
          alt=""
        />
        <img
          class="brand-mark__image brand-mark__image--dark"
          src="/brand/logo-mark-dark-128.png"
          width="128"
          height="128"
          alt=""
        />
      </span>
      <span class="wordmark-text">Inquiry <strong>Removal</strong></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        nav.map(([label, href]) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <a
        class="phone-link"
        href="tel:+16023776626"
        aria-label="Call Inquiry Removal at 602-377-6626"
        >Call Inquiry Removal</a
      >
      <a
        class="button button--small"
        href="/free-inquiry-review/"
        data-track="header-desktop"
        data-context="sitewide">Get My Free Review <span>→</span></a
      >
      <button
        class="menu-button"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-button
      >
        <span class="menu-button__label" data-menu-label>Menu</span>
        <span class="menu-button__icon" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
      </button>
    </div>
  </div>
  <nav
    class="mobile-nav"
    id="mobile-navigation"
    aria-label="Mobile navigation"
    data-mobile-nav
  >
    <p class="mobile-nav__section-label">Explore Inquiry Removal</p>
    <div class="mobile-nav__primary">
      {
        nav.map(([label, href]) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
            <span>→</span>
          </a>
        ))
      }
    </div>

    <p class="mobile-nav__section-label">More</p>
    <div class="mobile-nav__secondary">
      {
        secondaryNav.map(([label, href]) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
            <span>↗</span>
          </a>
        ))
      }
    </div>

    <div class="mobile-nav__start">
      <p class="mobile-nav__section-label">Ready to start?</p>
      <a
        class="button mobile-nav__cta"
        href="/free-inquiry-review/"
        data-track="header-mobile-menu"
        data-context="sitewide">Get My Free Inquiry Review <span>→</span></a
      >
      <a
        class="mobile-nav__phone"
        href="tel:+16023776626"
        aria-label="Call Inquiry Removal at 602-377-6626"
        >Call Inquiry Removal <span>↗</span></a
      >
    </div>
    <p class="mobile-nav__proof">
      <span>Hard inquiry specialists since 2015</span><i></i><span>Nationwide</span>
    </p>
  </nav>
</header>

{
  !isIntakePage && (
    <div class="mobile-action-dock" data-mobile-dock aria-label="Quick actions">
      <button
        type="button"
        data-dock-menu
        aria-controls="mobile-navigation"
        aria-expanded="false"
      >
        <span aria-hidden="true">••</span><span>Explore</span>
      </button>
      <a href="tel:+16023776626" aria-label="Call Inquiry Removal">
        <span aria-hidden="true">↗</span><span>Call</span>
      </a>
      <a
        class="mobile-action-dock__primary"
        href="/free-inquiry-review/"
        data-track="mobile-action-dock"
        data-context="sitewide"
      >
        <span>Free Review</span><span aria-hidden="true">→</span>
      </a>
    </div>
  )
}
<a class="back-to-top" href="#main-content" data-back-to-top
  >Top <span aria-hidden="true">↑</span></a
>

<script>
  const header = document.querySelector("[data-header]");
  const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const dockMenuButton = document.querySelector<HTMLButtonElement>("[data-dock-menu]");
  const mobileNav = document.querySelector("[data-mobile-nav]");
  const menuLabel = document.querySelector("[data-menu-label]");
  const mobileDock = document.querySelector<HTMLElement>("[data-mobile-dock]");
  const backToTop = document.querySelector("[data-back-to-top]");
  const ctaSuppressors = Array.from(
    document.querySelectorAll(
      "#free-review, .intake-section, .review-form-section, .final-cta, .site-footer",
    ),
  );
  const visibleSuppressors = new Set<Element>();
  let lastScrollY = window.scrollY;
  let menuOpen = false;
  let lastMenuTrigger: HTMLElement | null = null;

  const syncHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
    const movingDown = window.scrollY > lastScrollY + 8;
    const movingUp = window.scrollY < lastScrollY - 8;
    if (!menuOpen && window.scrollY > 180 && movingDown) {
      header?.classList.add("is-hidden");
    } else if (movingUp || window.scrollY < 180 || menuOpen) {
      header?.classList.remove("is-hidden");
    }
    const showFloatingActions =
      window.scrollY > Math.min(640, window.innerHeight * 0.72);
    mobileDock?.classList.toggle("is-scroll-ready", showFloatingActions);
    backToTop?.classList.toggle("is-visible", window.scrollY > 1400);
    lastScrollY = window.scrollY;
  };

  const syncMobileDock = () => {
    mobileDock?.classList.toggle(
      "is-suppressed",
      visibleSuppressors.size > 0 || menuOpen,
    );
  };

  const syncMenuControls = () => {
    menuButton?.setAttribute("aria-expanded", String(menuOpen));
    dockMenuButton?.setAttribute("aria-expanded", String(menuOpen));
    if (menuLabel) menuLabel.textContent = menuOpen ? "Close" : "Menu";
  };

  const closeMenu = (restoreFocus = false) => {
    const trigger = lastMenuTrigger;
    menuOpen = false;
    syncMenuControls();
    mobileNav?.classList.remove("is-open");
    document.body.classList.remove("menu-open");
    mobileDock?.removeAttribute("inert");
    header?.classList.remove("is-hidden");
    syncMobileDock();
    lastMenuTrigger = null;
    if (restoreFocus) trigger?.focus();
  };

  const openMenu = (trigger: HTMLElement | null) => {
    lastMenuTrigger = trigger;
    menuOpen = true;
    syncMenuControls();
    mobileNav?.classList.add("is-open");
    document.body.classList.add("menu-open");
    mobileDock?.setAttribute("inert", "");
    header?.classList.remove("is-hidden");
    syncMobileDock();
    const firstLink = mobileNav?.querySelector<HTMLElement>("a[href]");
    window.setTimeout(() => firstLink?.focus(), 120);
  };

  syncHeader();
  syncMenuControls();
  syncMobileDock();
  if ("IntersectionObserver" in window) {
    const suppressorObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) visibleSuppressors.add(entry.target);
        else visibleSuppressors.delete(entry.target);
      });
      syncMobileDock();
    });
    ctaSuppressors.forEach((node) => suppressorObserver.observe(node));
  }
  window.addEventListener(
    "scroll",
    () => {
      syncHeader();
    },
    { passive: true },
  );
  window.addEventListener(
    "resize",
    () => {
      if (window.innerWidth > 1100 && menuOpen) closeMenu();
      syncHeader();
      syncMobileDock();
    },
    { passive: true },
  );

  menuButton?.addEventListener("click", () => {
    if (menuOpen) closeMenu();
    else openMenu(menuButton);
  });

  dockMenuButton?.addEventListener("click", () => {
    if (menuOpen) closeMenu();
    else openMenu(dockMenuButton);
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  document.addEventListener("keydown", (event) => {
    if (!menuOpen) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeMenu(true);
      return;
    }
    if (event.key !== "Tab" || !header) return;
    const focusable = Array.from(
      header.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
    ).filter((item) => item.offsetParent !== null);
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
</script>
