---
const { dark = false, announcement = false } = Astro.props;
const nav = [
  ["How It Works", "/how-it-works/"],
  ["Situations We Handle", "/situations-we-handle/"],
  ["Pricing", "/pricing/"],
  ["FAQ", "/faq/"],
];
const currentPath = Astro.url.pathname;
const isIntakePage = [
  "/free-inquiry-review/",
  "/get-started/",
  "/free-inquiry-analysis/",
].includes(currentPath);
const isCurrent = (href: string) =>
  href === "/" ? currentPath === href : currentPath.startsWith(href);
---

<header
  class:list={[
    "site-header",
    { "site-header--dark": dark, "site-header--announcement": announcement },
  ]}
  data-header
>
  {
    announcement && (
      <a class="announcement-bar" href="#free-review">
        <span>100,437 Hard Inquiries Removed Since 2015</span>
        <strong>Get My Free Review →</strong>
      </a>
    )
  }
  <div class="nav-shell">
    <a class="wordmark" href="/" aria-label="Inquiry Removal home">
      <span class="brand-mark" aria-hidden="true">
        <img
          class="brand-mark__image brand-mark__image--light"
          src="/brand/logo-mark-light-128.png"
          width="128"
          height="128"
          alt=""
        />
        <img
          class="brand-mark__image brand-mark__image--dark"
          src="/brand/logo-mark-dark-128.png"
          width="128"
          height="128"
          alt=""
        />
      </span>
      <span class="wordmark-text">Inquiry <strong>Removal</strong></span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {
        nav.map(([label, href]) => (
          <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <a
        class="phone-link"
        href="tel:+16023776626"
        aria-label="Call Inquiry Removal at 602-377-6626"
        >Call Inquiry Removal</a
      >
      <a
        class="button button--small"
        href="/free-inquiry-review/"
        data-track="header-desktop"
        data-context="sitewide">Get My Free Review <span>→</span></a
      >
      <button
        class="menu-button"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-menu-button
      >
        <span class="menu-button__label" data-menu-label>Menu</span>
        <span class="menu-button__icon" aria-hidden="true">
          <i></i><i></i><i></i>
        </span>
      </button>
    </div>
  </div>
  <nav
    class="mobile-nav"
    id="mobile-navigation"
    aria-label="Mobile navigation"
    data-mobile-nav
  >
    {
      nav.map(([label, href]) => (
        <a href={href} aria-current={isCurrent(href) ? "page" : undefined}>
          {label}
          <span>→</span>
        </a>
      ))
    }
    <a
      class="mobile-nav__phone"
      href="tel:+16023776626"
      aria-label="Call Inquiry Removal at 602-377-6626"
      >Call Inquiry Removal <span>↗</span></a
    >
    <a
      class="button mobile-nav__cta"
      href="/free-inquiry-review/"
      data-track="header-mobile-menu"
      data-context="sitewide">Get My Free Review <span>→</span></a
    >
    <p class="mobile-nav__trust">Hard inquiry specialists since 2015.</p>
  </nav>
</header>

{
  !isIntakePage && (
    <a
      class="mobile-cta"
      href="/free-inquiry-review/"
      data-mobile-cta
      data-track="mobile-sticky"
      data-context="sitewide"
    >
      Get My Free Review <span>→</span>
    </a>
  )
}
<a class="back-to-top" href="#main-content" data-back-to-top
  >Top <span aria-hidden="true">↑</span></a
>

<script>
  const header = document.querySelector("[data-header]");
  const menuButton = document.querySelector("[data-menu-button]");
  const mobileNav = document.querySelector("[data-mobile-nav]");
  const menuLabel = document.querySelector("[data-menu-label]");
  const mobileCta = document.querySelector("[data-mobile-cta]");
  const backToTop = document.querySelector("[data-back-to-top]");
  const ctaSuppressors = Array.from(
    document.querySelectorAll(
      "#free-review, .intake-section, .final-cta, .site-footer",
    ),
  );
  const visibleSuppressors = new Set<Element>();
  let lastScrollY = window.scrollY;
  let menuOpen = false;

  const syncHeader = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
    const movingDown = window.scrollY > lastScrollY + 8;
    const movingUp = window.scrollY < lastScrollY - 8;
    if (!menuOpen && window.scrollY > 180 && movingDown) {
      header?.classList.add("is-hidden");
    } else if (movingUp || window.scrollY < 180 || menuOpen) {
      header?.classList.remove("is-hidden");
    }
    const showFloatingActions =
      window.scrollY > Math.min(720, window.innerHeight * 0.8);
    mobileCta?.classList.toggle("is-scroll-ready", showFloatingActions);
    backToTop?.classList.toggle("is-visible", window.scrollY > 1400);
    lastScrollY = window.scrollY;
  };

  const syncMobileCta = () => {
    mobileCta?.classList.toggle(
      "is-suppressed",
      visibleSuppressors.size > 0 || menuOpen,
    );
  };

  const closeMenu = (restoreFocus = false) => {
    menuOpen = false;
    menuButton?.setAttribute("aria-expanded", "false");
    menuButton?.setAttribute("aria-label", "Open navigation");
    if (menuLabel) menuLabel.textContent = "Menu";
    mobileNav?.classList.remove("is-open");
    document.body.classList.remove("menu-open");
    header?.classList.remove("is-hidden");
    syncMobileCta();
    if (restoreFocus && menuButton instanceof HTMLElement) menuButton.focus();
  };

  const openMenu = () => {
    menuOpen = true;
    menuButton?.setAttribute("aria-expanded", "true");
    menuButton?.setAttribute("aria-label", "Close navigation");
    if (menuLabel) menuLabel.textContent = "Close";
    mobileNav?.classList.add("is-open");
    document.body.classList.add("menu-open");
    header?.classList.remove("is-hidden");
    syncMobileCta();
  };

  syncHeader();
  syncMobileCta();
  if ("IntersectionObserver" in window) {
    const suppressorObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) visibleSuppressors.add(entry.target);
        else visibleSuppressors.delete(entry.target);
      });
      syncMobileCta();
    });
    ctaSuppressors.forEach((node) => suppressorObserver.observe(node));
  }
  window.addEventListener(
    "scroll",
    () => {
      syncHeader();
    },
    { passive: true },
  );
  window.addEventListener(
    "resize",
    () => {
      if (window.innerWidth > 1100 && menuOpen) closeMenu();
      syncHeader();
      syncMobileCta();
    },
    { passive: true },
  );

  menuButton?.addEventListener("click", () => {
    if (menuOpen) closeMenu();
    else openMenu();
  });

  mobileNav?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => closeMenu());
  });

  document.addEventListener("keydown", (event) => {
    if (!menuOpen) return;
    if (event.key === "Escape") {
      event.preventDefault();
      closeMenu(true);
      return;
    }
    if (event.key !== "Tab" || !header) return;
    const focusable = Array.from(
      header.querySelectorAll<HTMLElement>("a[href], button:not([disabled])"),
    ).filter((item) => item.offsetParent !== null);
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last?.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first?.focus();
    }
  });
</script>
