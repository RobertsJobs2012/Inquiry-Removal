---
import AnnouncementBar from "@/src/components/AnnouncementBar.astro";
import Footer from "@/src/components/Footer.astro";
import LandingHeroVisual from "@/src/components/LandingHeroVisual.astro";
import LandingSection from "@/src/components/LandingSection.astro";
import Navigation from "@/src/components/Navigation.astro";
import PageHero from "@/src/components/PageHero.astro";
import PremiumIcon from "@/src/components/PremiumIcon.astro";

type LandingHeroVisualKey =
  | "dealer"
  | "la"
  | "phoenix"
  | "nyc"
  | "mortgage"
  | "unauthorized"
  | "identityTheft";

type LandingStat = {
  value: string;
  label: string;
};

type LandingSectionData = {
  type?: string;
  heading: string;
  blocks: Array<{ kind: string; text: string }>;
  faqs?: Array<{ q: string; a: string }>;
};

type LandingPageData = {
  schema: Record<string, unknown>;
  faqSchema?: Record<string, unknown>;
  slug: string;
  className: string;
  key: string;
  ctaHref: string;
  downloadHref: string;
  downloadCta: string;
  heroVisual: LandingHeroVisualKey;
  hero: {
    title: string;
    subtitle: string;
    primaryCta: string;
    secondaryCta: string;
    fearKiller: string;
  };
  stats: LandingStat[];
  press: string[];
  sections: LandingSectionData[];
};

const { page } = Astro.props as { page: LandingPageData };
import "../styles/pages/landing.css";

---
<AnnouncementBar />
<Navigation activePath={page.slug} />
<main id="main" class={"landing-page " + page.className}>
  <PageHero id={page.key + "-hero-heading"}>
    <Fragment slot="title">{page.hero.title}</Fragment>
    <p slot="subtitle">{page.hero.subtitle}</p>
    <Fragment slot="meta">
      <span><PremiumIcon name="checkBadge" size={15} /> 100,437 Hard Inquiries Removed</span>
      <span><PremiumIcon name="star" size={15} /> 4.9 Stars — 312 Google Reviews</span>
      <span><PremiumIcon name="guaranteeSeal" size={15} /> 100% Money-Back Guarantee</span>
    </Fragment>
    <Fragment slot="actions">
      <a href={page.ctaHref} class="btn btn-primary btn-large">{page.hero.primaryCta}</a>
      {page.hero.secondaryCta.includes("Call") ? (
        <a href="tel:6023776626" class="btn btn-secondary btn-large">{page.hero.secondaryCta}</a>
      ) : (
        <a href="/how-it-works" class="btn btn-secondary btn-large">{page.hero.secondaryCta}</a>
      )}
    </Fragment>
    <p slot="copyAfter" class="landing-fear-killer">{page.hero.fearKiller}</p>
    <LandingHeroVisual visualKey={page.heroVisual} />
  </PageHero>

  <section class="landing-trust section-divider" aria-labelledby={page.key + "-trust-heading"}>
    <div class="container">
      <h2 id={page.key + "-trust-heading"} class="sr-only">Trust indicators</h2>
      <div class="landing-stats">
        {page.stats.map((stat: LandingStat) => <article class="landing-stat"><strong>{stat.value}</strong><span>{stat.label}</span></article>)}
      </div>
      <div class="landing-press">{page.press.map((item: string) => <span>{item}</span>)}</div>
    </div>
  </section>

  {page.sections.map((section: LandingSectionData, index: number) => <LandingSection page={page} section={section} index={index} />)}
</main>
<Footer />
