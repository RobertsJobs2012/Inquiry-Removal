---
import Logo from "./Logo.astro";
import PremiumIcon from "./PremiumIcon.astro";

const DESKTOP_NAV_ITEMS = [
  { label: "Services", href: "/services" },
  { label: "How It Works", href: "/how-it-works" },
  { label: "Results", href: "/results" },
  { label: "Pricing", href: "/pricing" },
  { label: "About", href: "/about" },
];

const MOBILE_NAV_ITEMS = [
  ...DESKTOP_NAV_ITEMS,
  { label: "FAQ", href: "/faq" },
];

const MOBILE_SERVICE_ITEMS = [
  { label: "All Services", href: "/services" },
  { label: "Car Dealership Inquiries", href: "/car-dealership-inquiry-removal" },
  { label: "Unauthorized Inquiries", href: "/unauthorized-hard-inquiry-removal" },
  { label: "Identity Theft Inquiries", href: "/identity-theft-inquiry-removal" },
  { label: "Mortgage Approval", href: "/hard-inquiry-removal-mortgage" },
  { label: "Los Angeles", href: "/los-angeles-hard-inquiry-removal" },
  { label: "Phoenix", href: "/phoenix-hard-inquiry-removal" },
  { label: "New York City", href: "/new-york-city-hard-inquiry-removal" },
  { label: "Experian", href: "/experian-hard-inquiry-removal" },
  { label: "Equifax", href: "/equifax-hard-inquiry-removal" },
  { label: "TransUnion", href: "/transunion-hard-inquiry-removal" },
];

type NavigationProps = {
  activePath?: string;
};

function normalizePath(path = "/") {
  if (path.length > 1 && path.endsWith("/")) return path.slice(0, -1);
  return path || "/";
}

function navLinkClass(base: string, active: boolean) {
  return active ? `${base} is-active` : base;
}

function navHref(href: string) {
  if (/^(?:tel:|mailto:|#)/.test(href)) return href;
  return href === "/" ? "/" : normalizePath(href);
}

const {
  activePath = "/"
} = Astro.props as NavigationProps;

const currentPath = normalizePath(activePath);
  const isActive = (href: string) => {
    const normalizedHref = normalizePath(href);
    if (
      normalizedHref === "/services" &&
      ((currentPath === "/experian-hard-inquiry-removal" ||
        currentPath === "/equifax-hard-inquiry-removal" ||
        currentPath === "/transunion-hard-inquiry-removal") ||
        currentPath === "/car-dealership-inquiry-removal" ||
        currentPath === "/unauthorized-hard-inquiry-removal" ||
        currentPath === "/identity-theft-inquiry-removal" ||
        currentPath === "/hard-inquiry-removal-mortgage" ||
        currentPath === "/los-angeles-hard-inquiry-removal" ||
        currentPath === "/phoenix-hard-inquiry-removal" ||
        currentPath === "/new-york-city-hard-inquiry-removal")
    ) {
      return true;
    }
    if (normalizedHref === "/") return currentPath === "/";
    return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
  };
---

<div data-nav-root>
      <header class="site-header" data-mobile-header>
        <nav class="site-nav" aria-label="Main navigation">
          <a
            href="/"
            class="nav-logo"
            aria-label="Inquiry Removal — homepage"
            data-event="nav_logo_click"
            data-astro-prefetch
          >
            <Logo size="md" priority />
          </a>

          <ul class="nav-links">
            {DESKTOP_NAV_ITEMS.map((item) => (
              <li class="nav-item">
                <a
                  href={navHref(item.href)}
                  class={navLinkClass("nav-link", isActive(item.href))}
                  aria-current={isActive(item.href) ? "page" : undefined}
                  data-astro-prefetch
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>

          <div class="nav-actions">
            <a
              href="tel:+16023776626"
              class="nav-phone"
              aria-label="Call Inquiry Removal at (602) 377-6626"
              data-event="nav_phone_click"
            >
              <span aria-hidden="true">
                <PremiumIcon name="phone" size={15} strokeWidth={1.75} />
              </span>
              <span class="nav-phone-text">(602) 377-6626</span>
            </a>

            <a
              href="/get-started/"
              class="btn btn-primary nav-cta"
              data-event="nav_consultation_click"
              data-astro-prefetch
            >
              <span class="nav-cta-full">Free Analysis</span>
            </a>

            <button
              type="button"
              class="nav-menu-toggle"
              aria-label="Open menu"
              aria-controls="mobile-menu"
              aria-expanded="false"
              data-mobile-menu-open
            >
              <span class="nav-menu-icon" aria-hidden="true">
                <PremiumIcon name="menu" size={19} />
              </span>
            </button>
          </div>
        </nav>
      </header>

      <button
        type="button"
        class="mobile-menu-backdrop"
        aria-label="Close menu"
        hidden
        data-mobile-menu-backdrop
        data-mobile-menu-close
      ></button>

      <aside
        id="mobile-menu"
        class="mobile-menu"
        aria-label="Mobile menu"
        hidden
        inert
        data-mobile-menu
      >
        <div class="mobile-menu-top">
          <div>
            <span class="mobile-menu-eyebrow">Inquiry Removal</span>
            <strong>Where do you want to go?</strong>
          </div>
          <button
            type="button"
            class="mobile-menu-close"
            aria-label="Close menu"
            data-mobile-menu-close
          >
            <PremiumIcon name="close" size={18} />
          </button>
        </div>

        <ul class="mobile-menu-links">
          <li class="mobile-menu-group">
            <details class="mobile-menu-details">
              <summary class="mobile-menu-group-toggle">
                <span>Services</span>
                <span class="mobile-menu-group-chevron" aria-hidden="true">
                  <PremiumIcon name="chevronDown" size={18} />
                </span>
              </summary>

              <ul class="mobile-menu-sub-links">
                {MOBILE_SERVICE_ITEMS.map((item) => (
                  <li class="mobile-menu-sub-link">
                    <a
                      href={navHref(item.href)}
                      class={navLinkClass("mobile-menu-link", isActive(item.href))}
                      aria-current={isActive(item.href) ? "page" : undefined}
                      data-astro-prefetch
                    >
                      {item.label}
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          </li>

          {MOBILE_NAV_ITEMS.filter((item) => item.href !== "/services").map((item) => (
            <li>
              <a
                href={navHref(item.href)}
                class={navLinkClass("mobile-menu-link", isActive(item.href))}
                aria-current={isActive(item.href) ? "page" : undefined}
                data-astro-prefetch
              >
                {item.label}
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mobile-menu-footer">
          <a
            href="tel:+16023776626"
            class="btn btn-primary mobile-menu-phone"
            data-event="mobile_menu_call_click"
          >
            Call Now
          </a>
          <a
            href="/get-started/"
            class="btn btn-secondary mobile-menu-consult"
            data-event="mobile_menu_consult_click"
            data-astro-prefetch
          >
            Free Analysis
          </a>
        </div>
      </aside>
    </div>

<script is:inline data-astro-rerun>
  (() => {
    const root = document.querySelector("[data-nav-root]");
    if (!root) return;

    const menu = root.querySelector("[data-mobile-menu]");
    const backdrop = root.querySelector("[data-mobile-menu-backdrop]");
    const openButtons = root.querySelectorAll("[data-mobile-menu-open]");
    const closeButtons = root.querySelectorAll("[data-mobile-menu-close]");

    if (!menu || !backdrop) return;

    const syncMenu = (isOpen) => {
      menu.hidden = !isOpen;
      backdrop.hidden = !isOpen;
      menu.classList.toggle("is-open", isOpen);
      document.body.classList.toggle("mobile-menu-open", isOpen);
      openButtons.forEach((button) => button.setAttribute("aria-expanded", String(isOpen)));
      if (isOpen) {
        menu.removeAttribute("inert");
      } else {
        menu.setAttribute("inert", "");
      }
    };

    syncMenu(false);

    openButtons.forEach((button) => {
      button.addEventListener("click", () => {
        syncMenu(true);
        window.requestAnimationFrame(() => {
          const firstLink = menu.querySelector("a, button, summary");
          if (firstLink instanceof HTMLElement) firstLink.focus();
        });
      });
    });

    closeButtons.forEach((button) => {
      button.addEventListener("click", () => syncMenu(false));
    });

    menu.querySelectorAll("a[href]").forEach((link) => {
      link.addEventListener("click", () => syncMenu(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") syncMenu(false);
    });
  })();
</script>

<style>
  :global(body.mobile-menu-open) {
    overflow: hidden;
  }

  .mobile-menu[hidden],
  .mobile-menu-backdrop[hidden] {
    display: none !important;
  }

  @media (max-width: 860px) {
    .mobile-menu {
      transform: translateY(calc(100% + 24px));
      transition: transform 180ms var(--ease-out);
      display: block !important;
    }

    .mobile-menu.is-open {
      transform: translateY(0);
    }
  }
</style>
