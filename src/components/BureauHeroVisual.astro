---
import PremiumIcon from "./PremiumIcon.astro";

type BureauKey = "experian" | "equifax" | "transunion";
type BureauIconName = "bureauShield" | "lawShield" | "scoreRise";

type VisualConfig = {
  bureau: string;
  eyebrow: string;
  score: string;
  scoreLabel: string;
  primaryLabel: string;
  secondaryLabel: string;
  lawLabel: string;
  badge: string;
  icon: BureauIconName;
};

const VISUALS: Record<BureauKey, VisualConfig> = {
  experian: {
    bureau: "Experian",
    eyebrow: "Report review",
    score: "+94",
    scoreLabel: "points",
    primaryLabel: "Unauthorized",
    secondaryLabel: "Permissible purpose",
    lawLabel: "FCRA",
    badge: "Removed",
    icon: "bureauShield",
  },
  equifax: {
    bureau: "Equifax",
    eyebrow: "Escalation file",
    score: "+97",
    scoreLabel: "points",
    primaryLabel: "Verified",
    secondaryLabel: "CFPB escalation",
    lawLabel: "FCRA",
    badge: "Challenged",
    icon: "lawShield",
  },
  transunion: {
    bureau: "TransUnion",
    eyebrow: "Credit Karma review",
    score: "+79",
    scoreLabel: "points",
    primaryLabel: "Regular inquiry",
    secondaryLabel: "Permissible purpose",
    lawLabel: "15 U.S.C. § 1681b",
    badge: "Removed",
    icon: "scoreRise",
  },
};

const {
  bureau
} = Astro.props as { bureau: BureauKey };

const visual = VISUALS[bureau];
---

<aside class={`bureau-hero-visual bureau-hero-visual-${bureau}`} aria-hidden="true">
      <div class="bureau-visual-glow" />
      <div class="bureau-visual-card">
        <div class="bureau-visual-top">
          <span class="bureau-visual-icon">
            <PremiumIcon name={visual.icon} size={22} />
          </span>
          <div>
            <span class="bureau-visual-eyebrow">{visual.eyebrow}</span>
            <strong>{visual.bureau}</strong>
          </div>
          <span class="bureau-visual-badge">{visual.badge}</span>
        </div>

        <div class="bureau-visual-score">
          <span>{visual.score}</span>
          <small>{visual.scoreLabel}</small>
        </div>

        <div class="bureau-visual-meter">
          <span />
        </div>

        <div class="bureau-visual-rows">
          <div class="bureau-visual-row bureau-visual-row-active">
            <span>{visual.primaryLabel}</span>
            <strong>01</strong>
          </div>
          <div class="bureau-visual-row">
            <span>{visual.secondaryLabel}</span>
            <strong>02</strong>
          </div>
          <div class="bureau-visual-row">
            <span>{visual.lawLabel}</span>
            <strong>03</strong>
          </div>
        </div>

        <div class="bureau-visual-rail">
          <i />
          <i />
          <i />
        </div>
      </div>
    </aside>

<style>
  .bureau-hero-visual {
    width: min(100%, 520px);
    min-height: 420px;
    position: relative;
    align-self: center;
    justify-self: center;
    display: grid;
    place-items: center;
  }

  .bureau-visual-glow {
    position: absolute;
    inset: 10% 0 4%;
    border-radius: 32px;
    background: linear-gradient(135deg, rgba(10, 141, 255, 0.28), rgba(123, 92, 255, 0.22), rgba(255, 79, 163, 0.18));
    filter: blur(34px);
    opacity: 0.72;
    transform: rotate(-3deg);
  }

  .bureau-visual-card {
    position: relative;
    width: min(100%, 460px);
    padding: clamp(22px, 4vw, 30px);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-2xl);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.03)), rgba(17, 17, 24, 0.88);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08) inset, 0 32px 80px rgba(0, 0, 0, 0.42);
    overflow: hidden;
  }

  .bureau-visual-card::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(120deg, rgba(10, 141, 255, 0.18), transparent 34%),
      linear-gradient(300deg, rgba(255, 79, 163, 0.16), transparent 42%);
    opacity: 0.82;
  }

  .bureau-visual-card > * {
    position: relative;
    z-index: 1;
  }

  .bureau-visual-top {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 14px;
    align-items: center;
  }

  .bureau-visual-icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 16px;
    color: #fff;
    background: var(--brand-gradient);
    box-shadow: var(--shadow-cta);
  }

  .bureau-visual-eyebrow {
    display: block;
    color: rgba(226, 232, 240, 0.62);
    font-size: 0.72rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .bureau-visual-top strong {
    color: #fff;
    font-family: var(--font-heading), sans-serif;
    font-size: 1.1rem;
  }

  .bureau-visual-badge {
    padding: 0.42rem 0.62rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.72rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .bureau-visual-score {
    display: flex;
    align-items: end;
    gap: 0.75rem;
    margin: 28px 0 18px;
  }

  .bureau-visual-score span {
    font-family: var(--font-heading), sans-serif;
    font-size: clamp(3.5rem, 10vw, 5rem);
    font-weight: 950;
    line-height: 0.9;
    background: var(--brand-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bureau-visual-score small {
    color: rgba(226, 232, 240, 0.72);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .bureau-visual-meter {
    height: 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    overflow: hidden;
  }

  .bureau-visual-meter span {
    display: block;
    width: 82%;
    height: 100%;
    border-radius: inherit;
    background: var(--brand-gradient);
  }

  .bureau-visual-rows {
    display: grid;
    gap: 0.7rem;
    margin-top: 18px;
  }

  .bureau-visual-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.04);
    color: rgba(226, 232, 240, 0.75);
    font-weight: 650;
  }

  .bureau-visual-row-active {
    color: #fff;
    border-color: rgba(255, 79, 163, 0.34);
    background: rgba(255, 79, 163, 0.08);
  }

  .bureau-visual-row strong {
    color: #fff;
  }

  .bureau-visual-rail {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    margin-top: 20px;
  }

  .bureau-visual-rail i {
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
  }

  @media (max-width: 640px) {
    .bureau-hero-visual {
      min-height: auto;
    }

    .bureau-visual-card {
      padding: 18px;
    }

    .bureau-visual-score {
      margin: 24px 0 14px;
    }

    .bureau-visual-score span {
      font-size: 3.5rem;
    }
  }

  @media (max-width: 760px), (prefers-reduced-data: reduce) {
    .bureau-visual-glow {
      opacity: 0.42;
    }
  }

  @media (prefers-reduced-data: reduce) {
    .bureau-visual-glow {
      display: none;
    }
  }
</style>
