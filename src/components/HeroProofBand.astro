---
import PremiumIcon from "./PremiumIcon.astro";

const DEFAULT_ITEMS = [
  {
    icon: "bureauShield" as const,
    label: "Experian",
    href: "/experian-hard-inquiry-removal",
  },
  {
    icon: "bureauShield" as const,
    label: "Equifax",
    href: "/equifax-hard-inquiry-removal",
  },
  {
    icon: "bureauShield" as const,
    label: "TransUnion",
    href: "/transunion-hard-inquiry-removal",
  },
  {
    icon: "guaranteeSeal" as const,
    label: "Free Analysis",
    href: "/get-started",
  },
];

type HeroProofBandProps = {
  class?: string;
};

const {
  class: className = ""
} = Astro.props as HeroProofBandProps;

const classes = ["hero-proof-band", className].filter(Boolean).join(" ");
---

<div class={classes} aria-label="Inquiry Removal trust signals">
      {DEFAULT_ITEMS.map((item) => (
        <a href={item.href} class="hero-proof-pill">
          <span class="hero-proof-icon" aria-hidden="true">
            <PremiumIcon name={item.icon} size={15} strokeWidth={1.8} />
          </span>
          <span>{item.label}</span>
        </a>
      ))}
    </div>
