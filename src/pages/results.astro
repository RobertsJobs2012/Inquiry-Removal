---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_ORIGIN } from "../data/discovery.mjs";

const cases = [
  ["CASE SLOT 01", "dealership", "multiple", "11-30", "Dealership financing", "Multiple bureaus", "11–30 inquiries"],
  ["CASE SLOT 02", "unauthorized", "experian", "1-10", "Unauthorized inquiry", "Experian", "1–10 inquiries"],
  ["CASE SLOT 03", "identity-theft", "transunion", "1-10", "Identity theft", "TransUnion", "1–10 inquiries"],
  ["CASE SLOT 04", "other", "equifax", "1-10", "Inquiry review", "Equifax", "1–10 inquiries"],
  ["CASE SLOT 05", "dealership", "experian", "31-plus", "High-volume dealership", "Experian", "31+ inquiries"],
  ["CASE SLOT 06", "other", "multiple", "11-30", "Multi-bureau review", "Multiple bureaus", "11–30 inquiries"],
];

const proofTypes = [
  ["Updated credit reports", "A later report can show whether a previously documented inquiry is still being reported by the applicable bureau."],
  ["Bureau responses", "Investigation responses and update notices can document how a bureau handled the inquiry information."],
  ["Creditor correspondence", "A lender or creditor response can provide context about authorization, identity, or the reported inquiry."],
  ["Monitoring notifications", "Monitoring alerts can supplement the record when they clearly identify an inquiry-related change."],
];

const faqs = [
  ["Are these case cards real client results yet?", "No. The current case cards are clearly labeled layout placeholders. They show how verified cases will be presented, but they do not claim any client deletion, timeline, inquiry count, or outcome."],
  ["What happens before a placeholder becomes a real case?", "The case should be supported by records that establish the starting inquiry information and the later documented outcome. Public evidence must also be permanently redacted to protect personal information."],
  ["Will a past result guarantee what happens on my reports?", "No. Past cases can show what happened under particular facts, but they cannot guarantee another consumer's removals, timeline, score change, approval, or bureau outcome."],
  ["Why will identifying information be hidden?", "Credit reports and related correspondence can contain highly sensitive information. Public case evidence should show only what is reasonably necessary to understand the inquiry situation and documented result."],
  ["Can one bureau change while another does not?", "Yes. Credit reports are separate records, and outcomes can differ by bureau, creditor, documentation, and the facts of the case."],
  ["Can I request a review before there is a case exactly like mine?", "Yes. The free inquiry review looks at your actual reports, bureaus, inquiry count, and circumstances. You do not need to find a matching case study first."],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE_ORIGIN}/` },
      { "@type": "ListItem", position: 2, name: "Results & Case Studies", item: `${SITE_ORIGIN}/results/` },
    ],
  },
];
---

<BaseLayout
  title="Hard Inquiry Removal Results | Real Cases & Proof"
  description="Explore the Inquiry Removal evidence center and see how verified hard inquiry cases will document situations, bureaus, timelines, and redacted proof."
  ogTitle="Hard Inquiry Removal Results & Documented Proof"
  ogDescription="A transparent evidence center for hard inquiry removal case studies across Experian, Equifax, and TransUnion."
  robots="noindex, follow"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="results-hero dark-section">
      <div class="results-glow" aria-hidden="true"></div>
      <div class="container results-hero__grid">
        <div data-reveal>
          <nav class="breadcrumb results-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><span>Results & Case Studies</span>
          </nav>
          <p class="eyebrow eyebrow--light"><span></span> Documented Hard Inquiry Results</p>
          <h1>Hard Inquiry Removal Results: Real Cases & Documented Proof</h1>
          <p class="hero-summary">Don’t rely on promises. See the situation, the bureau, what changed, how long it took, and the redacted documentation behind each result.</p>
          <p class="hero-lead">The evidence center is being prepared case by case. The final structure is live now, while every case slot remains unmistakably labeled until real client records are verified, privacy-reviewed, and ready to replace it. No placeholder is presented as an actual client result.</p>
          <div class="button-row">
            <a class="button button--large" href="/free-inquiry-review/?source=/results/&context=results" data-track="results-hero-review" data-context="results">Review My Inquiries <span>→</span></a>
            <a class="text-link text-link--light" href="#case-library">Explore the Case Library <span>↓</span></a>
          </div>
          <p class="cta-microcopy">Free personal review. No pressure. No monthly membership.</p>
        </div>

        <aside class="evidence-console" data-reveal aria-label="Illustrative evidence workflow">
          <div class="console-head"><span>INQUIRY REMOVAL</span><span>EVIDENCE CENTER</span></div>
          <article><small>01 · STARTING RECORD</small><strong>Original inquiry documented</strong><div class="skeleton"><i></i><i></i><i></i></div></article>
          <b aria-hidden="true">↓</b>
          <article><small>02 · REVIEW</small><strong>Situation + bureau + documentation</strong><div class="tags"><span>REPORT</span><span>DATE</span><span>CREDITOR</span></div></article>
          <b aria-hidden="true">↓</b>
          <article class="verified"><small>03 · UPDATED RECORD</small><strong>Confirmed change documented</strong><em>Verified evidence goes here</em></article>
          <p>Illustrative workflow only. No client result is represented in this graphic.</p>
        </aside>
      </div>
    </section>

    <section class="proof-ribbon">
      <div class="container proof-ribbon__grid">
        <div><strong>100,437</strong><span>Inquiries removed</span></div>
        <div><strong>1,123</strong><span>Clients served</span></div>
        <div><strong>Since 2015</strong><span>Focused credit experience</span></div>
        <div><strong>3 bureaus</strong><span>Experian · Equifax · TransUnion</span></div>
      </div>
      <p class="container proof-note">Published company figures are separate from the placeholder case layouts below. Individual results vary.</p>
    </section>

    <section class="section">
      <div class="container standard-grid">
        <div data-reveal>
          <p class="eyebrow"><span></span> Proof before persuasion</p>
          <h2>What Counts as a Hard Inquiry Removal Result?</h2>
          <p class="section-copy">A result should be tied to the underlying record. A submitted dispute, an expected outcome, or an unverified statement is not the same as documentation showing what actually changed.</p>
        </div>
        <div class="proof-types" data-reveal>
          {proofTypes.map(([title, body]) => (
            <article><span>✓</span><h3>{title}</h3><p>{body}</p></article>
          ))}
        </div>
      </div>
    </section>

    <section class="section library" id="case-library">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div><p class="eyebrow"><span></span> Results explorer</p><h2>Find Cases Similar to Your Situation</h2></div>
          <p>The filters are already built for the final evidence library. For now, they organize labeled case slots. Verified cases can replace these placeholders later without redesigning the page.</p>
        </div>

        <div class="filters" data-reveal>
          <label>What happened?<select data-situation><option value="all">All situations</option><option value="dealership">Dealership financing</option><option value="unauthorized">Unauthorized inquiry</option><option value="identity-theft">Identity theft</option><option value="other">Other</option></select></label>
          <label>Which bureau?<select data-bureau><option value="all">All bureaus</option><option value="experian">Experian</option><option value="equifax">Equifax</option><option value="transunion">TransUnion</option><option value="multiple">Multiple bureaus</option></select></label>
          <label>Inquiry count<select data-count><option value="all">Any count</option><option value="1-10">1–10</option><option value="11-30">11–30</option><option value="31-plus">31+</option></select></label>
        </div>
        <p class="filter-status" data-status aria-live="polite">Showing all case-layout placeholders. These are not client results.</p>

        <div class="case-grid">
          {cases.map(([id, situation, bureau, count, label, bureauLabel, countLabel]) => (
            <article class="case-card" data-case data-situation-key={situation} data-bureau-key={bureau} data-count-key={count}>
              <header><span>{id}</span><strong>SAMPLE LAYOUT · NOT A CLIENT RESULT</strong></header>
              <div class="case-meta"><span>{label}</span><span>{bureauLabel}</span><span>{countLabel}</span></div>
              <h3>{label} case</h3>
              <p>This slot will be replaced by a verified case summary, the actual bureau context, the documented timeline, and privacy-safe evidence.</p>
              <div class="case-story">
                <div><small>THE SITUATION</small><span>Verified client context will appear here.</span></div>
                <div><small>WHAT WE REVIEWED</small><span>Inquiry names, dates, bureaus, and relevant documentation.</span></div>
                <div><small>DOCUMENTED OUTCOME</small><span>Confirmed result and actual timeline will replace this placeholder.</span></div>
              </div>
              <div class="evidence-pair">
                <div><small>BEFORE EVIDENCE</small><div class="document"><i></i><i></i><i></i><b></b></div><p>Redacted starting record goes here.</p></div>
                <div><small>AFTER EVIDENCE</small><div class="document document--after"><i></i><i></i><i></i><b></b></div><p>Redacted updated record goes here.</p></div>
              </div>
              <p class="placeholder-note">Placeholder only. No inquiry count, deletion, timeline, or outcome is being claimed by this card.</p>
            </article>
          ))}
        </div>
        <div class="empty-state" hidden data-empty><strong>No placeholder matches those filters.</strong><p>Choose different filters or request a review of your actual inquiries.</p></div>
      </div>
    </section>

    <section class="method dark-section">
      <div class="container method-grid">
        <div data-reveal>
          <p class="eyebrow eyebrow--light"><span></span> Evidence methodology</p>
          <h2>How Will We Verify a Published Inquiry Result?</h2>
          <p>The final library will use a consistent evidence standard so visitors can distinguish documented change from marketing language.</p>
        </div>
        <ol data-reveal>
          <li><span>01</span><div><h3>Establish the starting record</h3><p>Document the creditor or lender name, inquiry date, affected bureau, and relevant case context.</p></div></li>
          <li><span>02</span><div><h3>Track the response path</h3><p>Keep the bureau, creditor, monitoring, or client records that explain what happened after the review began.</p></div></li>
          <li><span>03</span><div><h3>Compare the updated record</h3><p>Compare later documentation against the original inquiry list instead of relying on memory or expectation.</p></div></li>
          <li><span>04</span><div><h3>Publish only what the records support</h3><p>If the available evidence does not establish a change, the case should not claim one.</p></div></li>
        </ol>
      </div>
      <div class="container method-quote" data-reveal>We count documented changes, not expectations.</div>
    </section>

    <section class="section">
      <div class="container honest-grid">
        <div data-reveal><p class="eyebrow"><span></span> Real outcomes are not identical</p><h2>Not Every Hard Inquiry Case Ends the Same Way</h2></div>
        <div data-reveal>
          <p>Some cases may result in substantial changes. Some may involve partial changes. Some can require additional follow-up. And some inquiries may remain when the facts or available documentation do not support a different outcome.</p>
          <blockquote>A Results page should show what happened, not make every case look perfect.</blockquote>
          <p>When real cases are added, partial or mixed outcomes can remain visible when that is what the documentation shows. Past results will never be presented as a guarantee of another consumer’s deletion, timeline, score, or approval.</p>
        </div>
      </div>
    </section>

    <section class="section bureau-section">
      <div class="container">
        <div class="section-heading centered-heading" data-reveal><p class="eyebrow centered"><span></span> Proof by bureau</p><h2>Results Will Be Organized Across All Three Credit Bureaus</h2><p>Each bureau is a separate report. The evidence library will preserve that distinction rather than implying one bureau’s outcome proves another bureau changed too.</p></div>
        <div class="bureau-grid" data-reveal>
          <a href="/experian-hard-inquiry-removal/"><span>EXPERIAN</span><strong>Experian inquiry guide</strong><p>Review the bureau-specific process and current guidance.</p><em>Explore Experian →</em></a>
          <a href="/equifax-hard-inquiry-removal/"><span>EQUIFAX</span><strong>Equifax inquiry guide</strong><p>See how Equifax inquiry review fits into the broader process.</p><em>Explore Equifax →</em></a>
          <a href="/transunion-hard-inquiry-removal/"><span>TRANSUNION</span><strong>TransUnion inquiry guide</strong><p>Review the TransUnion-specific inquiry and dispute pathway.</p><em>Explore TransUnion →</em></a>
        </div>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-layout">
        <div data-reveal><p class="eyebrow"><span></span> Results questions</p><h2>Questions About the Evidence Library</h2><p>The page is intentionally transparent about what is real today and what will be replaced when verified case material is ready.</p></div>
        <div class="faq-list" data-reveal>
          {faqs.map(([question, answer]) => <details><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}
        </div>
      </div>
    </section>

    <section class="final-cta dark-section" id="free-review">
      <div class="container final-cta__inner" data-reveal>
        <p class="eyebrow eyebrow--light centered"><span></span> Your reports are the next step</p>
        <h2>You Don’t Need a Matching Case Study to Review Your Inquiries</h2>
        <p>Tell us what happened, which reports are affected, and approximately how many hard inquiries you are dealing with. The free review looks at your situation instead of promising that somebody else’s outcome will become yours.</p>
        <a class="button button--large" href="/free-inquiry-review/?source=/results/&context=results-final" data-track="results-final-review" data-context="results">Get My Free Inquiry Review <span>→</span></a>
        <p class="cta-microcopy">Free review · All three bureaus · Nationwide · No monthly membership</p>
      </div>
    </section>
  </main>
  <Footer />

  <script is:inline>
    (() => {
      const situation = document.querySelector('[data-situation]');
      const bureau = document.querySelector('[data-bureau]');
      const count = document.querySelector('[data-count]');
      const cards = Array.from(document.querySelectorAll('[data-case]'));
      const status = document.querySelector('[data-status]');
      const empty = document.querySelector('[data-empty]');
      if (!(situation instanceof HTMLSelectElement) || !(bureau instanceof HTMLSelectElement) || !(count instanceof HTMLSelectElement)) return;

      const params = new URLSearchParams(location.search);
      if (params.get('situation')) situation.value = params.get('situation');
      if (params.get('bureau')) bureau.value = params.get('bureau');
      if (params.get('count')) count.value = params.get('count');

      const apply = () => {
        let shown = 0;
        cards.forEach((node) => {
          if (!(node instanceof HTMLElement)) return;
          const visible =
            (situation.value === 'all' || node.dataset.situationKey === situation.value) &&
            (bureau.value === 'all' || node.dataset.bureauKey === bureau.value) &&
            (count.value === 'all' || node.dataset.countKey === count.value);
          node.hidden = !visible;
          if (visible) shown += 1;
        });
        if (status) status.textContent = shown ? `Showing ${shown} matching case-layout placeholder${shown === 1 ? '' : 's'}. These are not client results.` : 'No case-layout placeholder matches those filters.';
        if (empty instanceof HTMLElement) empty.hidden = shown > 0;
        const next = new URLSearchParams();
        if (situation.value !== 'all') next.set('situation', situation.value);
        if (bureau.value !== 'all') next.set('bureau', bureau.value);
        if (count.value !== 'all') next.set('count', count.value);
        history.replaceState({}, '', `${location.pathname}${next.toString() ? `?${next}` : ''}#case-library`);
      };

      situation.addEventListener('change', apply);
      bureau.addEventListener('change', apply);
      count.addEventListener('change', apply);
      if (params.toString()) apply();
    })();
  </script>

  <style>
    .results-hero{position:relative;overflow:hidden;padding:clamp(7rem,11vw,9rem) 0 clamp(4.5rem,8vw,7rem)}
    .results-glow{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 80% 25%,rgba(20,164,216,.18),transparent 28rem),radial-gradient(circle at 14% 0,rgba(15,165,138,.1),transparent 22rem)}
    .results-hero__grid{position:relative;display:grid;grid-template-columns:1.08fr .92fr;gap:clamp(2.5rem,6vw,6rem);align-items:center}
    .results-breadcrumb a,.results-breadcrumb span{color:#92a9b6}.results-hero h1{max-width:12ch;margin:1rem 0 1.2rem;color:#fff;font-size:clamp(3rem,6.3vw,6.4rem);line-height:.95;letter-spacing:-.06em}
    .hero-summary{max-width:42rem;margin:0 0 1rem;color:#e9f4fa;font-size:clamp(1.18rem,2vw,1.5rem);line-height:1.5}.hero-lead{max-width:43rem;color:#9fb4c0;line-height:1.75}
    .evidence-console{padding:1.25rem;border:1px solid rgba(125,210,255,.18);border-radius:1.35rem;background:rgba(6,27,43,.8);box-shadow:0 2rem 6rem rgba(0,0,0,.25)}
    .console-head{display:flex;justify-content:space-between;gap:1rem;padding-bottom:1rem;border-bottom:1px solid rgba(255,255,255,.08);color:#849eac;font-size:.65rem;font-weight:800;letter-spacing:.1em}.evidence-console article{padding:1rem;margin-top:.7rem;border:1px solid rgba(255,255,255,.08);border-radius:.9rem;background:rgba(255,255,255,.035)}.evidence-console small{display:block;margin-bottom:.4rem;color:#5dcbd6;font-size:.65rem;letter-spacing:.09em}.evidence-console strong{color:#fff}.evidence-console>b{display:block;color:#3b9fd0;text-align:center}.evidence-console>p{color:#7e96a2;font-size:.73rem;line-height:1.5}.verified{border-color:rgba(15,165,138,.3)!important}.verified em{display:inline-block;margin-top:.7rem;padding:.35rem .5rem;border-radius:.45rem;background:rgba(15,165,138,.12);color:#8ce0cf;font-size:.68rem;font-style:normal}.skeleton{display:grid;gap:.3rem;margin-top:.65rem}.skeleton i{height:.35rem;border-radius:99px;background:rgba(255,255,255,.08)}.skeleton i:nth-child(2){width:76%}.skeleton i:nth-child(3){width:55%}.tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.65rem}.tags span{padding:.3rem .4rem;border-radius:.4rem;background:rgba(20,164,216,.1);color:#a7dff5;font-size:.62rem;font-weight:700}
    .proof-ribbon{padding:1.35rem 0 1rem;border-bottom:1px solid #dce6eb;background:#f6f9fb}.proof-ribbon__grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.proof-ribbon__grid div{display:grid;gap:.15rem}.proof-ribbon strong{color:#081b2c;font-size:clamp(1.25rem,2vw,1.65rem)}.proof-ribbon span{color:#576d78;font-size:.82rem}.proof-note{margin-top:.8rem;color:#7c8d95;font-size:.72rem}
    .standard-grid,.method-grid,.honest-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2.5rem,6vw,6rem);align-items:start}.section-copy,.honest-grid p{color:#536873;line-height:1.8}.proof-types{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.proof-types article{padding:1.25rem;border:1px solid #dce6eb;border-radius:1rem;background:#fff}.proof-types article>span{display:grid;place-items:center;width:1.9rem;height:1.9rem;margin-bottom:.8rem;border-radius:50%;background:#e8f7f2;color:#087a66;font-weight:800}.proof-types h3{margin:0 0 .45rem;color:#081b2c;font-size:1rem}.proof-types p{margin:0;color:#62757e;font-size:.86rem;line-height:1.6}
    .library,.bureau-section{background:#f5f8fa}.filters{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem;margin:2rem 0 1rem;padding:1rem;border:1px solid #d9e4e9;border-radius:1rem;background:#fff}.filters label{display:grid;gap:.4rem;color:#3d5865;font-size:.72rem;font-weight:700}.filters select{min-height:3rem;padding:0 .8rem;border:1px solid #cad8df;border-radius:.7rem;background:#fbfdfe;color:#102b3b;font:inherit}.filter-status{margin:0 0 1.1rem;color:#6f8088;font-size:.8rem}.case-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.1rem}.case-card{overflow:hidden;border:1px solid #d8e3e8;border-radius:1.15rem;background:#fff;box-shadow:0 1rem 2.5rem rgba(8,27,44,.05)}.case-card[hidden]{display:none}.case-card header{display:flex;justify-content:space-between;gap:1rem;padding:.85rem 1rem;background:#092134;color:#a9bdc8;font-size:.64rem;letter-spacing:.07em}.case-card header strong{color:#ffd078;font-size:.59rem}.case-meta{display:flex;flex-wrap:wrap;gap:.4rem;padding:1rem 1rem 0}.case-meta span{padding:.32rem .45rem;border-radius:.45rem;background:#edf4f7;color:#45616e;font-size:.67rem;font-weight:700}.case-card>h3{margin:.9rem 1rem .35rem;color:#081b2c;font-size:1.3rem}.case-card>p{margin:.35rem 1rem 1rem;color:#61747d;line-height:1.65}.case-story{display:grid;gap:.55rem;margin:1rem;padding:.9rem;border-radius:.8rem;background:#f6f9fa}.case-story div{display:grid;gap:.15rem}.case-story small,.evidence-pair small{color:#1685b9;font-size:.6rem;font-weight:800;letter-spacing:.08em}.case-story span{color:#425d69;font-size:.8rem}.evidence-pair{display:grid;grid-template-columns:1fr 1fr;gap:.65rem;margin:1rem}.evidence-pair>div{padding:.7rem;border:1px solid #dfe8ec;border-radius:.8rem}.evidence-pair p{margin:.55rem 0 0;color:#75868e;font-size:.69rem}.document{position:relative;display:grid;gap:.28rem;min-height:6rem;margin-top:.55rem;padding:.7rem;border-radius:.5rem;background:#eef3f5}.document i{display:block;width:90%;height:.32rem;border-radius:99px;background:#c8d3d8}.document i:nth-child(2){width:68%}.document b{position:absolute;left:.7rem;right:.7rem;bottom:.7rem;height:1.15rem;border:1px dashed #86a5b4;border-radius:.3rem}.document--after b{border-color:#52a993;background:rgba(15,165,138,.06)}.placeholder-note{padding:.75rem 1rem 1rem;border-top:1px solid #e8eef1;color:#8b6b35!important;font-size:.7rem}.empty-state{padding:2rem;border:1px dashed #bacbd3;border-radius:1rem;text-align:center}
    .method{padding:clamp(5rem,9vw,8rem) 0}.method h2{color:#fff}.method-grid>div>p:last-child{color:#9db1bd;line-height:1.75}.method ol{display:grid;gap:.7rem;margin:0;padding:0;list-style:none}.method li{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:1rem;border:1px solid rgba(255,255,255,.08);border-radius:.9rem;background:rgba(255,255,255,.035)}.method li>span{color:#55c7d4;font-weight:800}.method h3{margin:0 0 .35rem;color:#fff;font-size:1rem}.method li p{margin:0;color:#92a9b5;font-size:.85rem;line-height:1.55}.method-quote{margin-top:2rem;padding-top:2rem;border-top:1px solid rgba(255,255,255,.09);color:#fff;font-family:"Newsreader",serif;font-size:clamp(2rem,4vw,4rem)}
    .honest-grid blockquote{margin:1.8rem 0;padding:1.2rem 0 1.2rem 1.2rem;border-left:3px solid #0fa58a;color:#0b2b3c;font-family:"Newsreader",serif;font-size:clamp(1.6rem,3vw,2.3rem);line-height:1.2}.bureau-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:2rem}.bureau-grid a{display:grid;min-height:14rem;padding:1.3rem;border:1px solid #d9e4e9;border-radius:1rem;background:#fff;color:inherit;text-decoration:none}.bureau-grid a>span{color:#1685b9;font-size:.65rem;font-weight:800;letter-spacing:.09em}.bureau-grid strong{margin-top:auto;color:#081b2c;font-size:1.18rem}.bureau-grid p{color:#637680;line-height:1.55}.bureau-grid em{color:#087c66;font-size:.8rem;font-style:normal;font-weight:700}
    @media(max-width:960px){.results-hero__grid,.standard-grid,.method-grid,.honest-grid{grid-template-columns:1fr}.results-hero h1{max-width:15ch}.evidence-console{max-width:42rem}}
    @media(max-width:720px){.results-hero{padding-top:6.6rem}.results-hero h1{font-size:clamp(2.7rem,13vw,4.2rem)}.proof-ribbon__grid,.proof-types{grid-template-columns:1fr 1fr}.filters,.case-grid,.bureau-grid{grid-template-columns:1fr}.evidence-pair{grid-template-columns:1fr}.case-card header{align-items:flex-start;flex-direction:column}}
    @media(max-width:480px){.proof-ribbon__grid,.proof-types{grid-template-columns:1fr 1fr}}
  </style>
</BaseLayout>
