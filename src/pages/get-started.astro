---
import BaseLayout from "../layouts/BaseLayout.astro";
import AnnouncementBar from "../components/AnnouncementBar.astro";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import GetStartedQuizStatic from "../components/GetStartedQuizStatic.astro";
import { packagePages } from "@/lib/package-pages";
import { packageSchemas } from "@/lib/package-schemas";
import "../styles/pages/get-started.css";

const page = packagePages["/get-started"];
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonicalPath={page.route}
  ogImage={page.ogImage}
  ogImageType="image/webp"
  ogImageAlt={`${page.h1} — Inquiry Removal`}
  schema={packageSchemas["/get-started"]}
  pathname={page.route}
>
  <AnnouncementBar />
  <Navigation activePath={page.route} />
  <main id="main" class="get-started-page-main">
    <GetStartedQuizStatic />
  </main>
  <Footer />
</BaseLayout>
