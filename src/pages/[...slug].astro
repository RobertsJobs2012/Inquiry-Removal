---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuidePage from "../components/GuidePage.astro";
import { pages, type SitePage } from "../data/pages";
import {
  guidePages,
  guideSlugs,
  type GuidePage as GuidePageData,
} from "../data/guides";
import { isIndexablePath, SITE_ORIGIN } from "../data/discovery.mjs";

export function getStaticPaths() {
  return [
    ...pages
      .filter((page) => !guideSlugs.has(page.slug))
      .map((page) => ({
        params: { slug: page.slug },
        props: { page },
      })),
    ...guidePages.map((guide) => ({
      params: { slug: guide.slug },
      props: { guide },
    })),
  ];
}

interface Props {
  page?: SitePage;
  guide?: GuidePageData;
}

const rawGuide = Astro.props.guide;
const rawPage = Astro.props.page ?? pages[0];

const guide: GuidePageData | undefined =
  rawGuide?.slug === "transunion-hard-inquiry-removal"
    ? {
        ...rawGuide,
        sections: rawGuide.sections.map((section) =>
          section.heading === "How can you remove a hard inquiry from TransUnion?"
            ? {
                ...section,
                heading: "How Do You Remove Hard Inquiries From TransUnion?",
              }
            : section,
        ),
        faqs: [
          ...rawGuide.faqs.map((faq) =>
            faq.question === "Can I dispute hard inquiries on TransUnion?"
              ? {
                  ...faq,
                  question: "How Do I Dispute Hard Inquiries on TransUnion?",
                  answer:
                    "Start with the exact TransUnion inquiry entry, identify the company that placed it, document what is inaccurate or does not belong to you, and use the current TransUnion process that fits the facts. Inquiry Removal can handle the dispute communications and follow-through for you.",
                }
              : faq,
          ),
          {
            question:
              "How Long Do Hard Inquiries Stay on a TransUnion Credit Report?",
            answer:
              "Hard inquiries generally remain visible on a credit report for up to two years, although their scoring impact can fade sooner. If a TransUnion inquiry is inaccurate, unauthorized, fraudulent, duplicated, or otherwise questionable, you do not have to simply wait for it to age off before reviewing your options.",
          },
        ],
      }
    : rawGuide;

const page: SitePage =
  rawPage.slug === "faq"
    ? {
        ...rawPage,
        sections: rawPage.sections.flatMap((section) =>
          section.heading === "How Quickly Can Hard Inquiries Be Removed?"
            ? [
                section,
                {
                  heading: "Can Hard Inquiries Be Removed in 24 Hours?",
                  body: [
                    "A 24-hour removal should not be promised or expected. Some inquiry removals can happen quickly, but Inquiry Removal tells clients that the process may take longer because creditors and credit bureaus respond on different schedules. Our earliest published timing is as little as seven days, not 24 hours.",
                  ],
                },
                {
                  heading: "What Happens When a Hard Inquiry Is Removed?",
                  body: [
                    "When a hard inquiry is removed, the entry should no longer appear on the affected credit report after the update is processed. That does not guarantee a particular score increase or approval because credit decisions and scores consider the rest of the credit profile as well.",
                  ],
                },
              ]
            : [section],
        ),
      }
    : rawPage.slug === "areas-we-serve"
      ? {
          ...rawPage,
          sections: rawPage.sections.flatMap((section) =>
            section.heading === "Ready to Start Removing Your Hard Inquiries?"
              ? [
                  {
                    heading:
                      "Looking for Hard Inquiry Removal in Arizona or Phoenix?",
                    body: [
                      "Inquiry Removal serves Arizona consumers through the same nationwide remote process, including people in Phoenix and throughout the state. You can use the service without visiting an office, and the affected Experian, Equifax, and TransUnion reports determine the scope of the work.",
                    ],
                  },
                  section,
                ]
              : [section],
          ),
        }
      : rawPage.slug === "contact"
        ? {
            ...rawPage,
            description:
              "Contact Inquiry Removal by phone or online for a focused review of hard inquiries appearing on Experian, Equifax, or TransUnion.",
            sections: rawPage.sections.map((section) =>
              section.heading === "A direct human contact method."
                ? {
                    ...section,
                    heading: "Call or Request Your Free Inquiry Review Online.",
                    body: [
                      "Call Inquiry Removal or submit the free online inquiry review to discuss the inquiries on your credit reports and the circumstances surrounding them. Do not provide Social Security numbers, dates of birth, report logins, payment information, or other highly sensitive information during the initial conversation or public website form.",
                    ],
                  }
                : section,
            ),
          }
        : rawPage;

const pathname = `/${page.slug}/`;
const indexable = isIndexablePath(pathname);
const canonical = `${SITE_ORIGIN}${pathname}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${SITE_ORIGIN}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: page.title,
        item: canonical,
      },
    ],
  },
  ...(page.kind === "scenario"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "Service",
          name: page.title,
          description: page.description,
          serviceType: "Hard inquiry review and removal",
          provider: { "@id": `${SITE_ORIGIN}/#organization` },
          areaServed: { "@type": "Country", name: "United States" },
          url: canonical,
        },
      ]
    : []),
];
const resourceCards = [
  [
    "Fundamentals",
    "How to remove hard inquiries",
    "Understand which inquiries may deserve review and the complete removal process.",
    "/how-to-remove-hard-inquiries/",
  ],
  [
    "Dispute guide",
    "How to dispute a hard inquiry",
    "Build a specific, documented dispute instead of relying on a generic template.",
    "/how-to-dispute-a-hard-inquiry/",
  ],
  [
    "Timeline",
    "How long inquiries stay",
    "See the two-year reporting timeline and why visibility and score impact differ.",
    "/how-long-do-hard-inquiries-stay/",
  ],
  [
    "Experian",
    "Experian inquiry removal",
    "Review an Experian hard inquiry and understand the bureau-specific next step.",
    "/experian-hard-inquiry-removal/",
  ],
  [
    "Equifax",
    "Equifax inquiry removal",
    "Identify and review questionable inquiries appearing on an Equifax report.",
    "/equifax-hard-inquiry-removal/",
  ],
  [
    "TransUnion",
    "TransUnion inquiry removal",
    "Follow the inquiry-specific review path for a TransUnion report.",
    "/transunion-hard-inquiry-removal/",
  ],
];
---

{
  guide ? (
    <GuidePage page={guide} />
  ) : (
    <BaseLayout
      title={page.seoTitle ?? `${page.title} | Inquiry Removal`}
      description={page.description}
      robots={
        indexable
          ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
          : "noindex, follow, noarchive"
      }
      {schema}
      theme="dark"
    >
      <Header dark />
      <main id="main-content" tabindex="-1">
        <section class="page-hero">
          <div class="container page-hero-grid">
            <div>
              <p class="eyebrow eyebrow--light">
                <span />
                {page.eyebrow}
              </p>
              <h1>{page.title}</h1>
              <p>{page.description}</p>
            </div>
            <div class="page-hero-aside">
              {page.aside.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>
        </section>

        <section class="page-content">
          <div class="container content-shell">
            <aside class="content-index">
              <p>On this page</p>
              {page.sections.map((section, index) => (
                <a href={`#section-${index + 1}`}>
                  {String(index + 1).padStart(2, "0")} · {section.heading}
                </a>
              ))}

              {page.slug === "contact" && (
                <div class="process-crosslink" data-reveal>
                  <p class="eyebrow">
                    <span /> Speak with a specialist
                  </p>
                  <h2>Call or start online.</h2>
                  <p>
                    <a href="tel:+16023776626">Call Inquiry Removal</a> or use
                    the free online review to speak with a specialist about your
                    hard inquiries.
                  </p>
                </div>
              )}
              <a class="button button--small" href="/free-inquiry-review/">
                Free Review →
              </a>
              {page.kind === "scenario" && (
                <a class="scenario-back-link" href="/situations-we-handle/">
                  ← See every hard inquiry situation we handle
                </a>
              )}
            </aside>
            <div class="content-body">
              {page.sections.map((section, index) => (
                <section id={`section-${index + 1}`} data-reveal>
                  <p class="eyebrow">
                    <span /> {String(index + 1).padStart(2, "0")}
                  </p>
                  <h2>{section.heading}</h2>
                  {section.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {section.bullets && (
                    <ul>
                      {section.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                  {section.links && (
                    <div class="content-source-links">
                      {section.links.map((link) => (
                        <a
                          class="text-link"
                          href={link.href}
                          rel="external noopener"
                        >
                          {link.label} <span>↗</span>
                        </a>
                      ))}
                    </div>
                  )}
                </section>
              ))}

              {page.kind === "resources" && (
                <div class="resource-grid" data-reveal>
                  {resourceCards.map(([tag, title, text, href]) => (
                    <article class="resource-card">
                      <span>{tag}</span>
                      <h3>{title}</h3>
                      <p>{text}</p>
                      {href && (
                        <a class="text-link" href={href}>
                          Read the guide <span>→</span>
                        </a>
                      )}
                    </article>
                  ))}
                </div>
              )}

              {(page.kind === "scenario" ||
                page.slug === "results" ||
                page.slug === "faq" ||
                page.slug === "about") && (
                <div class="process-crosslink" data-reveal>
                  <p class="eyebrow">
                    <span /> From review to follow-through
                  </p>
                  <h2>Know what happens next.</h2>
                  <a class="text-link" href="/how-it-works/">
                    See How the Hard Inquiry Removal Process Works{" "}
                    <span>→</span>
                  </a>
                  <a class="text-link" href="/pricing/">
                    Compare Hard Inquiry Removal Pricing <span>→</span>
                  </a>
                  {(page.slug === "faq" || page.slug === "about") && (
                    <a class="text-link" href="/dealership-inquiries/">
                      Learn About Dealership Inquiry Removal <span>→</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </BaseLayout>
  )
}
