---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuidePage from "../components/GuidePage.astro";
import { pages, type SitePage } from "../data/pages";
import {
  guidePages,
  guideSlugs,
  type GuidePage as GuidePageData,
} from "../data/guides";
import { isIndexablePath, SITE_ORIGIN } from "../data/discovery.mjs";

export function getStaticPaths() {
  return [
    ...pages
      .filter((page) => !guideSlugs.has(page.slug))
      .map((page) => ({
        params: { slug: page.slug },
        props: { page },
      })),
    ...guidePages.map((guide) => ({
      params: { slug: guide.slug },
      props: { guide },
    })),
  ];
}

interface Props {
  page?: SitePage;
  guide?: GuidePageData;
}
const { guide } = Astro.props;
const page = Astro.props.page ?? pages[0];
const pathname = `/${page.slug}/`;
const indexable = isIndexablePath(pathname);
const canonical = `${SITE_ORIGIN}${pathname}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${SITE_ORIGIN}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: page.title,
        item: canonical,
      },
    ],
  },
  ...(page.kind === "scenario"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "Service",
          name: page.title,
          description: page.description,
          serviceType: "Hard inquiry review and removal",
          provider: { "@id": `${SITE_ORIGIN}/#organization` },
          areaServed: { "@type": "Country", name: "United States" },
          url: canonical,
        },
      ]
    : []),
];
const resourceCards = [
  [
    "Fundamentals",
    "How to remove hard inquiries",
    "Understand which inquiries may deserve review and the complete removal process.",
    "/how-to-remove-hard-inquiries/",
  ],
  [
    "Dispute guide",
    "How to dispute a hard inquiry",
    "Build a specific, documented dispute instead of relying on a generic template.",
    "/how-to-dispute-a-hard-inquiry/",
  ],
  [
    "Timeline",
    "How long inquiries stay",
    "See the two-year reporting timeline and why visibility and score impact differ.",
    "/how-long-do-hard-inquiries-stay/",
  ],
  [
    "Experian",
    "Experian inquiry removal",
    "Review an Experian hard inquiry and understand the bureau-specific next step.",
    "/experian-hard-inquiry-removal/",
  ],
  [
    "Equifax",
    "Equifax inquiry removal",
    "Identify and review questionable inquiries appearing on an Equifax report.",
    "/equifax-hard-inquiry-removal/",
  ],
  [
    "TransUnion",
    "TransUnion inquiry removal",
    "Follow the inquiry-specific review path for a TransUnion report.",
    "/transunion-hard-inquiry-removal/",
  ],
];
---

{
  guide ? (
    <GuidePage page={guide} />
  ) : (
    <BaseLayout
      title={page.seoTitle ?? `${page.title} | Inquiry Removal`}
      description={page.description}
      robots={
        indexable
          ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
          : "noindex, follow, noarchive"
      }
      {schema}
      theme="dark"
    >
      <Header dark />
      <main id="main-content" tabindex="-1">
        <section class="page-hero">
          <div class="container page-hero-grid">
            <div>
              <p class="eyebrow eyebrow--light">
                <span />
                {page.eyebrow}
              </p>
              <h1>{page.title}</h1>
              <p>{page.description}</p>
            </div>
            <div class="page-hero-aside">
              {page.aside.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>
        </section>

        <section class="page-content">
          <div class="container content-shell">
            <aside class="content-index">
              <p>On this page</p>
              {page.sections.map((section, index) => (
                <a href={`#section-${index + 1}`}>
                  {String(index + 1).padStart(2, "0")} · {section.heading}
                </a>
              ))}

              {page.slug === "contact" && (
                <div class="process-crosslink" data-reveal>
                  <p class="eyebrow">
                    <span /> Speak with a specialist
                  </p>
                  <h2>Call Inquiry Removal.</h2>
                  <p>
                    <a href="tel:+16023776626">Call Inquiry Removal</a> to speak
                    with a specialist about a hard inquiry review.
                  </p>
                </div>
              )}
              <a class="button button--small" href="/free-inquiry-review/">
                Free Review →
              </a>
              {page.kind === "scenario" && (
                <a class="scenario-back-link" href="/situations-we-handle/">
                  ← See every hard inquiry situation we handle
                </a>
              )}
            </aside>
            <div class="content-body">
              {page.sections.map((section, index) => (
                <section id={`section-${index + 1}`} data-reveal>
                  <p class="eyebrow">
                    <span /> {String(index + 1).padStart(2, "0")}
                  </p>
                  <h2>{section.heading}</h2>
                  {section.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {section.bullets && (
                    <ul>
                      {section.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                  {section.links && (
                    <div class="content-source-links">
                      {section.links.map((link) => (
                        <a
                          class="text-link"
                          href={link.href}
                          rel="external noopener"
                        >
                          {link.label} <span>↗</span>
                        </a>
                      ))}
                    </div>
                  )}
                </section>
              ))}

              {page.kind === "resources" && (
                <div class="resource-grid" data-reveal>
                  {resourceCards.map(([tag, title, text, href]) => (
                    <article class="resource-card">
                      <span>{tag}</span>
                      <h3>{title}</h3>
                      <p>{text}</p>
                      {href && (
                        <a class="text-link" href={href}>
                          Read the guide <span>→</span>
                        </a>
                      )}
                    </article>
                  ))}
                </div>
              )}

              {(page.kind === "scenario" ||
                page.slug === "results" ||
                page.slug === "faq" ||
                page.slug === "about") && (
                <div class="process-crosslink" data-reveal>
                  <p class="eyebrow">
                    <span /> From review to follow-through
                  </p>
                  <h2>Know what happens next.</h2>
                  <a class="text-link" href="/how-it-works/">
                    See How the Hard Inquiry Removal Process Works{" "}
                    <span>→</span>
                  </a>
                  <a class="text-link" href="/pricing/">
                    Compare Hard Inquiry Removal Pricing <span>→</span>
                  </a>
                  {(page.slug === "faq" || page.slug === "about") && (
                    <a class="text-link" href="/dealership-inquiries/">
                      Learn About Dealership Inquiry Removal <span>→</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </BaseLayout>
  )
}
