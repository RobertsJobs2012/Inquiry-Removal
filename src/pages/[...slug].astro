---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import GuidePage from "../components/GuidePage.astro";
import { pages, type SitePage } from "../data/pages";
import {
  guidePages,
  guideSlugs,
  type GuidePage as GuidePageData,
} from "../data/guides";
import { isIndexablePath, SITE_ORIGIN } from "../data/discovery.mjs";
import { batchGuidePages, batchGuideSlugs } from "../data/batchGuides";
import { resourceHubGroups } from "../data/resourceHub";

export function getStaticPaths() {
  const allGuidePages = [
    ...guidePages.filter((page) => !batchGuideSlugs.has(page.slug)),
    ...batchGuidePages,
  ];
  const allGuideSlugs = new Set([...guideSlugs, ...batchGuideSlugs]);

  return [
    ...pages
      .filter((page) => !allGuideSlugs.has(page.slug))
      .map((page) => ({
        params: { slug: page.slug },
        props: { page },
      })),
    ...allGuidePages.map((guide) => ({
      params: { slug: guide.slug },
      props: { guide },
    })),
  ];
}

interface Props {
  page?: SitePage;
  guide?: GuidePageData;
}

const guide: GuidePageData | undefined = Astro.props.guide;
const rawPage = Astro.props.page ?? pages[0];

const page: SitePage =
  rawPage.slug === "faq"
    ? {
        ...rawPage,
        sections: rawPage.sections.flatMap((section) =>
          section.heading === "How Quickly Can Hard Inquiries Be Removed?"
            ? [
                section,
                {
                  heading: "Can Hard Inquiries Be Removed in 24 Hours?",
                  body: [
                    "A 24-hour removal should not be promised or expected. Some inquiry removals can happen quickly, but Inquiry Removal tells clients that the process may take longer because creditors and credit bureaus respond on different schedules. Our earliest published timing is as little as seven days, not 24 hours.",
                  ],
                },
                {
                  heading: "What Happens When a Hard Inquiry Is Removed?",
                  body: [
                    "When a hard inquiry is removed, the entry should no longer appear on the affected credit report after the update is processed. That does not guarantee a particular score increase or approval because credit decisions and scores consider the rest of the credit profile as well.",
                  ],
                },
              ]
            : [section],
        ),
      }
    : rawPage.slug === "areas-we-serve"
      ? {
          ...rawPage,
          sections: rawPage.sections.flatMap((section) =>
            section.heading === "Ready to Start Removing Your Hard Inquiries?"
              ? [
                  {
                    heading:
                      "Looking for Hard Inquiry Removal in Arizona or Phoenix?",
                    body: [
                      "Inquiry Removal serves Arizona consumers through the same nationwide remote process, including people in Phoenix and throughout the state. You can use the service without visiting an office, and the affected Experian, Equifax, and TransUnion reports determine the scope of the work.",
                    ],
                  },
                  section,
                ]
              : [section],
          ),
        }
      : rawPage.slug === "contact"
        ? {
            ...rawPage,
            description:
              "Contact Inquiry Removal by phone or online for a focused review of hard inquiries appearing on Experian, Equifax, or TransUnion.",
            sections: rawPage.sections.map((section) =>
              section.heading === "A direct human contact method."
                ? {
                    ...section,
                    heading: "Call or Request Your Free Inquiry Review Online.",
                    body: [
                      "Call Inquiry Removal or submit the free online inquiry review to discuss the inquiries on your credit reports and the circumstances surrounding them. Do not provide Social Security numbers, dates of birth, report logins, payment information, or other highly sensitive information during the initial conversation or public website form.",
                    ],
                  }
                : section,
            ),
          }
        : rawPage;

const pathname = `/${page.slug}/`;
const indexable = isIndexablePath(pathname);
const canonical = `${SITE_ORIGIN}${pathname}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${SITE_ORIGIN}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: page.title,
        item: canonical,
      },
    ],
  },
  ...(page.kind === "scenario"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "Service",
          name: page.title,
          description: page.description,
          serviceType: "Hard inquiry review and removal",
          provider: { "@id": `${SITE_ORIGIN}/#organization` },
          areaServed: { "@type": "Country", name: "United States" },
          url: canonical,
        },
      ]
    : []),
];
---

{
  guide ? (
    <GuidePage page={guide} />
  ) : (
    <BaseLayout
      title={page.seoTitle ?? `${page.title} | Inquiry Removal`}
      description={page.description}
      robots={
        indexable
          ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
          : "noindex, follow, noarchive"
      }
      {schema}
      theme="dark"
    >
      <Header dark />
      <main id="main-content" tabindex="-1">
        <section class="page-hero">
          <div class="container page-hero-grid">
            <div>
              <p class="eyebrow eyebrow--light">
                <span />
                {page.eyebrow}
              </p>
              <h1>{page.title}</h1>
              <p>{page.description}</p>
            </div>
            <div class="page-hero-aside">
              {page.aside.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>
        </section>

        <section class="page-content">
          <div class="container content-shell">
            <aside class="content-index">
              <p>On this page</p>
              {page.sections.map((section, index) => (
                <a href={`#section-${index + 1}`}>
                  {String(index + 1).padStart(2, "0")} · {section.heading}
                </a>
              ))}

              {page.slug === "contact" && (
                <div class="process-crosslink" data-reveal>
                  <p class="eyebrow">
                    <span /> Speak with a specialist
                  </p>
                  <h2>Call or start online.</h2>
                  <p>
                    <a href="tel:+16023776626">Call Inquiry Removal</a> or use
                    the free online review to speak with a specialist about your
                    hard inquiries.
                  </p>
                </div>
              )}
              <a class="button button--small" href="/free-inquiry-review/">
                Free Review →
              </a>
              {page.kind === "scenario" && (
                <a class="scenario-back-link" href="/situations-we-handle/">
                  ← See every hard inquiry situation we handle
                </a>
              )}
            </aside>
            <div class="content-body">
              {page.sections.map((section, index) => (
                <section id={`section-${index + 1}`} data-reveal>
                  <p class="eyebrow">
                    <span /> {String(index + 1).padStart(2, "0")}
                  </p>
                  <h2>{section.heading}</h2>
                  {section.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  {section.bullets && (
                    <ul>
                      {section.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                  )}
                  {section.links && (
                    <div class="content-source-links">
                      {section.links.map((link) => (
                        <a
                          class="text-link"
                          href={link.href}
                          rel="external noopener"
                        >
                          {link.label} <span>↗</span>
                        </a>
                      ))}
                    </div>
                  )}
                </section>
              ))}

              {page.kind === "resources" && (
                <div class="resource-hub">
                  {resourceHubGroups.map((group, groupIndex) => (
                    <section
                      class="resource-hub__group"
                      aria-labelledby={`resource-group-${groupIndex + 1}`}
                      data-reveal
                    >
                      <div class="resource-hub__heading">
                        <p class="eyebrow">
                          <span /> Guide cluster {String(groupIndex + 1).padStart(2, "0")}
                        </p>
                        <h2 id={`resource-group-${groupIndex + 1}`}>{group.title}</h2>
                        <p>{group.description}</p>
                      </div>
                      <div class="resource-grid">
                        {group.cards.map((card) => (
                          <article class="resource-card">
                            <span>{card.tag}</span>
                            <h3>{card.title}</h3>
                            <p>{card.description}</p>
                            <a class="text-link" href={card.href}>
                              Read the guide <span>→</span>
                            </a>
                          </article>
                        ))}
                      </div>
                    </section>
                  ))}
                </div>
              )}

              {(page.kind === "scenario" ||
                page.slug === "results" ||
                page.slug === "faq" ||
                page.slug === "about") && (
                <div class="process-crosslink" data-reveal>
                  <p class="eyebrow">
                    <span /> From review to follow-through
                  </p>
                  <h2>Know what happens next.</h2>
                  <a class="text-link" href="/how-it-works/">
                    See How the Hard Inquiry Removal Process Works{" "}
                    <span>→</span>
                  </a>
                  <a class="text-link" href="/pricing/">
                    Compare Hard Inquiry Removal Pricing <span>→</span>
                  </a>
                  {(page.slug === "faq" || page.slug === "about") && (
                    <a class="text-link" href="/dealership-inquiries/">
                      Learn About Dealership Inquiry Removal <span>→</span>
                    </a>
                  )}
                </div>
              )}
            </div>
          </div>
        </section>
      </main>
      <Footer />
    </BaseLayout>
  )
}

<style>
  .resource-hub {
    display: grid;
    gap: 76px;
    margin-top: 72px;
  }

  .resource-hub__group {
    scroll-margin-top: 110px;
  }

  .resource-hub__heading {
    max-width: 780px;
    margin-bottom: 26px;
  }

  .resource-hub__heading h2 {
    margin: 10px 0 14px;
    font-size: clamp(2rem, 4vw, 3.35rem);
  }

  .resource-hub__heading > p:last-child {
    max-width: 720px;
    color: var(--slate);
  }

  .resource-hub .resource-card {
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .resource-hub .resource-card h3 {
    font-size: 1.35rem;
  }

  .resource-hub .resource-card .text-link {
    margin-top: auto;
    padding-top: 12px;
  }

  @media (max-width: 720px) {
    .resource-hub {
      gap: 54px;
      margin-top: 52px;
    }
  }
</style>
