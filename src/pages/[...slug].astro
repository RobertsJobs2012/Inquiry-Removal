---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { pages, type SitePage } from "../data/pages";
import { isIndexablePath, SITE_ORIGIN } from "../data/discovery.mjs";

export function getStaticPaths() {
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: SitePage;
}
const { page } = Astro.props;
const pathname = `/${page.slug}/`;
const indexable = isIndexablePath(pathname);
const canonical = `${SITE_ORIGIN}${pathname}`;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: `${SITE_ORIGIN}/`,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: page.title,
        item: canonical,
      },
    ],
  },
  ...(page.kind === "scenario"
    ? [
        {
          "@context": "https://schema.org",
          "@type": "Service",
          name: page.title,
          description: page.description,
          serviceType: "Hard inquiry review and removal",
          provider: { "@id": `${SITE_ORIGIN}/#organization` },
          areaServed: { "@type": "Country", name: "United States" },
          url: canonical,
        },
      ]
    : []),
];
const resourceCards = [
  [
    "Fundamentals",
    "Hard vs. soft inquiries",
    "Understand what each type of credit inquiry means and when it appears.",
  ],
  [
    "Dealerships",
    "One application, many lenders",
    "Learn how application routing can result in several reported inquiries.",
  ],
  [
    "Authorization",
    "When you do not recognize a pull",
    "Organize the facts before deciding whether closer review is appropriate.",
  ],
  [
    "Identity theft",
    "Unknown activity on your report",
    "Understand why unfamiliar inquiries can require a broader response.",
  ],
  [
    "Credit bureaus",
    "Experian, Equifax & TransUnion",
    "Read inquiry information across all three major credit reports.",
  ],
  [
    "Consumer rights",
    "Doing it yourself",
    "Learn how consumers can dispute inaccurate credit-report information directly.",
  ],
];
---

<BaseLayout
  title={page.seoTitle ?? `${page.title} | Inquiry Removal`}
  description={page.description}
  robots={indexable
    ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    : "noindex, follow, noarchive"}
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="page-hero">
      <div class="container page-hero-grid">
        <div>
          <p class="eyebrow eyebrow--light"><span></span>{page.eyebrow}</p>
          <h1>{page.title}</h1>
          <p>{page.description}</p>
        </div>
        <div class="page-hero-aside">
          {page.aside.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </section>

    <section class="page-content">
      <div class="container content-shell">
        <aside class="content-index">
          <p>On this page</p>
          {
            page.sections.map((section, index) => (
              <a href={`#section-${index + 1}`}>
                {String(index + 1).padStart(2, "0")} · {section.heading}
              </a>
            ))
          }

          {
            page.slug === "contact" && (
              <div class="process-crosslink" data-reveal>
                <p class="eyebrow">
                  <span /> Speak with a specialist
                </p>
                <h2>Call Inquiry Removal.</h2>
                <p>
                  Call <a href="tel:+16023776626">(602) 377-6626</a> to speak
                  with Inquiry Removal about a hard inquiry review.
                </p>
              </div>
            )
          }
          <a class="button button--small" href="/free-inquiry-analysis/"
            >Free Review →</a
          >
          {
            page.kind === "scenario" && (
              <a class="scenario-back-link" href="/situations-we-handle/">
                ← See every hard inquiry situation we handle
              </a>
            )
          }
        </aside>
        <div class="content-body">
          {
            page.kind === "analysis" && (
              <div class="analysis-panel">
                <div>
                  <p class="eyebrow">
                    <span /> Secure intake preview
                  </p>
                  <h2>Tell us what you’re seeing.</h2>
                  <p>
                    The intake experience is designed, but submission is
                    intentionally disabled until secure storage, consent
                    language, and the service workflow are finalized.
                  </p>
                </div>
                <form class="analysis-form" onsubmit="return false">
                  <div class="field">
                    <>
                      <label for="name">Full name</label>
                      <input
                        id="name"
                        name="name"
                        autocomplete="name"
                        placeholder="Your name"
                      />
                    </>
                  </div>
                  <div class="field">
                    <>
                      <label for="phone">Phone</label>
                      <input
                        id="phone"
                        name="phone"
                        autocomplete="tel"
                        inputmode="tel"
                        placeholder="(000) 000-0000"
                      />
                    </>
                  </div>
                  <div class="field field--full">
                    <>
                      <label for="email">Email</label>
                      <input
                        id="email"
                        name="email"
                        type="email"
                        autocomplete="email"
                        placeholder="you@example.com"
                      />
                    </>
                  </div>
                  <div class="field">
                    <>
                      <label for="situation">Situation</label>
                      <select id="situation" name="situation">
                        <>
                          <option>Choose one</option>
                          <option>Dealership inquiries</option>
                          <option>Unknown inquiries</option>
                          <option>Identity theft</option>
                          <option>Preparing for financing</option>
                          <option>Not sure</option>
                        </>
                      </select>
                    </>
                  </div>
                  <div class="field">
                    <>
                      <label for="count">Approximate inquiry count</label>
                      <select id="count" name="count">
                        <>
                          <option>Not sure</option>
                          <option>1–10</option>
                          <option>11–30</option>
                          <option>31+</option>
                        </>
                      </select>
                    </>
                  </div>
                  <div class="field field--full">
                    <>
                      <label for="notes">What would you like us to know?</label>
                      <textarea
                        id="notes"
                        name="notes"
                        placeholder="Do not enter Social Security numbers or other highly sensitive information."
                      />
                    </>
                  </div>
                  <button
                    class="button field--full"
                    type="button"
                    disabled
                    aria-describedby="form-note"
                  >
                    Secure submission coming before launch
                  </button>
                  <p class="form-note" id="form-note">
                    This preview does not transmit or store information.
                  </p>
                  <a
                    class="form-call-fallback field--full"
                    href="tel:+16023776626"
                  >
                    Prefer to speak now? Call (602) 377-6626.
                  </a>
                </form>
              </div>
            )
          }

          {
            page.sections.map((section, index) => (
              <section id={`section-${index + 1}`} data-reveal>
                <p class="eyebrow">
                  <span /> {String(index + 1).padStart(2, "0")}
                </p>
                <h2>{section.heading}</h2>
                {section.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {section.bullets && (
                  <ul>
                    {section.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }

          {
            page.kind === "resources" && (
              <div class="resource-grid" data-reveal>
                {resourceCards.map(([tag, title, text]) => (
                  <article class="resource-card">
                    <span>{tag}</span>
                    <h3>{title}</h3>
                    <p>{text}</p>
                  </article>
                ))}
              </div>
            )
          }

          {
            (page.kind === "scenario" ||
              page.slug === "results" ||
              page.slug === "faq" ||
              page.slug === "about") && (
              <div class="process-crosslink" data-reveal>
                <p class="eyebrow">
                  <span /> From review to follow-through
                </p>
                <h2>Know what happens next.</h2>
                <a class="text-link" href="/how-it-works/">
                  See How the Hard Inquiry Removal Process Works <span>→</span>
                </a>
                <a class="text-link" href="/pricing/">
                  Compare Hard Inquiry Removal Pricing <span>→</span>
                </a>
                {(page.slug === "faq" || page.slug === "about") && (
                  <a class="text-link" href="/dealership-inquiries/">
                    Learn About Dealership Inquiry Removal <span>→</span>
                  </a>
                )}
              </div>
            )
          }

          <div class="placeholder-panel" data-reveal>
            <strong>Content phase ready.</strong>
            <p>
              The layout, hierarchy, conversion pathway, and compliance-safe
              placeholder language are in place. Final content can now replace
              these sections without redesigning the site.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
