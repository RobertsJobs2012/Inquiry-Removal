---
import { editorialPlan } from "../data/editorial";
import PracticalContent from "../components/PracticalContent.astro";
const revision = editorialPlan["/how-it-works/"];
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import InquiryLine from "../components/InquiryLine.astro";
import PhoneReviewPanel from "../components/PhoneReviewPanel.astro";
import PageJumpNav from "../components/PageJumpNav.astro";

const heroStages = [
  "Start with a free review",
  "Confirm the inquiry list",
  "Send supported disputes",
  "Explain the responses",
  "Check what changed",
];

const reviewTopics = [
  "The entry that caught your attention",
  "The company and date shown on the report",
  "Any application or rate check you remember",
  "Which reports show the inquiry",
  "What looks wrong or is still unclear",
  "Any dispute you’ve already tried and the response you received",
  "Any upcoming application or deadline",
];

const preparation = [
  [
    "Your affected credit reports",
    "Current reports allow us to record the inquiry name, date, bureau, and surrounding information exactly as it appears. A credit-monitoring summary may help with the first conversation, but full affected reports provide the clearest starting point.",
  ],
  [
    "What you remember",
    "A dealership visit, rate check or application date can help explain a company name you don’t recognize. Tell us where the report and your records don’t match.",
  ],
  [
    "Any supporting information you already have",
    "Useful information may include application emails, dealership paperwork, lender messages, identity-theft documentation, screenshots, credit-monitoring alerts, or notes about who you spoke with. Do not worry if you do not have everything.",
  ],
  [
    "A signed service agreement",
    "If you decide to hire us, review the written scope, price, payment terms and cancellation rights before signing. Requesting a free review does not sign you up.",
  ],
];

const steps = [
  [
    "Build the inquiry list",
    "We record the company, date and bureau for each inquiry in scope. If several entries trace back to one application, we note that relationship.",
    "Provide the affected reports and explain what happened.",
    "Record the entries and the events behind them.",
  ],
  [
    "Identify what the facts support",
    "An unfamiliar name may turn out to be a lender you authorized. A mismatched date, duplicate entry or application you didn’t make calls for a different next step.",
    "Answer any questions needed to clarify the events.",
    "Separate entries that warrant a dispute from those that don’t.",
  ],
  [
    "Prepare the supported disputes",
    "We identify the exact entry, explain what doesn’t match and use the relevant information you’ve provided. The dispute reflects your situation, not a generic reason.",
    "Review or provide any additional requested information.",
    "Write the dispute and identify the appropriate recipient.",
  ],
  [
    "Send the disputes",
    "We submit the communications to the companies or bureaus involved and track what was sent.",
    "Watch for responses or changes.",
    "Keep track of the submissions.",
  ],
  [
    "Make sense of the responses",
    "A bureau or company may contact you directly. Tell us when a response arrives, even if it says the entry stayed the same.",
    "Forward or describe each response promptly.",
    "Explain the response and whether we need more information.",
  ],
  [
    "Verify changes and follow up",
    "We compare the original list with the responses and updated reports. If the facts support another step, we continue as needed under your agreement.",
    "Keep us informed about new alerts and updated reports.",
    "Record confirmed changes and handle appropriate follow-up.",
  ],
];

const updates = [
  [
    "You choose how we contact you",
    "Choose phone or email on the review form. If you hire us, we can discuss whether phone, text or email works best for ongoing updates.",
  ],
  [
    "You tell us when notifications arrive",
    "Credit bureaus and monitoring services may contact you directly. When an app alert, email, website update, or mailed response arrives, send it to us or let us know what it says.",
  ],
  [
    "We explain what every response means",
    "You should not have to guess whether a letter is good news, a request, or a denial. We review the response, explain the result in plain language, and tell you the next step.",
  ],
  [
    "Tell us if your plans change",
    "If a lender gives you a deadline or asks about a specific entry, let us know. We’ll explain what the information means for your inquiry work without promising a lender decision.",
  ],
];

const timing = [
  [
    "Early removals",
    "Some individual entries change early. An app alert is a signal to check, not confirmation that all the inquiries are resolved.",
  ],
  [
    "Standard processing time",
    "When several companies or bureaus are involved, you may get separate responses at different times.",
  ],
  [
    "Additional rounds",
    "A reply may ask for evidence or leave an entry unchanged. We explain whether there’s a factual basis for follow-up under your agreement.",
  ],
  [
    "Rare extended cases",
    "Conflicting records, additional documentation or delayed responses can extend the work. Tell us about an upcoming application before you make plans around a possible change.",
  ],
];

const faqs = [
  [
    "Do I have to send the disputes myself?",
    "No. Inquiry Removal prepares and sends the dispute communications for you. Your role is to provide accurate information and affected credit reports, then notify us whenever you receive an app alert, email, online decision, or mailed response related to the inquiries.",
  ],
  [
    "Do I need reports from all three credit bureaus?",
    "You need current reports from every bureau affected by the inquiries you want removed. If inquiries appear on Experian, Equifax, and TransUnion, provide all three. If only one or two reports are affected, we begin with those reports.",
  ],
  [
    "What if I do not know how many inquiries I have?",
    "You can still request a free review. Tell the specialist what led you to contact us, and we will help you identify the inquiry count after reviewing the affected credit reports.",
  ],
  [
    "What happens when I receive a bureau response?",
    "Contact us and send the response or describe the notification. We compare it with the original inquiry list, verify what changed, explain the outcome, and determine whether the inquiry is complete or requires another follow-up step.",
  ],
  [
    "What if the first round does not remove every inquiry?",
    "We review the responses and continue with additional removal rounds as needed under your service agreement. Inquiry Removal does not treat the service as a one-letter transaction or stop automatically after the first response cycle.",
  ],
  [
    "How do I begin the process?",
    "Request a free review online or call us. A specialist will discuss the affected reports and help you decide what to do next. You don’t have to choose a plan to get started.",
  ],
  [
    "How will I know when an inquiry has been removed?",
    "You may receive a credit-monitoring alert, updated report, bureau investigation result, or creditor communication. Send the update to us so we can confirm which inquiry changed, record the removal, and review whether anything else remains.",
  ],
  [
    "Is there a monthly fee while the process continues?",
    "No. Inquiry Removal uses one-time pricing based on the total number of hard inquiries included in the service. The process does not become a monthly membership simply because some responses take longer than others.",
  ],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hard Inquiry Removal Process",
    provider: {
      "@id": "https://www.inquiryremoval.com/#organization",
    },
    areaServed: "US",
    serviceType:
      "Hard inquiry removal across Experian, Equifax, and TransUnion",
    url: "https://www.inquiryremoval.com/how-it-works/",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.inquiryremoval.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "How It Works",
        item: "https://www.inquiryremoval.com/how-it-works/",
      },
    ],
  },
];
---

<BaseLayout
  title="Hard Inquiry Removal Process: How It Works | Inquiry Removal"
  description="See how hard inquiry removal works from your free review through disputes, responses, removals, and follow-up across all three credit bureaus."
  ogTitle="How Hard Inquiry Removal Works From Start to Finish"
  ogDescription="See the complete Inquiry Removal process, from your free personal review through bureau responses, removals, and continued follow-up."
  ogImage="/og-how-it-works.jpg"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="how-hero dark-section">
      <div class="container how-hero__content" data-reveal>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>How It Works</span>
        </nav>
        <p class="eyebrow eyebrow--light">
          <span></span> Your role and ours
        </p>
        <h1>{revision.title}</h1>
        <p class="hero-summary">{revision.supporting}</p>
        <div class="button-row">
          <a class="button" href="/free-inquiry-review/#online-review">
            {revision.primaryCta} <span>→</span>
          </a>
          <a class="text-link text-link--light" href="#free-review">
            Prefer to Call? <span>↘</span>
          </a>
        </div>
        <p class="cta-microcopy">
          You don’t need an exact inquiry count or a plan to start.
        </p>
      </div>
      <div
        class="container hero-process-strip"
        aria-label="Inquiry removal process"
      >
        {heroStages.map((stage, index) => (
          <div>
            <>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <strong>{stage}</strong>
            </>
          </div>
        ))}
      </div>
    </section>

    <section class="trust-ribbon" aria-label="Company proof">
      <div class="container trust-grid">
        <div>
          <strong>100,437</strong>
          <span>Inquiries removed</span>
        </div>
        <div>
          <strong>1,123</strong>
          <span>Clients served</span>
        </div>
        <div>
          <strong>Since 2015</strong>
          <span>Focused credit experience</span>
        </div>
        <div>
          <strong>All three</strong>
          <span>Major credit bureaus</span>
        </div>
      </div>
      <p class="entity-declaration container">
        Company-reported totals. Individual results vary.
      </p>
    </section>

    <PageJumpNav
      items={[
        ["Free review", "#review"],
        ["Preparation", "#preparation"],
        ["Full process", "#full-process"],
        ["Updates", "#updates"],
        ["Timing", "#timing"],
        ["Questions", "#how-questions"],
      ]}
    />

    <PracticalContent slug="how-it-works" />
    <section class="section review-section" id="review">
      <div class="container review-layout">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> Your first conversation
          </p>
          <h2>What Happens During Your Free Inquiry Review?</h2>
          <p class="lead">
            The free review starts with what you remember and what the report
            shows. We’ll help you tell the difference between an entry you can
            explain, one you need to identify and one that warrants a dispute.
          </p>
          <p>
            Request your review online or call. Bring whatever you already
            know. We can help with the count and the unfamiliar names.
          </p>
          <a class="text-link" href="/situations-we-handle/">
            See the Hard Inquiry Situations We Handle <span>→</span>
          </a>
        </div>
        <div class="review-topic-grid" data-reveal>
          {reviewTopics.map((topic, index) => (
            <div>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{topic}</strong>
              </>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section preparation-section" id="preparation">
      <div class="container">
        <div class="section-heading centered-heading" data-reveal>
          <p class="eyebrow centered">
            <span></span> Simple expectations
          </p>
          <h2>What to Have Ready if You Decide to Hire Us</h2>
          <p>
            For the initial review, an estimate is enough. Before service
            begins, we’ll need current copies of the reports that show the
            inquiries in scope. We’ll explain what to provide and how.
          </p>
        </div>
        <div class="preparation-grid" data-reveal>
          {preparation.map(([title, body], index) => (
            <article>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
        <p class="secure-note">
          <strong>Protect sensitive information:</strong> Do not send Social
          Security numbers, birth dates, bureau passwords, payment information,
          or full credit reports through the review form. You don’t need them
          for the initial conversation either.
        </p>
      </div>
    </section>

    <section
      class="section full-process-section dark-section"
      id="full-process"
    >
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow eyebrow--light">
              <span></span> The complete process
            </p>
            <h2>What We Handle if You Hire Us</h2>
          </div>
          <p>
            Once we agree on the scope, here’s what we do and where we need
            your help. You’ll know who’s responsible for the next step at each
            stage.
          </p>
        </div>
        <div class="process-timeline" data-reveal>
          {steps.map(([title, body, client, team], index) => (
            <article>
              <>
                <div class="timeline-node">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                </div>
                <div>
                  <>
                    <p class="process-stage">Step {index + 1}</p>
                    <h3>{title}</h3>
                    <p>{body}</p>
                    <div class="responsibility-grid">
                      <>
                        <p>
                          <strong>What you do</strong>
                          {client}
                        </p>
                        <p>
                          <strong>What we do</strong>
                          {team}
                        </p>
                      </>
                    </div>
                  </>
                </div>
              </>
            </article>
          ))}
        </div>
        <div class="section-cta section-cta--dark">
          <a class="button" href="/free-inquiry-review/#online-review">
            {revision.primaryCta} <span>→</span>
          </a>
          <p>
            A review request is not a service agreement.
          </p>
        </div>
      </div>
    </section>

    <section class="section updates-section" id="updates">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> Personal communication
            </p>
            <h2>Get Updates by Phone, Text or Email</h2>
          </div>
          <p>
            There’s no client portal to check. When you receive a bureau or
            lender response, let us know. We’ll explain what it says and what,
            if anything, needs to happen next.
          </p>
        </div>
        <div class="updates-grid" data-reveal>
          {updates.map(([title, body], index) => (
            <article>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section timing-section" id="timing">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> Timing and follow-through
            </p>
            <h2>How Long Can Hard Inquiry Removal Take?</h2>
          </div>
          <p>
            In our experience, some individual removals have appeared within
            seven days. Many cases take up to 90 days, and unusual cases can
            take 120 days or longer. Those are examples, not a deadline for
            your case.
          </p>
        </div>
        <div class="timing-track" data-reveal>
          {timing.map(([title, body], index) => (
            <article>
              <>
                <span>
                  {["Early changes", "Responses", "Follow-up", "Delays"][index]}
                </span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
        <p class="timing-disclosure">
          No particular removal, completion date, score change or lending
          decision is guaranteed.
        </p>
        <a class="text-link" href="/pricing/">
          Compare Hard Inquiry Removal Pricing <span>→</span>
        </a>
        <a
          class="text-link process-adjacent-link"
          href="/dealership-inquiries/"
        >
          Learn About Dealership Inquiry Removal <span>→</span>
        </a>
      </div>
    </section>

    <section class="section faq-section" id="how-questions">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> Questions, answered
          </p>
          <h2>Questions About the Inquiry Removal Process</h2>
          <p>
            Clear answers about reports, disputes, responses, follow-up, timing,
            and pricing.
          </p>
          <a class="text-link" href="/faq/">
            View All Hard Inquiry Removal Questions <span>→</span>
          </a>
        </div>
        <div class="faq-list" data-reveal>
          {faqs.map(([question, answer], index) => (
            <details open={index === 0}>
              <>
                <summary>
                  {question}
                  <span />
                </summary>
                <p>{answer}</p>
              </>
            </details>
          ))}
        </div>
      </div>
    </section>

    <PhoneReviewPanel
      title="Talk through an inquiry with a specialist"
      description="Tell us what you’re seeing, even if you don’t have every report. We’ll explain the next step and what we can handle if you decide to hire us."
    />

    <section class="final-cta dark-section">
      <div class="final-lines" aria-hidden="true">
        <InquiryLine compact />
      </div>
      <div class="container final-content" data-reveal>
        <p class="eyebrow eyebrow--light centered">
          <span></span> A safe first step
        </p>
        <h2>Start With the Inquiry You’re Unsure About</h2>
        <p>
          Tell us what doesn’t match. We’ll help you decide whether it’s worth
          pursuing, whether you’d rather handle it yourself and what we can do
          if you want help.
        </p>
        <div class="button-row button-row--center">
          <a class="button button--large" href="/free-inquiry-review/#online-review">
            {revision.primaryCta} <span>→</span>
          </a>
          <a class="text-link text-link--light" href="/pricing/">
            See One-Time Pricing <span>→</span>
          </a>
        </div>
        <p class="cta-microcopy">
          No payment or plan selection is required to request a review.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
