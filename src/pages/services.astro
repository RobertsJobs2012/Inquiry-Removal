---
import BaseLayout from "../layouts/BaseLayout.astro";
import { packagePages } from "@/lib/package-pages";
import { packageSchemas } from "@/lib/package-schemas";
import { servicesPageSchema } from "@/lib/schema";
import AnnouncementBar from "@/src/components/AnnouncementBar.astro";
import Footer from "@/src/components/Footer.astro";
import Navigation from "@/src/components/Navigation.astro";
import PageHero from "@/src/components/PageHero.astro";
import PremiumIcon from "@/src/components/PremiumIcon.astro";
import ServicesPlanner from "@/src/components/ServicesPlanner.astro";

const TRUST_STATS = [
  { value: "11 Years", label: "Specialized in Inquiry Removal Only" },
  { value: "1,123 Clients", label: "Helped Nationwide" },
  { value: "Review First", label: "We Evaluate Fit Before Taking a Case" },
];

const PRESS_LOGOS = ["Forbes", "Bloomberg", "CNBC", "Business Insider", "MarketWatch"];

const metadata = {
  title: {
    absolute: "Hard Inquiry Removal Services & Pricing",
  },
  description:
    "Remove 1 inquiry or 100 — we have a flat-fee plan built for your situation. Free consultation. Custom disputes. All 3 bureaus. 100% money-back guarantee.",
  alternates: {
    canonical: "/services",
  },
  openGraph: {
    title: "Hard Inquiry Removal Services & Pricing | Inquiry Removal",
    description:
      "Remove 1 inquiry or 100 — we have a flat-fee plan built for your situation. Free consultation. Custom disputes. All 3 bureaus. 100% money-back guarantee.",
    url: "https://www.inquiryremoval.com/services",
  },
  twitter: {
    title: "Hard Inquiry Removal Services & Pricing | Inquiry Removal",
    description:
      "Remove 1 inquiry or 100 — we have a flat-fee plan built for your situation. Free consultation. Custom disputes. All 3 bureaus.",
  },
};

const meta = metadata as any;
import "../styles/pages/services.css";

void meta;
void servicesPageSchema;
const packageMeta = packagePages["/services"];
---


<BaseLayout
  title={packageMeta.title}
  description={packageMeta.description}
  canonicalPath={packageMeta.route}
  ogImage={packageMeta.ogImage}
  ogImageType="image/webp"
  ogImageAlt={`${packageMeta.h1} — Inquiry Removal`}
  schema={packageSchemas["/services"]}
  pathname={packageMeta.route}
>

  <AnnouncementBar />
        <Navigation activePath="/services" />
        <main id="main" class="services-page">
          <PageHero
            id="services-hero-heading"
          >
      <Fragment slot="title">
        <span class="ir-gradient-text">Hard Inquiry Removal Plans</span> — Flat Fee, Built for Your Inquiry Count
      </Fragment>
      <Fragment slot="subtitle">
        <p>
                Every credit report is different. Every situation is different. That&apos;s why we built three flat-fee plans based on your total inquiry count — so you only pay for what you actually need, and you get the same white-glove service regardless of which tier you&apos;re in.
              </p>
      </Fragment>
      <Fragment slot="meta">
        <span>
                  <PremiumIcon name="checkBadge" size={16} strokeWidth={1.9} />
                  100,437 Hard Inquiries Removed
                </span>
                <span>
                  <PremiumIcon name="star" size={15} />
                  4.9 Stars — 312 Google Reviews
                </span>
      </Fragment>
            <div class="services-hero-panel-top">
              <span class="services-hero-panel-icon" aria-hidden="true">
                <PremiumIcon name="flatFee" size={24} />
              </span>
              <p>One flat fee. Three plans. The same result at every level.</p>
            </div>
            <ul class="services-hero-points ir-hero-panel-list">
              <li>Starter Plan — $199</li>
              <li>Standard Plan — $299</li>
              <li>Elite Plan — $499</li>
              <li>Free consultation included</li>
            </ul>
            <a href="/get-started" class="btn btn-primary services-hero-cta">
              Get My Free Credit Analysis
            </a>
          </PageHero>

          <section class="services-trust-strip section-divider" aria-labelledby="services-trust-heading">
            <div class="container">
              <h2 id="services-trust-heading" class="sr-only">
                Trust indicators
              </h2>

              <div class="services-stats">
                {TRUST_STATS.map((stat) => (
                  <article class="services-stat">
                    <strong>{stat.value}</strong>
                    <span>{stat.label}</span>
                  </article>
                ))}
              </div>

              <div class="services-press" aria-label="Press mentions">
                {PRESS_LOGOS.map((name) => (
                  <span>{name}</span>
                ))}
              </div>
            </div>
          </section>

          <ServicesPlanner />

          <section class="services-explainer section-divider" aria-labelledby="services-explainer-heading">
            <div class="container services-copy-shell">
              <div class="services-copy-head">
                <h2 id="services-explainer-heading">
                  Can You Dispute Hard Inquiries Yourself? Yes. Here&apos;s the Honest
                  Truth About Why Most People Hit a Wall.
                </h2>
              </div>

              <div class="services-copy-card">
                <p>
                  You can file hard inquiry disputes on your own. The Federal Trade
                  Commission provides tools, and nothing stops you from writing to
                  the bureaus directly. We believe in being transparent about that.
                </p>
                <p>
                  Here&apos;s what typically happens: you send a dispute, and the
                  bureau responds within 30 days. They either say the inquiry was
                  &quot;verified&quot; — which sounds final but isn&apos;t — or they delete it.
                  The challenge is that &quot;verified&quot; is not the same as
                  &quot;authorized.&quot; Bureaus verify that the pull happened. They do
                  not verify that you gave permissible purpose. That legal
                  distinction is where most self-filers give up, and where we
                  begin.
                </p>
                <p>
                  The other reality is the knowledge gap. Knowing which specific
                  provision of the FCRA applies to a dealership&apos;s shotgun credit
                  pull is different from knowing which provision of the FDCPA
                  applies to a debt collector pulling your report without
                  permissible purpose. Applying Metro 2 compliance arguments
                  requires knowing how furnishers are required to report and what
                  happens when they don&apos;t follow the standard. These are not
                  things you pick up in an afternoon of research — they are the
                  only thing we have spent 11 years doing.
                </p>

                <div class="services-compare-grid">
                  <article class="services-compare-card">
                    <h3>What you can do on your own:</h3>
                    <ul>
                      <li>File a basic dispute with each bureau</li>
                      <li>Request your free annual credit reports</li>
                      <li>Flag an inquiry as potentially unauthorized</li>
                    </ul>
                  </article>
                  <article class="services-compare-card services-compare-card-accent">
                    <h3>What we do that changes the outcome:</h3>
                    <ul>
                      <li>Build legally precise, individualized dispute letters that bureaus cannot dismiss as boilerplate</li>
                      <li>Apply the correct federal statute to each specific inquiry type</li>
                      <li>Follow up strategically when a bureau responds with &quot;verified&quot; rather than accepting it as final</li>
                      <li>Handle every communication so nothing falls through the cracks</li>
                      <li>Move as fast as the law allows because we know your goals are on a timeline</li>
                    </ul>
                  </article>
                </div>

                <p>
                  If you have already tried on your own and hit a wall, that is
                  the most common story we hear. It isn&apos;t a reflection on you —
                  it&apos;s a reflection on how specialized this process actually is.
                </p>

                <a href="/how-it-works" class="services-inline-link">
                  See exactly how our process works <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </section>

          <section class="services-by-bureau section-divider" aria-labelledby="services-by-bureau-heading">
            <div class="container">
              <div class="services-copy-head services-by-bureau-head">
                <h2 id="services-by-bureau-heading">
                  Choose Your Bureau — Each One Has Its Own Dispute Process and Its Own Pitfalls
                </h2>
                <p>
                  <a href="/equifax-hard-inquiry-removal" class="inline-bureau-link">
                    Equifax
                  </a>
                  ,{" "}
                  <a href="/experian-hard-inquiry-removal" class="inline-bureau-link">
                    Experian
                  </a>
                  , and{" "}
                  <a href="/transunion-hard-inquiry-removal" class="inline-bureau-link">
                    TransUnion
                  </a>{" "}
                  handle hard inquiry disputes differently. Different mailing
                  addresses. Different escalation paths. Different reasons
                  disputes fail. Pick the bureau that&apos;s blocking you and get the
                  bureau-specific playbook.
                </p>
              </div>

              <div class="services-bureau-grid">
                <a href="/experian-hard-inquiry-removal" class="services-bureau-card services-bureau-card-experian">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">Bureau</span>
                    <h3>Experian</h3>
                  </div>
                  <p>
                    Experian&apos;s online disputes get auto-processed in days
                    with boilerplate &quot;verified&quot; responses. Custom
                    letters citing the right FCRA provisions trigger an actual
                    reinvestigation — and that&apos;s where removal happens.
                  </p>
                  <span class="services-bureau-card-cta">
                    Experian inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a href="/transunion-hard-inquiry-removal" class="services-bureau-card services-bureau-card-transunion">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">Bureau</span>
                    <h3>TransUnion</h3>
                  </div>
                  <p>
                    Credit Karma&apos;s Direct Dispute tool sends real
                    TransUnion disputes — and they almost always come back
                    &quot;verified.&quot; A 15 U.S.C. § 1681b permissible-purpose
                    challenge is a different question entirely.
                  </p>
                  <span class="services-bureau-card-cta">
                    TransUnion inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a href="/equifax-hard-inquiry-removal" class="services-bureau-card services-bureau-card-equifax">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">Bureau</span>
                    <h3>Equifax</h3>
                  </div>
                  <p>
                    CFPB ordered Equifax to pay $15M in 2025 for improperly
                    investigating disputes. A &quot;verified&quot; response from
                    Equifax is not the end of the road — it&apos;s often where
                    the actual escalation begins.
                  </p>
                  <span class="services-bureau-card-cta">
                    Equifax inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>
              </div>

              <p class="services-bureau-footnote">
                Most clients have inquiries on more than one bureau. We dispute
                all three simultaneously — the bureau pages above are for
                visitors who came in with a specific bureau on their mind.
              </p>
            </div>
          </section>

          <section class="services-by-bureau section-divider" aria-labelledby="services-specialty-heading">
            <div class="container">
              <div class="services-copy-head services-by-bureau-head">
                <h2 id="services-specialty-heading">
                  Choose the Landing Page That Matches Your Situation or City
                </h2>
                <p>
                  Some hard inquiry problems need a more specific playbook. These
                  pages break down the exact removal path for unauthorized pulls,
                  identity theft inquiries, dealership pulls, mortgage approval urgency,
                  California clients, Phoenix clients, and New York City clients.
                </p>
              </div>

              <div class="services-bureau-grid">




                <a href="/identity-theft-inquiry-removal" class="services-bureau-card services-bureau-card-equifax">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">Identity Theft</span>
                    <h3>Fraudulent Inquiries</h3>
                  </div>
                  <p>
                    Built for identity theft victims who found hard inquiries
                    from accounts they never opened, companies they never contacted,
                    or lenders in places they have never been.
                  </p>
                  <span class="services-bureau-card-cta">
                    Identity theft inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a href="/unauthorized-hard-inquiry-removal" class="services-bureau-card services-bureau-card-transunion">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">FCRA</span>
                    <h3>Unauthorized Inquiries</h3>
                  </div>
                  <p>
                    Built for visitors who found a hard inquiry from a company
                    they never authorized, do not recognize, or believe lacked
                    permissible purpose.
                  </p>
                  <span class="services-bureau-card-cta">
                    Unauthorized inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a href="/car-dealership-inquiry-removal" class="services-bureau-card services-bureau-card-experian">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">Situation</span>
                    <h3>Car Dealership Inquiries</h3>
                  </div>
                  <p>
                    Built for unauthorized dealership pulls, shotgun lender submissions,
                    soft-pull bait and switch situations, and mortgage-pending urgency.
                  </p>
                  <span class="services-bureau-card-cta">
                    Dealer inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>



                <a href="/hard-inquiry-removal-mortgage" class="services-bureau-card services-bureau-card-equifax">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">Mortgage</span>
                    <h3>Mortgage Approval</h3>
                  </div>
                  <p>
                    Built for home buyers whose mortgage approval, closing date,
                    or rate tier is being held back by hard inquiry count.
                  </p>
                  <span class="services-bureau-card-cta">
                    Mortgage inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a href="/los-angeles-hard-inquiry-removal" class="services-bureau-card services-bureau-card-equifax">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">City</span>
                    <h3>Los Angeles</h3>
                  </div>
                  <p>
                    Localized for LA hard inquiry removal, California consumer protections,
                    dealership pulls, homebuying urgency, and Spanish-speaking clients.
                  </p>
                  <span class="services-bureau-card-cta">
                    Los Angeles inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a href="/phoenix-hard-inquiry-removal" class="services-bureau-card services-bureau-card-transunion">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">Home Market</span>
                    <h3>Phoenix</h3>
                  </div>
                  <p>
                    Phoenix-focused page built around Robert Garcia&apos;s founder story,
                    Valley dealership pulls, Arizona law, and Maricopa County clients.
                  </p>
                  <span class="services-bureau-card-cta">
                    Phoenix inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>

                <a href="/new-york-city-hard-inquiry-removal" class="services-bureau-card services-bureau-card-experian">
                  <div class="services-bureau-card-tone" aria-hidden="true" />
                  <div class="services-bureau-card-head">
                    <span class="services-bureau-card-eyebrow">City</span>
                    <h3>New York City</h3>
                  </div>
                  <p>
                    Built for NYC apartment applications, employer credit checks,
                    dealership pulls, identity theft inquiries, and all five boroughs.
                  </p>
                  <span class="services-bureau-card-cta">
                    NYC inquiry removal <span aria-hidden="true">→</span>
                  </span>
                </a>
              </div>
            </div>
          </section>

          <section class="services-consult section-divider" aria-labelledby="services-consult-heading">
            <div class="container services-copy-shell">
              <div class="services-copy-head">
                <h2 id="services-consult-heading">
                  Not Sure Where You Fall? Let&apos;s Figure It Out Together. For Free.
                </h2>
              </div>

              <div class="services-copy-card services-consult-card">
                <p>
                  If you do not know your inquiry count, have not pulled your
                  reports recently, or are not sure whether your inquiries qualify
                  for removal, that is exactly what the free consultation is for.
                </p>
                <p>
                  We review your reports with you, identify every inquiry that can
                  be disputed, total them across all three bureaus, and tell you
                  exactly which plan fits before you spend anything. No pressure.
                  No obligation. Just complete information so you can make a
                  confident decision.
                </p>

                <a href="/get-started" class="btn btn-primary btn-large services-consult-cta">
                  Book Your Free Consultation Now
                </a>
              </div>
            </div>
          </section>

          <section class="services-closing" aria-labelledby="services-closing-heading">
            <div class="container">
              <div class="services-closing-card gradient-border">
                <h2 id="services-closing-heading">
                  Your Credit Score Doesn&apos;t Have to Stay Where It Is.
                </h2>
                <p>
                  The inquiries pulling your number down have a legal path to
                  removal. You have federal rights. We know exactly how to use
                  them. And we offer a 100% money-back guarantee if we do not
                  deliver results within 90 days, because we are that confident in
                  what we do.
                </p>

                <div class="services-closing-actions">
                  <a href="/get-started" class="btn btn-primary btn-large">
                    Get My Free Credit Analysis
                  </a>
                  <a href="tel:+16023776626" class="btn btn-secondary btn-large services-call-cta">
                    Call Us Directly — 602-377-6626
                  </a>
                </div>

                <p class="services-closing-meta">
                  One flat fee. No monthly charges. No credit card required for
                  your free consultation. Plans start at $199.
                </p>
              </div>
            </div>
          </section>
        </main>
        <Footer />
</BaseLayout>
