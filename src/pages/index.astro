---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import InquiryLine from "../components/InquiryLine.astro";
import PageJumpNav from "../components/PageJumpNav.astro";
import ReportPanel from "../components/ReportPanel.astro";

const heroDescription =
  "Inquiry Removal helps people remove unwanted hard inquiries from Experian, Equifax, and TransUnion. Hard inquiry removal is not one item buried inside a larger credit repair program. It is our entire focus. We review what happened, identify the inquiries you want removed, and manage the removal process from start to finish. Whether the inquiries came from a dealership, identity theft, a misleading “soft pull,” or a lender you do not recognize, your first step is a free, personal review.";

const situations = [
  {
    title: "Dealership Shotgunning",
    body: "You expected one financing decision. Instead, the dealership sent your application to multiple lenders and left a trail of hard inquiries across your reports.",
    href: "/dealership-inquiries/",
  },
  {
    title: "Unauthorized Inquiries",
    body: "You did not give a company permission to access your credit, but its name still appeared in the hard inquiry section.",
    href: "/unauthorized-inquiries/",
  },
  {
    title: "Identity Theft and Fraud",
    body: "Someone used your personal information to apply for credit, leaving inquiries behind even when no account was successfully opened.",
    href: "/identity-theft-inquiries/",
  },
  {
    title: "A “Soft Pull” That Became a Hard Pull",
    body: "You were told that checking your rate or eligibility would not affect your credit, then discovered a hard inquiry afterward.",
    href: "/soft-pull-became-hard-inquiry/",
  },
  {
    title: "Duplicate and Repeated Inquiries",
    body: "The same company, lender, or financing event appears more than once, sometimes across multiple credit bureaus.",
  },
  {
    title: "Unrecognized Creditor Names",
    body: "The name on your report does not match the store, dealership, lender, or company you remember dealing with.",
  },
  {
    title: "Incorrect-Person Inquiries",
    body: "An inquiry appears to belong to someone else or may have been connected to mixed or incorrect identifying information.",
  },
  {
    title: "Inquiries You Want Gone",
    body: "Even when you remember the application, you may still want the inquiry reviewed. We examine how it happened, how it was reported, and what removal options are available.",
  },
];

const faqs = [
  [
    "Can you remove inquiries from all three credit bureaus?",
    "Yes, Inquiry Removal works with hard inquiries appearing on Experian, Equifax, and TransUnion reports. If all three reports are affected, we need current copies of all three so the complete inquiry picture can be reviewed and organized correctly.",
  ],
  [
    "How quickly can hard inquiries be removed?",
    "Some hard inquiry removals can appear in as little as seven days, while many cases require more time. Most clients should allow up to 90 days, and rare situations may extend to 120 days because companies and credit bureaus respond on different schedules.",
  ],
  [
    "Do I need all three credit reports to begin?",
    "You need reports from every bureau affected by the inquiries you want removed. If inquiries appear on all three reports, provide Experian, Equifax, and TransUnion. If you are unsure which reports are affected, the free review will help you identify what is needed.",
  ],
  [
    "Do soft inquiries affect my credit score?",
    "Soft inquiries generally do not affect credit scores, which is why Inquiry Removal focuses on hard inquiries. Hard inquiries are connected to applications for credit and may be considered by scoring models and lenders reviewing your recent credit-seeking activity.",
  ],
  [
    "What if I recognize or remember authorizing an inquiry?",
    "Tell us exactly what happened during your free review. We will examine the application, disclosure, reporting, company identity, timing, and surrounding circumstances to determine the available removal approach. You do not need to decide how the inquiry should be handled before speaking with us.",
  ],
  [
    "What happens after I request my free review?",
    "Call Inquiry Removal to speak with a specialist about your inquiries, reports, circumstances, and goals. The first conversation helps organize what happened and what information may be useful before you decide whether to proceed.",
  ],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<BaseLayout
  title="Hard Inquiry Removal | All 3 Bureaus | Inquiry Removal"
  description="Remove hard inquiries from Experian, Equifax, and TransUnion with focused, one-time service. Get your free inquiry review today."
  ogTitle="Remove Hard Inquiries From All Three Credit Reports"
  ogDescription="One focused service for removing unwanted hard inquiries from Experian, Equifax, and TransUnion."
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="hero hero--content dark-section">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> Nationwide Hard Inquiry Removal | All Three Credit Bureaus
          </p>
          <h1>Remove Hard Inquiries From All Three Credit Reports</h1>
          <p class="hero-summary">
            Focused removal for unwanted hard inquiries across Experian,
            Equifax, and TransUnion—with a free personal review to begin.
          </p>
          <p class="hero-description hero-description--desktop">
            {heroDescription}
          </p>
          <div class="button-row">
            <a
              class="button"
              href="#free-review"
              data-event="Guided Review Open"
              data-track="home-hero-guided"
              data-context="homepage"
              >Get My Free Inquiry Review <span>→</span></a
            >
            <a
              class="text-link text-link--light"
              href="/free-inquiry-review/"
              data-track="home-hero-specialist"
              data-context="homepage">Talk With a Specialist <span>↘</span></a
            >
          </div>
          <p class="cta-microcopy">
            Free review. No pressure. No monthly membership.
          </p>
          <details class="hero-mobile-details">
            <summary>Why Inquiry Removal is different</summary>
            <p class="hero-description">{heroDescription}</p>
          </details>
        </div>
        <div class="hero-interface" data-reveal>
          <ReportPanel />
          <div class="floating-label floating-label--one">
            <i></i> All three bureaus
          </div>
          <div class="floating-label floating-label--two">
            <i></i> Focused removal process
          </div>
        </div>
      </div>
    </section>

    <section class="trust-ribbon" aria-label="Company proof">
      <div class="container trust-grid">
        <div><strong>100,437</strong><span>Inquiries removed</span></div>
        <div><strong>1,123</strong><span>Clients served</span></div>
        <div>
          <strong>Since 2015</strong><span>Focused credit experience</span>
        </div>
        <div><strong>4.9</strong><span>Average client rating</span></div>
      </div>
      <p class="entity-declaration container">
        Inquiry Removal is a nationwide hard inquiry removal company helping
        consumers remove unwanted inquiries from all three major credit reports.
      </p>
    </section>

    <PageJumpNav
      items={[
        ["The problem", "#overview"],
        ["Situations", "#situations"],
        ["How it works", "#process"],
        ["Pricing", "#pricing"],
        ["Results", "#results"],
        ["Free review", "#free-review"],
      ]}
    />

    <section class="section obstacle-section" id="overview">
      <div class="container obstacle-grid">
        <div data-reveal>
          <p class="eyebrow"><span></span> The problem</p>
          <h2>Why Are Hard Inquiries Standing in Your Way?</h2>
        </div>
        <div data-reveal>
          <p>
            Hard inquiries can affect both your credit profile and the way
            lenders evaluate new applications. One inquiry may look small by
            itself, but a crowded inquiry section can make it appear that you
            are urgently seeking credit, even when the real story is completely
            different.
          </p>
          <p>
            Maybe a dealership sent one application to a long list of lenders.
            Maybe you were promised a soft pull. Maybe a company name appeared
            that you have never seen before. Maybe someone used your identity.
            Whatever happened, you should not have to accept a credit report
            that tells the wrong story about you.
          </p>
          <ul class="check-list obstacle-list">
            <li>
              You had strong credit, but recent inquiries became a reason for
              denial.
            </li>
            <li>
              You approved one credit check and discovered many lender inquiries
              afterward.
            </li>
            <li>You were told the application would not affect your credit.</li>
            <li>You found inquiries connected to fraud or identity theft.</li>
            <li>
              You want a cleaner inquiry profile before your next important
              application.
            </li>
          </ul>
          <a class="button" href="#free-review"
            >Review My Inquiries <span>→</span></a
          >
        </div>
      </div>
    </section>

    <section class="section situation-section" id="situations">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Situations we handle</p><h2>
              Which Hard Inquiry Situations Do We Handle?
            </h2>
          </div>
          <p>
            Inquiry Removal handles the situations that cause people to search
            for hard inquiry removal in the first place. We look at what
            happened, which bureaus are affected, and the best removal path for
            the inquiries on your reports.
          </p>
        </div>
        <div class="situation-grid situation-grid--eight" data-reveal>
          {
            situations.map((situation, index) => (
              <article class="situation-card situation-card--static">
                <span class="card-number">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class="situation-icon" aria-hidden="true">
                  <>
                    <i />
                    <i />
                  </>
                </span>
                <strong>{situation.title}</strong>
                <p>{situation.body}</p>
                {situation.href && (
                  <a href={situation.href}>
                    Explore this situation <span>→</span>
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <p class="section-link">
          <a class="text-link" href="/situations-we-handle/"
            >See Every Situation We Handle <span>→</span></a
          >
        </p>
      </div>
    </section>

    <section class="specialist-section dark-section">
      <div class="container">
        <p class="eyebrow eyebrow--light centered">
          <span></span> Hard Inquiry Specialists. Nothing Else.
        </p>
        <h2 class="specialist-title" data-reveal>
          Why Choose a Company That Only Removes Inquiries?
        </h2>
        <p class="editorial-quote" data-reveal>
          Inquiry removal is not an add-on here. It is the service the entire
          company was built to perform.
        </p>
        <div class="comparison-grid comparison-grid--four" data-reveal>
          <article>
            <p>One specialized focus</p><h3>Hard inquiries only.</h3><p>
              We do not divide our attention among collections, late payments,
              charge-offs, and dozens of unrelated credit problems.
            </p>
          </article>
          <article>
            <p>All three credit bureaus</p><h3>Complete report coverage.</h3><p>
              We work with inquiry information reported by Experian, Equifax,
              and TransUnion, based on the reports affected in your case.
            </p>
            <a
              class="text-link text-link--light"
              href="/experian-hard-inquiry-removal/"
            >
              Experian guide <span>→</span>
            </a>
            <a
              class="text-link text-link--light"
              href="/equifax-hard-inquiry-removal/"
            >
              Equifax guide <span>→</span>
            </a>
            <a
              class="text-link text-link--light"
              href="/transunion-hard-inquiry-removal/"
            >
              TransUnion guide <span>→</span>
            </a>
          </article>
          <article>
            <p>One-time pricing</p><h3>No monthly membership.</h3><p>
              You choose a plan based on your total number of inquiries. There
              are no monthly charges designed to keep you enrolled.
            </p>
          </article>
          <article class="comparison-featured">
            <p>Real follow-through</p><h3>More than one letter.</h3><p>
              We continue the removal process and follow up as needed under your
              service agreement.
            </p>
          </article>
        </div>
        <article class="founder-story" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> A company born from the same frustration
          </p>
          <h3>Built from firsthand experience.</h3>
          <p>
            Founder Robert Garcia created Inquiry Removal after a dealership
            sent his application to lenders he never wanted involved. The
            resulting inquiries piled onto an otherwise strong credit profile,
            and recent inquiries began standing between him and new approvals.
          </p>
          <p>
            Robert turned that experience into a specialized service for people
            facing the same problem. Since 2015, he has worked as a Senior
            Credit Analyst with one clear mission: help consumers remove
            unwanted hard inquiries without enrolling them in a broad credit
            repair program they do not need.
          </p>
          <strong>Robert Garcia, Founder and Senior Credit Analyst</strong>
          <a class="text-link text-link--light" href="/about/"
            >Meet Robert Garcia <span>→</span></a
          >
        </article>
      </div>
    </section>

    <section class="section process-section" id="process">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> How it works</p><h2>
              How Does Our Hard Inquiry Removal Process Work?
            </h2>
          </div>
          <p>
            The inquiry removal process begins with a personal review and
            continues through every necessary follow-up step. You will always
            know what we need from you and what happens next.
          </p>
        </div>
        <div class="process-grid process-grid--four" data-reveal>
          <article>
            <span>01</span><h3>Get your free inquiry review</h3><p>
              We review your credit reports and talk about what happened, how
              the inquiries are affecting you, and what you want to accomplish
              next.
            </p>
          </article>
          <article>
            <span>02</span><h3>We prepare and send the disputes</h3><p>
              Our team organizes the inquiry information, prepares the
              appropriate dispute communications, and sends them to the
              companies and credit bureaus involved.
            </p>
          </article>
          <article>
            <span>03</span><h3>You send us each response</h3><p>
              You let us know when an app, email, or mailed letter reports a
              change. We review each response, track removals, and determine the
              next follow-up action.
            </p>
          </article>
          <article>
            <span>04</span><h3>We continue the follow-through</h3><p>
              Some removals can happen in as little as seven days. Many cases
              take longer, and rare cases can extend to 120 days. We stay
              involved throughout the process.
            </p>
          </article>
        </div>
        <div class="section-cta">
          <a class="button" href="#free-review"
            >Get My Free Inquiry Review <span>→</span></a
          ><p>Talk through what happened with a specialist.</p><a
            class="text-link"
            href="/how-it-works/"
            >See How the Hard Inquiry Removal Process Works <span>→</span></a
          >
        </div>
      </div>
    </section>

    <section class="section pricing-section" id="pricing">
      <div class="container">
        <div class="section-heading centered-heading" data-reveal>
          <p class="eyebrow centered"><span></span> One-time pricing</p>
          <h2>Choose the Inquiry Removal Plan That Fits Your Reports</h2>
          <p>
            Your price is based on the total number of hard inquiries across the
            credit reports included in your service. Every option is a one-time
            price, not a monthly subscription.
          </p>
        </div>
        <div class="pricing-grid" data-reveal>
          <article>
            <p>Focused Removal</p><h3>$199</h3><strong
              >1 to 10 total inquiries</strong
            ><p class="plan-best">
              Best for a targeted cleanup before your next application.
            </p><ul>
              <li>Affected credit bureau reports included</li><li>
                Dispute preparation and submission
              </li><li>Response review and follow-up</li><li>No monthly fee</li>
            </ul><a href="#free-review">Choose Focused Removal <span>→</span></a
            >
          </article>
          <article class="pricing-featured">
            <span class="popular">Most Popular</span><p>Complete Removal</p><h3>
              $299
            </h3><strong>11 to 30 total inquiries</strong><p class="plan-best">
              Best for dealership clusters or inquiries spread across several
              reports.
            </p><ul>
              <li>Experian, Equifax, and TransUnion as needed</li><li>
                Dispute preparation and submission
              </li><li>Response review and continued follow-up</li><li>
                No monthly fee
              </li>
            </ul><a class="button" href="#free-review"
              >Choose Complete Removal <span>→</span></a
            >
          </article>
          <article>
            <p>Extensive Removal</p><h3>$499</h3><strong
              >31 or more total inquiries</strong
            ><p class="plan-best">
              Best for the broadest inquiry-removal scope.
            </p><ul>
              <li>Experian, Equifax, and TransUnion as needed</li><li>
                Dispute preparation and submission
              </li><li>Response review and continued follow-up</li><li>
                No monthly fee
              </li>
            </ul><a href="#free-review"
              >Choose Extensive Removal <span>→</span></a
            >
          </article>
        </div>
        <div class="guarantee-note" data-reveal>
          <strong>Clear One-Time Pricing</strong><p>
            Choose a plan based on the total number of hard inquiries included
            in your service. There is no recurring monthly membership fee.
          </p><a class="text-link" href="/pricing/"
            >Compare Hard Inquiry Removal Pricing <span>→</span></a
          >
        </div>
      </div>
    </section>

    <section class="evidence-section" id="results">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Documented results</p><h2>
              What Do Real Inquiry Removals Look Like?
            </h2>
          </div>
          <p>
            Real inquiry removals show up in credit-monitoring alerts, updated
            credit reports, bureau investigation results, and letters confirming
            that an inquiry was deleted. Inquiry Removal has helped 1,123
            clients remove 100,437 hard inquiries since 2015.
          </p>
        </div>
        <div class="evidence-grid evidence-grid--proof" data-reveal>
          <article class="evidence-document">
            <div class="document-top">
              <span>DOCUMENTATION STANDARD</span><span
                >PERSONAL DATA PROTECTED</span
              >
            </div><div class="redacted-lines">
              <i></i><i></i><i></i><i></i><i></i>
            </div><div class="document-highlight">
              Updated reports, bureau responses, creditor letters, and account
              notifications can help confirm what changed.
            </div><p>Every outcome should be tied to the underlying record.</p>
          </article>
          <article class="evidence-story">
            <p class="case-id">RESULTS STANDARD</p><h3>
              Proof before persuasion.
            </h3><p>
              Inquiry Removal reviews each response against the original inquiry
              list, records confirmed changes, and explains the next step.
              Private information stays protected throughout that review.
            </p><p class="case-note">
              Individual results vary. Past results do not guarantee future
              removals or credit score changes.
            </p><a class="button" href="/how-it-works/"
              >See How Results Are Reviewed <span>→</span></a
            >
          </article>
        </div>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow"><span></span> Questions, answered</p><h2>
            Hard Inquiry Removal Questions, Answered
          </h2><p>
            Straight answers about reports, timing, authorization, and what
            happens next.
          </p><a class="text-link" href="/faq/"
            >View all hard inquiry removal questions <span>→</span></a
          >
        </div>
        <div class="faq-list" data-reveal>
          {
            faqs.map(([question, answer], index) => (
              <details open={index === 0}>
                <>
                  <summary>
                    {question}
                    <span />
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="intake-section dark-section" id="free-review">
      <div class="container intake-layout">
        <div class="intake-intro" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> Free personal review
          </p><h2>Tell us what happened.</h2><p>
            Use five focused questions to organize your situation before you
            call. Nothing you select in this guided review is transmitted or
            stored.
          </p><div class="intake-security">
            <strong>Private by design</strong><span
              >Do not enter or send sensitive information through a public
              website form.</span
            >
          </div>
        </div>
        <form class="intake-form" data-intake-form novalidate data-reveal>
          <div class="form-progress" aria-label="Form progress">
            <span data-progress-label>Step 1 of 5</span><div>
              <i data-progress-bar></i>
            </div>
          </div>
          <fieldset class="form-step is-active" data-step="1">
            <legend>What would removing these inquiries help you do?</legend><p>
              What do you want to accomplish?
            </p><div class="choice-grid">
              {
                [
                  "Apply for a home",
                  "Apply for a vehicle",
                  "Qualify for business funding",
                  "Apply for credit cards",
                  "Address identity theft",
                  "Clean up my credit profile",
                  "Something else",
                ].map((label) => (
                  <label class="form-choice">
                    <>
                      <input type="radio" name="goal" value={label} required />
                      <span>{label}</span>
                    </>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="form-step" data-step="2" hidden>
            <legend>Which situation sounds most like yours?</legend><p>
              What happened?
            </p><div class="choice-grid">
              {
                [
                  "A dealership sent my credit to multiple lenders",
                  "I did not authorize the inquiry",
                  "I was told it would be a soft pull",
                  "I do not recognize the company",
                  "The inquiry is duplicated",
                  "The inquiry came from identity theft",
                  "The inquiry belongs to someone else",
                  "I authorized it but want it removed",
                  "I am not sure",
                ].map((label) => (
                  <label class="form-choice">
                    <>
                      <input
                        type="radio"
                        name="situation"
                        value={label}
                        required
                      />
                      <span>{label}</span>
                    </>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="form-step" data-step="3" hidden>
            <legend
              >About how many total hard inquiries do you want removed?</legend
            ><p>How many inquiries are involved?</p><div
              class="choice-grid choice-grid--two"
            >
              {
                ["1 to 10", "11 to 30", "31 or more", "I am not sure"].map(
                  (label) => (
                    <label class="form-choice">
                      <>
                        <input
                          type="radio"
                          name="count"
                          value={label}
                          required
                        />
                        <span>{label}</span>
                      </>
                    </label>
                  ),
                )
              }
            </div>
          </fieldset>
          <fieldset class="form-step" data-step="4" hidden>
            <legend>Which reports are affected?</legend><p>
              Choose every report that applies.
            </p><div class="choice-grid choice-grid--two">
              {
                ["Experian", "Equifax", "TransUnion", "I am not sure"].map(
                  (label) => (
                    <label class="form-choice">
                      <>
                        <input type="checkbox" name="bureau" value={label} />
                        <span>{label}</span>
                      </>
                    </label>
                  ),
                )
              }
            </div><p class="sublegend">
              Do you currently have copies of the affected reports?
            </p><div class="choice-grid choice-grid--three">
              {
                ["Yes", "No", "I need help getting them"].map((label) => (
                  <label class="form-choice">
                    <>
                      <input
                        type="radio"
                        name="reports"
                        value={label}
                        required
                      />
                      <span>{label}</span>
                    </>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="form-step" data-step="5" hidden>
            <legend>Ready to send your review request?</legend>
            <p>
              Continue to the secure on-site form to add your contact details
              and send the situation to a specialist.
            </p>
            <div class="guided-review-complete">
              <strong
                >Your initial review never requires sensitive documents.</strong
              >
              <span>
                Do not provide a Social Security number, date of birth,
                credit-report login, payment information, or report upload
                during the first conversation.
              </span>
            </div>
            <a
              class="button button--large"
              href="/free-inquiry-review/#online-review"
              data-track="home-guided-complete"
              data-context="homepage-guided-review"
              data-guided-review-link
            >
              Continue My Free Review <span>→</span>
            </a>
            <a
              class="form-call-fallback"
              href="tel:+16023776626"
              aria-label="Call Inquiry Removal at 602-377-6626"
              >Prefer to call? Call Inquiry Removal →</a
            >
          </fieldset>
          <p
            class="form-error"
            data-form-error
            aria-live="polite"
            tabindex="-1"
          >
          </p>
          <div class="form-controls">
            <button class="reset-link" type="button" data-form-back hidden
              >← Back</button
            ><button class="button" type="button" data-form-next
              >Continue <span>→</span></button
            >
          </div>
        </form>
      </div>
    </section>

    <section class="final-cta dark-section">
      <div class="final-lines" aria-hidden="true"><InquiryLine compact /></div>
      <div class="container final-content" data-reveal>
        <p class="eyebrow eyebrow--light centered">
          <span></span> Ready when you are
        </p><h2>Ready to Remove the Inquiries Standing in Your Way?</h2><p>
          You do not need a broad credit repair program when hard inquiries are
          the problem. Get a focused review from a company that has specialized
          in inquiry removal since 2015.
        </p><div class="button-row button-row--center">
          <a
            class="button button--large"
            href="#free-review"
            data-event="Guided Review Open"
            data-track="home-final-guided"
            data-context="homepage">Get My Free Inquiry Review <span>→</span></a
          ><a
            class="text-link text-link--light"
            href="/free-inquiry-review/"
            data-track="home-final-specialist"
            data-context="homepage">Talk With a Specialist <span>→</span></a
          >
        </div><p class="cta-microcopy">
          No pressure. No monthly membership. Clear one-time pricing.
        </p>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-intake-form]");
    const steps = Array.from(
      document.querySelectorAll<HTMLElement>("[data-step]"),
    );
    const nextButton =
      document.querySelector<HTMLButtonElement>("[data-form-next]");
    const backButton =
      document.querySelector<HTMLButtonElement>("[data-form-back]");
    const error = document.querySelector<HTMLElement>("[data-form-error]");
    const label = document.querySelector<HTMLElement>("[data-progress-label]");
    const bar = document.querySelector<HTMLElement>("[data-progress-bar]");
    const guidedReviewLink = document.querySelector<HTMLAnchorElement>(
      "[data-guided-review-link]",
    );
    let currentStep = 0;

    const syncGuidedReviewLink = () => {
      if (!form || !guidedReviewLink) return;
      const params = new URLSearchParams({
        source: "/",
        context: "homepage-guided-review",
      });
      const goalMap: Record<string, string> = {
        "Apply for a home": "home",
        "Apply for a vehicle": "vehicle",
        "Qualify for business funding": "business",
        "Apply for credit cards": "cards",
        "Address identity theft": "identity",
        "Clean up my credit profile": "profile",
      };
      const situationMap: Record<string, string> = {
        "A dealership sent my credit to multiple lenders": "dealership",
        "I did not authorize the inquiry": "unauthorized",
        "I was told it would be a soft pull": "soft-pull",
        "I do not recognize the company": "unrecognized",
        "The inquiry is duplicated": "duplicate",
        "The inquiry came from identity theft": "identity-theft",
        "The inquiry belongs to someone else": "incorrect-person",
        "I authorized it but want it removed": "authorized",
      };
      const countMap: Record<string, string> = {
        "1 to 10": "focused",
        "11 to 30": "complete",
        "31 or more": "extensive",
      };
      const selectedGoal = form.querySelector<HTMLInputElement>(
        "input[name='goal']:checked",
      )?.value;
      const selectedSituation = form.querySelector<HTMLInputElement>(
        "input[name='situation']:checked",
      )?.value;
      const selectedCount = form.querySelector<HTMLInputElement>(
        "input[name='count']:checked",
      )?.value;
      const selectedBureaus = Array.from(
        form.querySelectorAll<HTMLInputElement>("input[name='bureau']:checked"),
      ).map((input) => input.value.toLowerCase());

      if (selectedGoal && goalMap[selectedGoal])
        params.set("goal", goalMap[selectedGoal]);
      if (selectedSituation && situationMap[selectedSituation])
        params.set("situation", situationMap[selectedSituation]);
      if (selectedCount && countMap[selectedCount])
        params.set("plan", countMap[selectedCount]);
      if (
        selectedBureaus.length === 1 &&
        ["experian", "equifax", "transunion"].includes(selectedBureaus[0])
      )
        params.set("bureau", selectedBureaus[0]);

      guidedReviewLink.href = `/free-inquiry-review/?${params.toString()}#online-review`;
    };

    const showStep = (index: number) => {
      currentStep = Math.max(0, Math.min(index, steps.length - 1));
      steps.forEach((step, position) => {
        step.hidden = position !== currentStep;
        step.classList.toggle("is-active", position === currentStep);
      });
      if (label) label.textContent = `Step ${currentStep + 1} of 5`;
      if (bar) bar.style.width = `${((currentStep + 1) / 5) * 100}%`;
      if (backButton) backButton.hidden = currentStep === 0;
      if (nextButton) nextButton.hidden = currentStep === steps.length - 1;
      if (error) error.textContent = "";
      if (currentStep === steps.length - 1) syncGuidedReviewLink();
    };

    const stepIsComplete = () => {
      const step = steps[currentStep];
      if (!step) return false;
      if (currentStep === 3) {
        const bureau = step.querySelector("input[name='bureau']:checked");
        const reports = step.querySelector("input[name='reports']:checked");
        return Boolean(bureau && reports);
      }
      return Array.from(
        step.querySelectorAll<HTMLInputElement>("[required]"),
      ).some(
        (input) =>
          input.checked || (input.type !== "radio" && input.value.trim()),
      );
    };

    nextButton?.addEventListener("click", () => {
      if (!stepIsComplete()) {
        if (error) {
          error.textContent = "Choose an answer to continue.";
          error.focus();
        }
        return;
      }
      showStep(currentStep + 1);
    });
    backButton?.addEventListener("click", () => showStep(currentStep - 1));
    form?.addEventListener("submit", (event) => event.preventDefault());
    showStep(0);
  </script>
</BaseLayout>
