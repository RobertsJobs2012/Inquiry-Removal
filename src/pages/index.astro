---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import InquiryLine from "../components/InquiryLine.astro";
import PageJumpNav from "../components/PageJumpNav.astro";
import ReportPanel from "../components/ReportPanel.astro";

const situations = [
  {
    title: "A Dealership Sent Your Credit Everywhere",
    body: "You expected one financing decision. Instead, your application was sent to multiple lenders and you discovered a trail of hard inquiries across your reports.",
    href: "/dealership-inquiries/",
  },
  {
    title: "You Never Authorized the Inquiry",
    body: "A company accessed your credit and you do not remember giving permission for the hard pull.",
    href: "/unauthorized-inquiries/",
  },
  {
    title: "Someone Used Your Identity",
    body: "Fraudulent applications can leave hard inquiries behind even when the account itself was never successfully opened.",
    href: "/identity-theft-inquiries/",
  },
  {
    title: "You Were Told It Would Be a Soft Pull",
    body: "You were assured that checking your rate, eligibility, or financing options would not affect your credit. Then a hard inquiry appeared.",
    href: "/soft-pull-became-hard-inquiry/",
  },
  {
    title: "The Same Inquiry Appears More Than Once",
    body: "A lender, dealership, or financing event appears repeatedly or across multiple reports.",
    href: "/duplicate-inquiries/",
  },
  {
    title: "You Do Not Recognize the Company Name",
    body: "The inquiry name does not match the store, lender, dealership, or company you remember dealing with.",
    href: "/unrecognized-inquiries/",
  },
  {
    title: "The Inquiry Does Not Belong to You",
    body: "An inquiry may be connected to incorrect identifying information, another consumer, or a mixed-file situation.",
    href: "/incorrect-person-inquiries/",
  },
  {
    title: "You Remember the Application but Want It Reviewed",
    body: "Tell us what happened. We review the circumstances, reporting, timing, application, and available removal approach with you.",
    href: "/authorized-inquiry-removal/",
  },
];

const processSteps = [
  {
    title: "Start with your free inquiry review",
    body: "We review the affected reports, what caused the inquiries, which bureaus are involved, what you have already tried, and what you want to accomplish next.",
  },
  {
    title: "We map the inquiry trail",
    body: "We organize creditor names, dates, affected bureaus, and the circumstances connecting multiple pulls to the same event so the problem is clear before the dispute work begins.",
  },
  {
    title: "We prepare and send the disputes",
    body: "Inquiry Removal prepares the appropriate dispute communications and sends them to the companies and credit bureaus involved. You do not have to build the process from scratch yourself.",
  },
  {
    title: "We review responses and continue",
    body: "You send us the updates you receive. We review what changed, track confirmed removals, and continue the follow-through when another step is needed.",
  },
];

const plans = [
  {
    name: "Focused Removal",
    price: "$199",
    count: "1 to 10 total inquiries",
    best: "Best for a smaller inquiry problem or targeted cleanup before an important application.",
    featured: false,
  },
  {
    name: "Complete Removal",
    price: "$299",
    count: "11 to 30 total inquiries",
    best: "Best for dealership clusters, repeated applications, or inquiries spread across several reports.",
    featured: true,
  },
  {
    name: "Extensive Removal",
    price: "$499",
    count: "31 or more total inquiries",
    best: "Best for high-volume inquiry situations requiring the broadest removal scope.",
    featured: false,
  },
];

const faqs = [
  [
    "Can you work with Experian, Equifax, and TransUnion?",
    "Yes. Inquiry Removal works with hard inquiries appearing on Experian, Equifax, and TransUnion reports. If inquiries appear on more than one bureau, the affected reports can be handled together under the applicable service plan.",
  ],
  [
    "How quickly can hard inquiries be removed?",
    "Some removals can appear in as little as seven days, while many cases require more time. Most clients should allow up to 90 days, and uncommon situations may extend longer because creditors and credit bureaus do not all respond on the same schedule.",
  ],
  [
    "Is Inquiry Removal a monthly service?",
    "No. Inquiry Removal uses one-time pricing based on the total number of hard inquiries included in your service. Current plans are $199, $299, and $499, with no recurring monthly membership fee.",
  ],
  [
    "What if I do not know how many inquiries I have?",
    "Start with the free inquiry review. An estimate is enough to begin. We can help organize the inquiry list and determine which plan matches the total service scope.",
  ],
  [
    "What if I recognize the inquiry but still want it removed?",
    "Tell us exactly what happened. We can review the application, disclosure, creditor identity, reporting, timing, and surrounding circumstances and explain the available removal approach.",
  ],
  [
    "Do I have to write the disputes myself?",
    "No. Dispute preparation and submission are part of the Inquiry Removal service. You provide the necessary information and keep us updated when responses arrive.",
  ],
  [
    "What happens after a response comes back?",
    "Send it to us. We review the response against the inquiry list, determine what changed, and explain whether additional follow-up is needed.",
  ],
  [
    "Do soft inquiries matter?",
    "Soft inquiries generally do not affect your credit score. Inquiry Removal focuses on hard inquiries because hard pulls are associated with applications for credit and may be considered by scoring models and lenders reviewing recent credit activity.",
  ],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<BaseLayout
  title="Hard Inquiry Removal | All 3 Bureaus | Inquiry Removal"
  description="Hard inquiry removal across Experian, Equifax, and TransUnion with one-time pricing from $199. Get a free personal review and clear next steps."
  ogTitle="Hard Inquiry Removal: Clear the Pulls Standing in Your Way"
  ogDescription="Nationwide hard inquiry removal across Experian, Equifax, and TransUnion with one-time pricing and a free personal review."
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="hero hero--content dark-section">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> Nationwide Hard Inquiry Specialists · Experian · Equifax · TransUnion
          </p>
          <h1>Hard Inquiry Removal: Clear the Pulls Standing in Your Way</h1>
          <p class="hero-summary">
            Hard inquiry removal is all we do. If unwanted pulls from a dealership, unfamiliar lender, identity theft, duplicate application, or misleading “soft pull” are crowding your credit reports, you do not have to figure out the next move alone. Since 2015, Inquiry Removal has helped 1,123 clients remove more than 100,000 hard inquiries across Experian, Equifax, and TransUnion. See how our specialized process works, which situations we handle, what the service costs, and how to start with a free personal review.
          </p>
          <div class="button-row">
            <a
              class="button"
              href="#free-review"
              data-event="Guided Review Open"
              data-track="home-hero-guided"
              data-context="homepage"
              >Get My Free Inquiry Review <span>→</span></a
            >
            <a
              class="text-link text-link--light"
              href="/free-inquiry-review/"
              data-track="home-hero-specialist"
              data-context="homepage">Talk With a Specialist <span>↘</span></a
            >
          </div>
          <p class="cta-microcopy">Free personal review. No pressure. No monthly membership.</p>
        </div>
        <div class="hero-interface" data-reveal>
          <ReportPanel />
          <div class="floating-label floating-label--one"><i></i> All three bureaus</div>
          <div class="floating-label floating-label--two"><i></i> Focused removal process</div>
        </div>
      </div>
    </section>

    <section class="trust-ribbon" aria-label="Company proof">
      <div class="container trust-grid">
        <div><strong>100,437</strong><span>Hard inquiries removed</span></div>
        <div><strong>1,123</strong><span>Clients served</span></div>
        <div><strong>Since 2015</strong><span>Focused inquiry experience</span></div>
        <div><strong>4.9</strong><span>Average client rating</span></div>
      </div>
      <p class="entity-declaration container">
        Inquiry Removal is a nationwide hard inquiry removal company and specialized credit inquiry removal service focused exclusively on unwanted hard inquiries across all three major credit reports.
      </p>
    </section>

    <PageJumpNav
      items={[
        ["The problem", "#overview"],
        ["Situations", "#situations"],
        ["Why us", "#specialists"],
        ["How it works", "#process"],
        ["Results", "#results"],
        ["Pricing", "#pricing"],
        ["Free review", "#free-review"],
      ]}
    />

    <section class="section obstacle-section" id="overview">
      <div class="container obstacle-grid">
        <div data-reveal>
          <p class="eyebrow"><span></span> The problem</p>
          <h2>Are Hard Inquiries Getting in the Way of What You Want Next?</h2>
        </div>
        <div data-reveal>
          <p>
            <strong>They can.</strong> If hard inquiries are crowding the recent-credit section of your reports, they can become one more issue to explain or address before the next application that matters to you.
          </p>
          <p>
            Maybe you went to <strong>one dealership and came home with a long list of lender inquiries</strong>. Maybe you checked your credit and found a company you do not recognize. Maybe someone used your identity. Maybe you were specifically told the credit check would be soft.
          </p>
          <p>
            Or maybe your credit is otherwise where you want it, but your inquiry section is still telling a story that does not match what actually happened. The frustrating part is not simply seeing the inquiries. <strong>It is knowing what you are trying to do next.</strong>
          </p>
          <ul class="check-list obstacle-list">
            <li>Buy a home without carrying an unwanted inquiry trail into the application.</li>
            <li>Finance a vehicle after a dealership sent your credit to multiple lenders.</li>
            <li>Qualify for business funding with a cleaner recent-credit profile.</li>
            <li>Apply for credit cards without unnecessary pulls crowding the report.</li>
            <li>Protect credit you worked hard to build before the next important application.</li>
          </ul>
          <p>If hard inquiries are the problem, Inquiry Removal was built specifically for that problem.</p>
          <a class="text-link" href="#situations">Find My Situation <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="section situation-section" id="situations">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Situations we handle</p>
            <h2>Which Hard Inquiry Situation Sounds Like Yours?</h2>
          </div>
          <p>
            <strong>The right starting point depends on why the inquiry appeared.</strong> We review the cause, the affected reports, what you remember authorizing, and what you want to accomplish next.
          </p>
        </div>
        <div class="situation-grid situation-grid--eight" data-reveal>
          {
            situations.map((situation, index) => (
              <article class="situation-card situation-card--static">
                <span class="card-number">{String(index + 1).padStart(2, "0")}</span>
                <span class="situation-icon" aria-hidden="true"><><i /><i /></></span>
                <strong>{situation.title}</strong>
                <p>{situation.body}</p>
                <a href={situation.href}>Explore this situation <span>→</span></a>
              </article>
            ))
          }
        </div>
        <p class="section-link">
          <a class="text-link" href="/situations-we-handle/">See Every Situation We Handle <span>→</span></a>
        </p>
      </div>
    </section>

    <section class="specialist-section dark-section" id="specialists">
      <div class="container">
        <p class="eyebrow eyebrow--light centered"><span></span> Hard Inquiry Specialists. Nothing Else.</p>
        <h2 class="specialist-title" data-reveal>Why Choose a Company That Only Removes Hard Inquiries?</h2>
        <p class="editorial-quote" data-reveal>
          Because specialization changes the entire experience. Our hard inquiry removal service was built around this problem instead of treating inquiries as one small feature inside a general credit repair program.
        </p>
        <div class="comparison-grid comparison-grid--four" data-reveal>
          <article>
            <p>One specialized focus</p>
            <h3>Hard inquiries only.</h3>
            <p>We do not divide our attention among collections, late payments, charge-offs, bankruptcies, and dozens of unrelated credit problems.</p>
          </article>
          <article>
            <p>All three credit bureaus</p>
            <h3>One complete inquiry picture.</h3>
            <p>We review the reports affected in your situation and organize the inquiry trail across Experian, Equifax, and TransUnion when necessary.</p>
            <a class="text-link text-link--light" href="/experian-hard-inquiry-removal/">Experian guide <span>→</span></a>
            <a class="text-link text-link--light" href="/equifax-hard-inquiry-removal/">Equifax guide <span>→</span></a>
            <a class="text-link text-link--light" href="/transunion-hard-inquiry-removal/">TransUnion guide <span>→</span></a>
          </article>
          <article>
            <p>One-time pricing</p>
            <h3>No monthly membership.</h3>
            <p>Your price is based on the number of hard inquiries included in the service, not how many months we can keep you enrolled.</p>
          </article>
          <article class="comparison-featured">
            <p>Continued follow-through</p>
            <h3>More than one letter.</h3>
            <p>Incoming responses are reviewed, confirmed changes are tracked, and additional follow-up continues as needed under your service agreement.</p>
          </article>
        </div>

        <article class="founder-story" data-reveal>
          <p class="eyebrow eyebrow--light"><span></span> Built from the same frustration</p>
          <h3>Inquiry Removal started with a dealership.</h3>
          <p>
            Founder Robert Garcia created Inquiry Removal after a dealership sent his application to lenders he never wanted involved. The resulting inquiries piled onto an otherwise strong credit profile and recent inquiries began standing between him and new approvals.
          </p>
          <p>
            Instead of building another general credit repair company, Robert chose one specialty: hard inquiries. Since 2015, that focus has grown into a nationwide inquiry removal service for consumers dealing with unwanted pulls across Experian, Equifax, and TransUnion.
          </p>
          <strong>Robert Garcia, Founder and Senior Credit Analyst</strong>
          <a class="text-link text-link--light" href="/about/">Meet Robert Garcia <span>→</span></a>
        </article>
      </div>
    </section>

    <section class="section process-section" id="process">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> How it works</p>
            <h2>How Does Hard Inquiry Removal Work?</h2>
          </div>
          <p>
            <strong>Hard inquiry removal starts with reviewing the inquiries, organizing what happened, preparing the disputes, and following the responses through additional rounds when needed.</strong> That is what turns a confusing list of pulls into a managed process with a clear next step.
          </p>
        </div>
        <div class="process-grid process-grid--four" data-reveal>
          {
            processSteps.map((step, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </article>
            ))
          }
        </div>
        <div class="guarantee-note" data-reveal>
          <strong>More than a template letter.</strong>
          <p>
            A specialized credit inquiry removal service should make the invisible work visible: organizing creditor names and dates, matching inquiries across bureaus, preparing the communications, reviewing every response, tracking confirmed changes, and deciding what happens next.
          </p>
          <a class="text-link" href="/how-it-works/">See the Complete Process <span>→</span></a>
        </div>
        <div class="section-cta">
          <a class="button" href="#free-review">Get My Free Inquiry Review <span>→</span></a>
          <p>Talk through what happened before deciding whether to proceed.</p>
        </div>
      </div>
    </section>

    <section class="evidence-section" id="results">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Documented results</p>
            <h2>What Do Real Hard Inquiry Removals Look Like?</h2>
          </div>
          <p>
            <strong>Real hard inquiry removals are documented by the underlying record.</strong> An updated Experian, Equifax, or TransUnion report, a credit-monitoring notification, an investigation result, a creditor response, or another record can show that an inquiry previously appearing on the report is no longer being reported.
          </p>
        </div>
        <div class="evidence-grid evidence-grid--proof" data-reveal>
          <article class="evidence-document">
            <div class="document-top"><span>DOCUMENTATION STANDARD</span><span>PERSONAL DATA PROTECTED</span></div>
            <div class="redacted-lines"><i></i><i></i><i></i><i></i><i></i></div>
            <div class="document-highlight">Updated reports, bureau responses, creditor letters, and account notifications can help confirm what changed.</div>
            <p>Every outcome should be tied to the underlying record.</p>
          </article>
          <article class="evidence-story">
            <p class="case-id">PROOF BEFORE PERSUASION</p>
            <h3>100,437 inquiries removed for 1,123 clients since 2015.</h3>
            <p>Inquiry Removal reviews each response against the original inquiry list, records confirmed changes, and explains the next step. Private information stays protected throughout that review.</p>
            <p class="case-note">Individual results vary. Past results do not guarantee future removals or credit score changes.</p>
            <a class="button" href="/results/">See Documented Results <span>→</span></a>
          </article>
        </div>

        <div class="guarantee-note" data-reveal>
          <strong>Your previous dispute does not end the conversation.</strong>
          <p>
            If you already tried to remove hard inquiries yourself, we can review what you sent, what came back, what still appears, and what the inquiry trail looks like now. You do not have to keep repeating the same step simply because it is the only step you know.
          </p>
          <a class="text-link" href="#free-review">Show Us What Happened <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="section pricing-section" id="pricing">
      <div class="container">
        <div class="section-heading centered-heading" data-reveal>
          <p class="eyebrow centered"><span></span> One problem. One clear price.</p>
          <h2>How Much Does Hard Inquiry Removal Cost?</h2>
          <p>
            <strong>Hard inquiry removal costs $199, $299, or $499 with Inquiry Removal, depending on the total number of inquiries included.</strong> Every plan includes the affected credit bureaus, inquiry organization, dispute preparation and submission, response review, and continued follow-through.
          </p>
        </div>
        <div class="pricing-grid" data-reveal>
          {
            plans.map((plan) => (
              <article class={plan.featured ? "pricing-featured" : undefined}>
                {plan.featured && <span class="popular">Most Popular</span>}
                <p>{plan.name}</p>
                <h3>{plan.price}</h3>
                <strong>{plan.count}</strong>
                <p class="plan-best">{plan.best}</p>
                <ul>
                  <li>All affected credit bureaus</li>
                  <li>Inquiry list organization</li>
                  <li>Dispute preparation and submission</li>
                  <li>Response review and continued follow-up</li>
                  <li>No monthly fee</li>
                </ul>
                {plan.featured ? (
                  <a class="button" href="#free-review">Choose Complete Removal <span>→</span></a>
                ) : (
                  <a href="/pricing/">See {plan.name} Details <span>→</span></a>
                )}
              </article>
            ))
          }
        </div>
        <div class="guarantee-note" data-reveal>
          <strong>$199 to $499 once. Not a monthly membership.</strong>
          <p>
            This inquiry removal service is priced around the size of the inquiry problem, not how long we can keep you enrolled. If you are not sure which plan fits, start with the free review and we can organize the count first.
          </p>
          <a class="text-link" href="/pricing/">Compare Hard Inquiry Removal Pricing <span>→</span></a>
        </div>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow"><span></span> Questions, answered</p>
          <h2>Hard Inquiry Removal Questions</h2>
          <p>Straight answers about reports, timing, pricing, authorization, and what happens next.</p>
          <a class="text-link" href="/faq/">See All Hard Inquiry Removal Questions <span>→</span></a>
        </div>
        <div class="faq-list" data-reveal>
          {
            faqs.map(([question, answer], index) => (
              <details open={index === 0}>
                <><summary>{question}<span /></summary><p>{answer}</p></>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="intake-section dark-section" id="free-review">
      <div class="container intake-layout">
        <div class="intake-intro" data-reveal>
          <p class="eyebrow eyebrow--light"><span></span> Free personal review</p>
          <h2>Tell Us What Happened</h2>
          <p>
            You do not need to know what type of dispute applies, identify every creditor perfectly, or choose a plan before speaking with us. Start with five simple questions and let us organize the inquiry problem from there.
          </p>
          <div class="intake-security">
            <strong>Private by design</strong>
            <span>Your initial review does not require your Social Security number, credit-report login, payment information, or other sensitive account credentials.</span>
          </div>
        </div>
        <form class="intake-form" data-intake-form novalidate data-reveal>
          <div class="form-progress" aria-label="Form progress">
            <span data-progress-label>Step 1 of 5</span>
            <div><i data-progress-bar></i></div>
          </div>
          <fieldset class="form-step is-active" data-step="1">
            <legend>What would removing these inquiries help you do?</legend>
            <p>What do you want to accomplish?</p>
            <div class="choice-grid">
              {
                [
                  "Apply for a home",
                  "Apply for a vehicle",
                  "Qualify for business funding",
                  "Apply for credit cards",
                  "Address identity theft",
                  "Clean up my credit profile",
                  "Something else",
                ].map((label) => (
                  <label class="form-choice"><><input type="radio" name="goal" value={label} required /><span>{label}</span></></label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="form-step" data-step="2" hidden>
            <legend>Which situation sounds most like yours?</legend>
            <p>What happened?</p>
            <div class="choice-grid">
              {
                [
                  "A dealership sent my credit to multiple lenders",
                  "I did not authorize the inquiry",
                  "I was told it would be a soft pull",
                  "I do not recognize the company",
                  "The inquiry is duplicated",
                  "The inquiry came from identity theft",
                  "The inquiry belongs to someone else",
                  "I authorized it but want it removed",
                  "I am not sure",
                ].map((label) => (
                  <label class="form-choice"><><input type="radio" name="situation" value={label} required /><span>{label}</span></></label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="form-step" data-step="3" hidden>
            <legend>About how many total hard inquiries do you want removed?</legend>
            <p>How many inquiries are involved?</p>
            <div class="choice-grid choice-grid--two">
              {
                ["1 to 10", "11 to 30", "31 or more", "I am not sure"].map((label) => (
                  <label class="form-choice"><><input type="radio" name="count" value={label} required /><span>{label}</span></></label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="form-step" data-step="4" hidden>
            <legend>Which reports are affected?</legend>
            <p>Choose every report that applies.</p>
            <div class="choice-grid choice-grid--two">
              {
                ["Experian", "Equifax", "TransUnion", "I am not sure"].map((label) => (
                  <label class="form-choice"><><input type="checkbox" name="bureau" value={label} /><span>{label}</span></></label>
                ))
              }
            </div>
            <p class="sublegend">Do you currently have copies of the affected reports?</p>
            <div class="choice-grid choice-grid--three">
              {
                ["Yes", "No", "I need help getting them"].map((label) => (
                  <label class="form-choice"><><input type="radio" name="reports" value={label} required /><span>{label}</span></></label>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="form-step" data-step="5" hidden>
            <legend>Ready to send your review request?</legend>
            <p>Continue to the secure on-site form to add your contact details and send the situation to a specialist.</p>
            <div class="guided-review-complete">
              <strong>Your initial review never requires sensitive documents.</strong>
              <span>Do not provide a Social Security number, date of birth, credit-report login, payment information, or report upload during the first conversation.</span>
            </div>
            <a
              class="button button--large"
              href="/free-inquiry-review/#online-review"
              data-track="home-guided-complete"
              data-context="homepage-guided-review"
              data-guided-review-link
            >Continue My Free Review <span>→</span></a>
            <a class="form-call-fallback" href="tel:+16023776626">Prefer to call? Call Inquiry Removal →</a>
          </fieldset>
          <p class="form-error" data-form-error aria-live="polite" tabindex="-1"></p>
          <div class="form-controls">
            <button class="reset-link" type="button" data-form-back hidden>← Back</button>
            <button class="button" type="button" data-form-next>Continue <span>→</span></button>
          </div>
        </form>
      </div>
    </section>

    <section class="final-cta dark-section">
      <div class="final-lines" aria-hidden="true"><InquiryLine compact /></div>
      <div class="container final-content" data-reveal>
        <p class="eyebrow eyebrow--light centered"><span></span> Ready when you are</p>
        <h2>Remove the Inquiries Standing in Your Way</h2>
        <p>
          You do not need to solve the entire problem before contacting us. Bring us the reports. Tell us what happened. Tell us what you want to accomplish next. We will help you organize the inquiry problem and show you the next step.
        </p>
        <div class="button-row button-row--center">
          <a class="button button--large" href="#free-review" data-event="Guided Review Open" data-track="home-final-guided" data-context="homepage">Get My Free Inquiry Review <span>→</span></a>
          <a class="text-link text-link--light" href="/free-inquiry-review/" data-track="home-final-specialist" data-context="homepage">Talk With a Specialist <span>→</span></a>
        </div>
        <p class="cta-microcopy">Free personal review. Nationwide service. One-time pricing. No monthly membership.</p>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const form = document.querySelector<HTMLFormElement>("[data-intake-form]");
    const steps = Array.from(document.querySelectorAll<HTMLElement>("[data-step]"));
    const nextButton = document.querySelector<HTMLButtonElement>("[data-form-next]");
    const backButton = document.querySelector<HTMLButtonElement>("[data-form-back]");
    const error = document.querySelector<HTMLElement>("[data-form-error]");
    const label = document.querySelector<HTMLElement>("[data-progress-label]");
    const bar = document.querySelector<HTMLElement>("[data-progress-bar]");
    const guidedReviewLink = document.querySelector<HTMLAnchorElement>("[data-guided-review-link]");
    let currentStep = 0;

    const syncGuidedReviewLink = () => {
      if (!form || !guidedReviewLink) return;
      const params = new URLSearchParams({ source: "/", context: "homepage-guided-review" });
      const goalMap: Record<string, string> = {
        "Apply for a home": "home",
        "Apply for a vehicle": "vehicle",
        "Qualify for business funding": "business",
        "Apply for credit cards": "cards",
        "Address identity theft": "identity",
        "Clean up my credit profile": "profile",
      };
      const situationMap: Record<string, string> = {
        "A dealership sent my credit to multiple lenders": "dealership",
        "I did not authorize the inquiry": "unauthorized",
        "I was told it would be a soft pull": "soft-pull",
        "I do not recognize the company": "unrecognized",
        "The inquiry is duplicated": "duplicate",
        "The inquiry came from identity theft": "identity-theft",
        "The inquiry belongs to someone else": "incorrect-person",
        "I authorized it but want it removed": "authorized",
      };
      const countMap: Record<string, string> = {
        "1 to 10": "focused",
        "11 to 30": "complete",
        "31 or more": "extensive",
      };
      const selectedGoal = form.querySelector<HTMLInputElement>("input[name='goal']:checked")?.value;
      const selectedSituation = form.querySelector<HTMLInputElement>("input[name='situation']:checked")?.value;
      const selectedCount = form.querySelector<HTMLInputElement>("input[name='count']:checked")?.value;
      const selectedBureaus = Array.from(form.querySelectorAll<HTMLInputElement>("input[name='bureau']:checked")).map((input) => input.value.toLowerCase());

      if (selectedGoal && goalMap[selectedGoal]) params.set("goal", goalMap[selectedGoal]);
      if (selectedSituation && situationMap[selectedSituation]) params.set("situation", situationMap[selectedSituation]);
      if (selectedCount && countMap[selectedCount]) params.set("plan", countMap[selectedCount]);
      if (selectedBureaus.length === 1 && ["experian", "equifax", "transunion"].includes(selectedBureaus[0])) params.set("bureau", selectedBureaus[0]);

      guidedReviewLink.href = `/free-inquiry-review/?${params.toString()}#online-review`;
    };

    const showStep = (index: number) => {
      currentStep = Math.max(0, Math.min(index, steps.length - 1));
      steps.forEach((step, position) => {
        step.hidden = position !== currentStep;
        step.classList.toggle("is-active", position === currentStep);
      });
      if (label) label.textContent = `Step ${currentStep + 1} of 5`;
      if (bar) bar.style.width = `${((currentStep + 1) / 5) * 100}%`;
      if (backButton) backButton.hidden = currentStep === 0;
      if (nextButton) nextButton.hidden = currentStep === steps.length - 1;
      if (error) error.textContent = "";
      if (currentStep === steps.length - 1) syncGuidedReviewLink();
    };

    const stepIsComplete = () => {
      const step = steps[currentStep];
      if (!step) return false;
      if (currentStep === 3) {
        const bureau = step.querySelector("input[name='bureau']:checked");
        const reports = step.querySelector("input[name='reports']:checked");
        return Boolean(bureau && reports);
      }
      return Array.from(step.querySelectorAll<HTMLInputElement>("[required]")).some(
        (input) => input.checked || (input.type !== "radio" && input.value.trim()),
      );
    };

    nextButton?.addEventListener("click", () => {
      if (!stepIsComplete()) {
        if (error) {
          error.textContent = "Choose an answer to continue.";
          error.focus();
        }
        return;
      }
      showStep(currentStep + 1);
    });
    backButton?.addEventListener("click", () => showStep(currentStep - 1));
    form?.addEventListener("submit", (event) => event.preventDefault());
    showStep(0);
  </script>
</BaseLayout>