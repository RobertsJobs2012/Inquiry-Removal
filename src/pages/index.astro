---
import { editorialPlan } from "../data/editorial";

const revision = editorialPlan["/"];
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import FreeReviewForm from "../components/FreeReviewForm.astro";
import Header from "../components/Header.astro";
import InquiryLine from "../components/InquiryLine.astro";
import PageJumpNav from "../components/PageJumpNav.astro";
import ReportPanel from "../components/ReportPanel.astro";
import { PRICING_PLANS as plans, PLAN_FEATURES } from "../data/pricing";

const situations = [
  {
    title: "One Dealership Visit, Several Hard Pulls",
    body: "Your financing application went to several lenders. Find out how to trace the pulls back to that visit and spot anything that doesn’t match.",
    link: "Understand dealership inquiries",
    href: "/dealership-inquiries/",
  },
  {
    title: "A Hard Pull You Didn’t Authorize",
    body: "You don’t remember applying or giving permission. Start with who accessed your report and why.",
    link: "Review a potentially unauthorized pull",
    href: "/unauthorized-inquiries/",
  },
  {
    title: "You Suspect Identity Theft",
    body: "An application you didn’t make can leave a hard pull even if no account was opened. Learn how to respond if you suspect fraud.",
    link: "See the identity theft steps",
    href: "/identity-theft-inquiries/",
  },
  {
    title: "A Soft Check Turned Into a Hard Pull",
    body: "You expected to check a rate without a hard pull. Compare what the offer said with what you agreed to and what the report shows.",
    link: "Check what changed",
    href: "/soft-pull-became-hard-inquiry/",
  },
  {
    title: "The Same Inquiry Shows Up Twice",
    body: "The same lender and date appear more than once. Check whether it’s a duplicate or a separate entry on another report.",
    link: "Check for duplicate inquiries",
    href: "/duplicate-inquiries/",
  },
  {
    title: "You Don’t Recognize the Company",
    body: "The name on your report might be a bank or financing partner you know by another name. Find out who made the pull.",
    link: "Identify an unfamiliar lender",
    href: "/unrecognized-inquiries/",
  },
  {
    title: "The Inquiry May Belong to Someone Else",
    body: "If the details point to another person, start by documenting what doesn’t match on the affected report.",
    link: "Review a wrong-person inquiry",
    href: "/incorrect-person-inquiries/",
  },
  {
    title: "You Applied, but Something Looks Wrong",
    body: "An accurate, authorized pull generally stays. If the lender, date, or way the pull was reported doesn’t match, check the specific discrepancy.",
    link: "See when a known inquiry warrants review",
    href: "/authorized-inquiry-removal/",
  },
];

const processSteps = [
  {
    title: "Tell us what happened",
    body: "Share what you recognize, what you don’t, and which reports are affected. An estimate is enough to start your free review.",
  },
  {
    title: "Find out what’s worth pursuing",
    body: "We help match company names and dates to the events behind them, then explain what you can do yourself or what we can handle.",
  },
  {
    title: "Let us handle the dispute work",
    body: "If you hire us, we organize the entries in scope and prepare and send supported disputes to the appropriate companies and bureaus.",
  },
  {
    title: "Know what changed and what’s next",
    body: "Share the responses you receive. We compare them with the original inquiry list and handle any follow-up needed under your agreement.",
  },
];

const faqs = [
  [
    "Can you work with Experian, Equifax, and TransUnion?",
    "Yes. Inquiry Removal works with hard inquiries appearing on Experian, Equifax, and TransUnion reports. If inquiries appear on more than one bureau, the affected reports can be handled together under the applicable service plan.",
  ],
  [
    "How quickly can hard inquiries be removed?",
    "Timing depends on the evidence and how the lender and bureau respond. If you have an application deadline, tell us during your review. We can discuss what’s realistic, but we cannot promise a removal by a specific date.",
  ],
  [
    "Is Inquiry Removal a monthly service?",
    "No. Inquiry Removal uses one-time pricing based on the total number of hard inquiries included in your service. Current plans are $199 for 1–10, $299 for 11–20, $399 for 21–30, and $499 for 31 or more, with no recurring monthly membership fee.",
  ],
  [
    "What if I do not know how many inquiries I have?",
    "Start with the free inquiry review. An estimate is enough to begin. We can help organize the inquiry list and determine which plan matches the total service scope.",
  ],
  [
    "What if I recognize the inquiry but still want it removed?",
    "Accurate, authorized inquiries generally stay until they age off. If something about the company, date or reporting looks wrong, tell us what doesn’t match so we can help you assess it.",
  ],
  [
    "Do I have to write the disputes myself?",
    "No. Dispute preparation and submission are part of the Inquiry Removal service. You provide the necessary information and keep us updated when responses arrive.",
  ],
  [
    "What happens after a response comes back?",
    "Send it to us. We review the response against the inquiry list, determine what changed, and explain whether additional follow-up is needed.",
  ],
  [
    "Do soft inquiries matter?",
    "Soft inquiries generally do not affect your credit score. Inquiry Removal focuses on hard inquiries because hard pulls are associated with applications for credit and may be considered by scoring models and lenders reviewing recent credit activity.",
  ],
];
---

<BaseLayout
  title="Hard Inquiry Removal | All 3 Bureaus | Inquiry Removal"
  description="Hard inquiry removal across Experian, Equifax, and TransUnion with one-time pricing from $199. Get a free personal review and clear next steps."
  ogTitle="Hard Inquiry Removal: Clear the Pulls Standing in Your Way"
  ogDescription="Nationwide hard inquiry removal across Experian, Equifax, and TransUnion with one-time pricing and a free personal review."
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="hero hero--content dark-section">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow eyebrow--light">
            <span></span> Nationwide service · Experian, Equifax &amp; TransUnion
          </p>
          <h1>{revision.title}</h1>
          <p class="hero-summary">{revision.supporting}</p>
          <div class="button-row">
            <a
              class="button"
              href="#free-review"
              data-event="Guided Review Open"
              data-track="home-hero-guided"
              data-context="homepage"
            >
              {revision.primaryCta} <span>→</span>
            </a>
            <a
              class="text-link text-link--light"
              href="/pricing/"
              data-track="home-hero-pricing"
              data-context="homepage"
            >
              See One-Time Pricing <span>↘</span>
            </a>
          </div>
          <p class="cta-microcopy">
            No Social Security number, credit login or payment details to start.
            Paid plans start at $199, with no monthly fee.
          </p>
          <p class="home-eligibility">
            An accurate, authorized pull generally stays.{" "}
            <a href="/eligibility/">See what’s worth reviewing →</a>
          </p>
        </div>
        <div class="hero-interface" data-reveal>
          <ReportPanel />
          <div class="floating-label floating-label--one">
            <i></i> All three bureaus
          </div>
          <div class="floating-label floating-label--two">
            <i></i> Hard inquiries only
          </div>
        </div>
      </div>
    </section>

    <section class="trust-ribbon" aria-label="Company proof">
      <div class="container trust-grid">
        <div>
          <strong>100,437</strong>
          <span>Hard inquiries removed</span>
        </div>
        <div>
          <strong>1,123</strong>
          <span>Clients served</span>
        </div>
        <div>
          <strong>Since 2015</strong>
          <span>Focused inquiry experience</span>
        </div>
        <div>
          <strong>4.9</strong>
          <span>Average client rating</span>
        </div>
      </div>
      <p class="entity-declaration container">
        Company-reported totals and client rating. Individual results vary.
      </p>
    </section>

    <PageJumpNav
      items={[
        ["Where to start", "#overview"],
        ["Situations", "#situations"],
        ["Why us", "#specialists"],
        ["How it works", "#process"],
        ["Results", "#results"],
        ["Pricing", "#pricing"],
        ["Free review", "#free-review"],
      ]}
    />

    <section class="section obstacle-section" id="overview">
      <div class="container obstacle-grid">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> Before your next application
          </p>
          <h2>Know What’s on Your Report Before You Apply Again</h2>
        </div>
        <div data-reveal>
          <p>
            Your report tells you who checked your credit and when. What it
            may not tell you is which application was behind the check. If
            you’re preparing to apply again, start by matching the lender
            name and date to an application you recognize.
          </p>
          <p>
            One dealership visit can explain several lender names, and an
            unfamiliar name doesn’t automatically mean fraud.{" "}
            <strong>Start with the detail that doesn’t match.</strong>
            {" "}That tells you what to check instead of disputing every entry.
          </p>
          <p>
            If you find an error, you can{" "}
            <a class="inline-link" href="/how-to-dispute-a-hard-inquiry/">
              dispute it yourself for free
            </a>
            . If you’d rather have help sorting several pulls or following up
            across reports, that’s the work we specialize in.
          </p>
          <ul class="check-list obstacle-list">
            <li>
              Note the company name, date and credit bureau for each pull.
            </li>
            <li>
              Compare each entry with the applications and rate checks you remember.
            </li>
            <li>
              Mark the entries you can’t explain or that don’t match your records.
            </li>
          </ul>
          <a class="text-link" href="#situations">
            Find My Situation <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section situation-section" id="situations">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> Situations we handle
            </p>
            <h2>What Kind of Hard Inquiry Are You Seeing?</h2>
          </div>
          <p>
            Start with the description that matches what happened. Each guide
            explains what to look for and when a closer review makes sense.
          </p>
        </div>
        <div class="situation-grid situation-grid--eight" data-reveal>
          {situations.map((situation, index) => (
            <article class="situation-card situation-card--static">
              <span class="card-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="situation-icon" aria-hidden="true">
                <>
                  <>
                    <i />
                    <i />
                  </>
                </>
              </span>
              <strong>{situation.title}</strong>
              <p>{situation.body}</p>
              <a href={situation.href}>
                {situation.link} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))}
        </div>
        <p class="section-link">
          <a class="text-link" href="/situations-we-handle/">
            See Every Situation We Handle <span>→</span>
          </a>
        </p>
      </div>
    </section>

    <section class="specialist-section dark-section" id="specialists">
      <div class="container">
        <p class="eyebrow eyebrow--light centered">
          <span></span> One specialty
        </p>
        <h2 class="specialist-title" data-reveal>
          A Team That Works on Hard Inquiries Only
        </h2>
        <p class="editorial-quote" data-reveal>
          Our hard inquiry removal service does more than send a letter. We
          trace each inquiry in scope to what happened, prepare disputes the
          facts support and check what changed when the replies come back.
        </p>
        <div class="comparison-grid comparison-grid--four" data-reveal>
          <article>
            <p>One specialized focus</p>
            <h3>Inquiry specialists, not a general repair plan</h3>
            <p>
              If your concern is a set of hard pulls, you don’t need to sign up
              for help with collections, late payments or other account issues.
            </p>
          </article>
          <article>
            <p>All three credit bureaus</p>
            <h3>Compare the affected reports together</h3>
            <p>
              One event can show up on more than one report. We match the
              company, date and bureau so you can see how the entries relate.
            </p>
            <a
              class="text-link text-link--light"
              href="/experian-hard-inquiry-removal/"
            >
              Experian guide <span>→</span>
            </a>
            <a
              class="text-link text-link--light"
              href="/equifax-hard-inquiry-removal/"
            >
              Equifax guide <span>→</span>
            </a>
            <a
              class="text-link text-link--light"
              href="/transunion-hard-inquiry-removal/"
            >
              TransUnion guide <span>→</span>
            </a>
          </article>
          <article>
            <p>One-time pricing</p>
            <h3>One price based on the inquiry count</h3>
            <p>
              Before you decide, we’ll confirm which inquiries are included and
              which one-time price applies. There’s no monthly membership.
            </p>
          </article>
          <article class="comparison-featured">
            <p>Continued follow-through</p>
            <h3>Someone to review the reply with you</h3>
            <p>
              A response may confirm a correction, ask for more information or
              leave the entry unchanged. We explain what it means and handle
              the next step as needed under your agreement.
            </p>
          </article>
        </div>

        <article class="founder-story" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> Meet the founder
          </p>
          <h3>Inquiry Removal started with a dealership.</h3>
          <p>
            Robert Garcia knows what it’s like to leave a dealership and find
            several lender inquiries you didn’t expect. It happened to him
            when his financing application went to lenders he hadn’t planned
            to apply with.
          </p>
          <p>
            That experience led Robert to specialize in hard inquiries. He’s
            focused on this work since 2015, helping clients sort out what
            appeared on their reports and what can be done about it.
          </p>
          <strong>Robert Garcia, Founder and Senior Credit Analyst</strong>
          <a class="text-link text-link--light" href="/about/">
            Meet Robert Garcia <span>→</span>
          </a>
        </article>
      </div>
    </section>

    <section class="section process-section" id="process">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> How it works
            </p>
            <h2>How Does Hard Inquiry Removal Work?</h2>
          </div>
          <p>
            The review helps you decide whether to act. If you hire us, we
            handle the paperwork and follow-up so you’re not figuring out each
            letter or response on your own.
          </p>
        </div>
        <div class="process-grid process-grid--four" data-reveal>
          {processSteps.map((step, index) => (
            <article>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))}
        </div>
        <div class="guarantee-note" data-reveal>
          <strong>What you do and what we do</strong>
          <p>
            You tell us what happened and share the responses you receive. We
            keep the inquiry list, prepare the communications and explain what
            each response means for your case.
          </p>
          <a class="text-link" href="/how-it-works/">
            See the Complete Process <span>→</span>
          </a>
        </div>
        <div class="section-cta">
          <a class="button" href="#free-review">
            {revision.primaryCta} <span>→</span>
          </a>
          <p>Talk through what happened before deciding whether to proceed.</p>
        </div>
      </div>
    </section>

    <section class="evidence-section" id="results">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> Results documentation
            </p>
            <h2>How We Confirm What Changed on Your Report</h2>
          </div>
          <p>
            A monitoring alert can tell you to look. To confirm a removal, we
            match the original entry against an updated report or a response
            that identifies the change.
          </p>
        </div>
        <div class="evidence-grid evidence-grid--proof" data-reveal>
          <article class="evidence-document">
            <div class="document-top">
              <span>WHAT WE CHECK</span>
              <span>ILLUSTRATIVE RECORD</span>
            </div>
            <div class="redacted-lines">
              <i></i>
              <i></i>
              <i></i>
              <i></i>
              <i></i>
            </div>
            <div class="document-highlight">
              Company name, inquiry date, affected bureau and the report or
              response that shows what changed.
            </div>
            <p>This illustration does not show a customer’s credit report.</p>
          </article>
          <article class="evidence-story">
            <p class="case-id">COMPANY-REPORTED RESULTS</p>
            <h3>100,437 inquiries removed for 1,123 clients since 2015.</h3>
            <p>
              A removal is a change to an inquiry on a credit report. It isn’t
              the same as a score increase or a lender’s approval decision.
            </p>
            <p class="case-note">
              Individual results vary. Past results do not guarantee future
              removals or credit score changes.
            </p>
            <a class="button" href="/results/">
              How We Document Results <span>→</span>
            </a>
          </article>
        </div>

        <div class="guarantee-note" data-reveal>
          <strong>Already disputed the inquiry?</strong>
          <p>
            Keep the original request and the response. We can look at what
            you sent, what the company said and whether there’s a reason to
            follow up instead of sending the same dispute again.
          </p>
          <a class="text-link" href="#free-review">
            Show Us What Happened <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section pricing-section" id="pricing">
      <div class="container">
        <div class="section-heading centered-heading" data-reveal>
          <p class="eyebrow centered">
            <span></span> One problem. One clear price.
          </p>
          <h2>How Much Does Hard Inquiry Removal Cost?</h2>
          <p>
            <strong>
              Hard inquiry removal costs $199, $299, $399, or $499 with Inquiry
              Removal, depending on the total number of inquiries included.
            </strong>{" "}
            Every plan includes the affected credit bureaus, inquiry
            organization, dispute preparation and submission, response review,
            and continued follow-through.
          </p>
        </div>
        <div class="pricing-grid" data-reveal>
          {plans.map((plan) => (
            <article>
              <p>{plan.name}</p>
              <h3>{plan.price}</h3>
              <strong>One-time price · {plan.rangeLabel} total hard inquiries</strong>
              <p class="plan-best">Best for: {plan.bestFor}</p>
              <ul>
                {PLAN_FEATURES.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <a
                class="button"
                href={`/free-inquiry-review/?plan=${plan.id}`}
                data-track={`home-pricing-${plan.id}`}
              >
                Ask About {plan.name} <span>→</span>
              </a>
            </article>
          ))}
        </div>
        <div class="guarantee-note" data-reveal>
          <strong>Start with an estimate</strong>
          <p>
            Don’t guess which entries are included. We’ll help you confirm
            the total and explain the written terms before you decide.
          </p>
          <a class="text-link" href="/pricing/">
            Compare Hard Inquiry Removal Pricing <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> Questions, answered
          </p>
          <h2>Hard Inquiry Removal Questions</h2>
          <p>
            Straight answers about reports, timing, pricing, authorization, and
            what happens next.
          </p>
          <a class="text-link" href="/faq/">
            See All Hard Inquiry Removal Questions <span>→</span>
          </a>
        </div>
        <div class="faq-list" data-reveal>
          {faqs.map(([question, answer], index) => (
            <details open={index === 0}>
              <>
                <>
                  <summary>
                    {question}
                    <span />
                  </summary>
                  <p>{answer}</p>
                </>
              </>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="intake-section dark-section" id="free-review">
      <div class="container intake-layout">
        <div class="intake-intro" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> Free personal review
          </p>
          <h2>Start Your Free Hard Inquiry Review</h2>
          <p>
            Tell us what you’re seeing and why it concerns you. You can start
            without knowing the exact count or choosing a plan. A specialist
            will follow up to discuss your options.
          </p>
          <div class="intake-security">
            <strong>No sensitive documents needed</strong>
            <span>
              Keep your Social Security number, birth date, credit-report
              login and payment details out of the form.
            </span>
          </div>
        </div>
        <div class="home-review-form" data-reveal>
          <FreeReviewForm
            defaultSource="/"
            defaultContext="homepage-embedded"
          />
        </div>
      </div>
    </section>

    <section class="final-cta dark-section">
      <div class="final-lines" aria-hidden="true">
        <InquiryLine compact />
      </div>
      <div class="container final-content" data-reveal>
        <p class="eyebrow eyebrow--light centered">
          <span></span> Ready when you are
        </p>
        <h2>Find Out Which Hard Inquiries Deserve a Closer Look</h2>
        <p>
          Start with the pull that caught your attention. We’ll help you
          understand what it means, what you can do next and whether it makes
          sense to have us handle the work.
        </p>
        <div class="button-row button-row--center">
          <a
            class="button button--large"
            href="#free-review"
            data-event="Guided Review Open"
            data-track="home-final-guided"
            data-context="homepage"
          >
            {revision.primaryCta} <span>→</span>
          </a>
          <a
            class="text-link text-link--light"
            href="tel:+16023776626"
            data-track="home-final-specialist"
            data-context="homepage"
          >
            Call 602-377-6626 <span>↗</span>
          </a>
        </div>
        <p class="cta-microcopy">
          No payment or plan selection is required to request a review.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
