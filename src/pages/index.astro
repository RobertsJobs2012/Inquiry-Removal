---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import InquiryLine from "../components/InquiryLine.astro";
import ReportPanel from "../components/ReportPanel.astro";

const situations = [
  [
    "01",
    "Dealership",
    "I went to one dealer and found multiple lender inquiries.",
  ],
  ["02", "Identity theft", "I don’t recognize these companies."],
  ["03", "Unauthorized application", "I don’t remember authorizing this pull."],
  [
    "04",
    "Preparing for financing",
    "I want to understand what’s on my reports before applying.",
  ],
  ["05", "Not sure", "I just need someone to review this with me."],
];

const faqs = [
  [
    "Can every hard inquiry be removed?",
    "No. Accurate, authorized inquiries are not automatically removable. We review the circumstances to identify inquiries that may be unauthorized, inaccurate, fraudulent, or otherwise appropriate to dispute.",
  ],
  [
    "Will removing inquiries raise my credit score?",
    "Credit scores are affected by many factors. We do not promise a particular score change or attribute score movement solely to inquiry disputes.",
  ],
  [
    "Can I dispute inquiries myself?",
    "Yes. Consumers can dispute inaccurate credit-report information directly. Our value is specialized review, organization, documentation, process management, and follow-through.",
  ],
  [
    "Do you work with all three bureaus?",
    "Yes. Our process is designed to review inquiry information appearing on Experian, Equifax, and TransUnion reports.",
  ],
];
---

<BaseLayout
  title="Inquiry Removal | Hard Inquiry Specialists"
  description="Specialized review and dispute support for eligible unauthorized, inaccurate, and fraudulent hard inquiries across all three credit bureaus."
  theme="dark"
>
  <Header dark />
  <main>
    <section class="hero dark-section">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-copy" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> Hard inquiry specialists
          </p>
          <h1>Hard inquiries<br />you didn’t authorize?</h1>
          <p class="hero-punchline">That’s all we do.</p>
          <p class="hero-description">
            Inquiry Removal specializes exclusively in reviewing and disputing
            eligible unauthorized, inaccurate, and fraudulent hard inquiries
            across Experian, Equifax, and TransUnion.
          </p>
          <div class="button-row">
            <a class="button" href="/free-inquiry-analysis/"
              >Get My Free Inquiry Analysis <span>→</span></a
            >
            <a class="text-link text-link--light" href="/how-it-works/"
              >See How It Works <span>↘</span></a
            >
          </div>
          <div class="hero-assurance">
            <span>Three-bureau review</span><span>No automatic promises</span
            ><span>Clear next steps</span>
          </div>
        </div>
        <div class="hero-interface" data-reveal>
          <ReportPanel />
          <div class="floating-label floating-label--one">
            <i></i> Case-specific review
          </div>
          <div class="floating-label floating-label--two">
            <i></i> Evidence organized
          </div>
        </div>
      </div>
      <div class="hero-scroll"><span></span> Explore the inquiry path</div>
    </section>

    <section class="trust-ribbon">
      <div class="container trust-grid">
        <div>
          <strong>Hard inquiries only</strong><span>Focused specialization</span
          >
        </div>
        <div>
          <strong>3 bureaus</strong><span>Experian · Equifax · TransUnion</span>
        </div>
        <div>
          <strong>Nationwide</strong><span>Remote review and support</span>
        </div>
        <div>
          <strong>Evidence first</strong><span
            >Claims added only when verified</span
          >
        </div>
      </div>
    </section>

    <section class="section situation-section">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Start with the circumstances</p>
            <h2>Why are the<br />inquiries there?</h2>
          </div>
          <p>
            Select the situation closest to yours. This helps frame the
            review—it does not predetermine eligibility or an outcome.
          </p>
        </div>
        <div class="situation-grid" data-situations>
          {
            situations.map(([number, title, text]) => (
              <button class="situation-card" type="button" aria-pressed="false">
                <span class="card-number">{number}</span>
                <span class="situation-icon" aria-hidden="true">
                  <>
                    <i />
                    <i />
                  </>
                </span>
                <strong>{title}</strong>
                <span>{text}</span>
                <b>
                  Explore <i>→</i>
                </b>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <section class="shotgun-section dark-section">
      <div class="container shotgun-layout">
        <div class="shotgun-copy" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> The dealership effect
          </p>
          <h2>You applied<br /><em>once.</em></h2>
          <p>
            One application can produce multiple reported inquiries when a
            dealership submits information to several potential lenders.
          </p>
          <p class="fine-print">
            Authorization, permissible purpose, and rate-shopping or scoring
            considerations must be evaluated individually.
          </p>
        </div>
        <div class="shotgun-visual" data-reveal>
          <div class="visual-label visual-label--source">
            You <span>1 application</span>
          </div>
          <InquiryLine />
          <div class="visual-label visual-label--dealer">
            Dealer <span>Application routed</span>
          </div>
          <div class="lender-list">
            <span>Lender A</span><span>Lender B</span><span>Lender C</span><span
              >Lender D</span
            ><span>Lender E</span>
          </div>
          <p>Multiple reported inquiries</p>
        </div>
      </div>
    </section>

    <section class="specialist-section dark-section">
      <div class="container">
        <p class="eyebrow eyebrow--light centered">
          <span></span> Generalist → specialist
        </p>
        <div
          class="category-cloud"
          aria-label="Credit reporting categories"
          data-reveal
        >
          <span>Collections</span><span>Late payments</span><span
            >Charge-offs</span
          ><span>Utilization</span><span>Bankruptcies</span><strong
            >INQUIRIES</strong
          ><span>Other issues</span>
        </div>
        <div class="specialist-statement" data-reveal>
          <p>They do everything.</p>
          <h2>We chose one.</h2>
          <p class="editorial-quote">
            “Hard inquiries aren’t one of the things we do. They’re the only
            thing we do.”
          </p>
        </div>
        <div class="comparison-grid" data-reveal>
          <article>
            <p>Broad credit repair</p><h3>Multiple credit categories.</h3><ul>
              <li>Broader programs</li><li>Inquiries among many services</li><li
              >
                General credit workflows
              </li>
            </ul>
          </article>
          <article class="comparison-featured">
            <p>Inquiry Removal</p><h3>Hard inquiries only.</h3><ul>
              <li>Defined inquiry-count packages</li><li>
                Specialized analysis
              </li><li>Dedicated inquiry process</li>
            </ul>
          </article>
        </div>
        <p class="specialist-close">
          If inquiries are the problem, work with the specialists.
        </p>
      </div>
    </section>

    <section class="section eligibility-section">
      <div class="container eligibility-grid">
        <div data-reveal>
          <p class="eyebrow"><span></span> Eligibility</p>
          <h2>Can an inquiry<br />actually be disputed?</h2>
          <p class="lead">
            Some situations warrant a closer review. The facts—not a marketing
            promise—determine the next step.
          </p>
          <a class="text-link" href="/eligibility/"
            >Understand eligibility <span>→</span></a
          >
        </div>
        <div class="eligibility-lists" data-reveal>
          <article>
            <p class="list-label list-label--teal"><i></i> Worth reviewing</p>
            <ul class="check-list">
              <li>You don’t recognize the inquiry.</li><li>
                You did not knowingly authorize it.
              </li><li>Your information may have been used fraudulently.</li><li
              >
                The inquiry may contain inaccurate information.
              </li><li>You question whether there was permissible purpose.</li>
            </ul>
          </article>
          <article>
            <p class="list-label"><i></i> What we don’t promise</p>
            <ul class="plain-list">
              <li>
                Removal of accurate information because you regret applying.
              </li><li>Removal of every inquiry.</li><li>
                A guaranteed credit-score increase.
              </li><li>A predetermined outcome before review.</li>
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="explorer-section">
      <div class="container explorer-card" data-explorer data-reveal>
        <div class="explorer-copy">
          <p class="eyebrow"><span></span> Guided eligibility explorer</p>
          <h2>Start with one question.</h2>
          <p>Do you recognize the company that accessed your credit report?</p>
        </div>
        <div class="explorer-options">
          <button type="button" data-answer="recognize"
            >Yes, I recognize it <span>→</span></button
          >
          <button type="button" data-answer="unknown"
            >No, I don’t recognize it <span>→</span></button
          >
          <button type="button" data-answer="unsure"
            >I’m not sure <span>→</span></button
          >
        </div>
        <div class="explorer-result" data-explorer-result hidden>
          <p class="eyebrow"><span></span> Your next step</p>
          <h3>Your situation may warrant a closer review.</h3>
          <p>
            Recognition is only one part of the analysis. A specialist can help
            organize the inquiry details and understand the surrounding
            circumstances.
          </p>
          <a class="button" href="/free-inquiry-analysis/"
            >Have a Specialist Review My Inquiries <span>→</span></a
          >
          <button type="button" class="reset-link" data-reset>Start over</button
          >
        </div>
      </div>
    </section>

    <section class="section process-section">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> How it works</p><h2>
              A precise process.<br />Clear follow-through.
            </h2>
          </div>
          <p>
            Every inquiry starts with context. Our process moves from review to
            a case-specific strategy and documented follow-through.
          </p>
        </div>
        <div class="process-grid" data-reveal>
          <article>
            <span>01</span><i></i><h3>Review</h3><p>
              We examine the inquiries and the circumstances surrounding them.
            </p>
          </article>
          <article>
            <span>02</span><i></i><h3>Strategy & dispute</h3><p>
              Eligible issues are addressed using a case-specific process.
            </p>
          </article>
          <article>
            <span>03</span><i></i><h3>Follow-through</h3><p>
              Responses and results are tracked through the applicable process.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="evidence-section">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Evidence center</p><h2>
              Real cases.<br /><em>Documented outcomes.</em>
            </h2>
          </div>
          <p>
            The evidence center is being prepared for verified, permissioned
            case documentation. No placeholder result is presented as a client
            outcome.
          </p>
        </div>
        <div class="filter-row" aria-label="Evidence filters">
          <button class="is-active">All</button><button>Dealership</button
          ><button>Identity theft</button><button>Unauthorized</button><button
            >Experian</button
          ><button>Equifax</button><button>TransUnion</button>
        </div>
        <div class="evidence-grid" data-reveal>
          <article class="evidence-document">
            <div class="document-top">
              <span>CASE FILE</span><span>REDACTED</span>
            </div>
            <div class="redacted-lines">
              <i></i><i></i><i></i><i></i><i></i>
            </div>
            <div class="document-highlight">Inquiry outcome documentation</div>
            <p>Client-authorized evidence will appear here.</p>
          </article>
          <article class="evidence-story">
            <p class="case-id">EVIDENCE TEMPLATE · IR-0000</p>
            <h3>Proof before persuasion.</h3>
            <p>
              Each published case will identify the situation, bureaus involved,
              number reviewed or disputed, documented outcome, timeline, and
              documentation status.
            </p>
            <div class="case-timeline">
              <span>Reviewed</span><span>Submitted</span><span>Response</span
              ><span>Documented</span>
            </div>
            <p class="case-note">
              Case data and documentation will be added only after verification
              and client permission.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section class="section pricing-section">
      <div class="container">
        <div class="section-heading centered-heading" data-reveal>
          <p class="eyebrow centered"><span></span> Straightforward pricing</p>
          <h2>One defined package.<br /><em>No endless subscription.</em></h2>
          <p>
            Package scope, payment timing, and service terms remain subject to
            final legal review before launch.
          </p>
        </div>
        <div class="pricing-grid" data-reveal>
          <article>
            <p>Starter</p><h3>$199</h3><strong>1–10 inquiries</strong><ul>
              <li>Three-bureau inquiry review</li><li>
                Defined service scope
              </li><li>Case status updates</li>
            </ul><a href="/free-inquiry-analysis/"
              >Start with an analysis <span>→</span></a
            >
          </article>
          <article class="pricing-featured">
            <span class="popular">Most popular</span><p>Standard</p><h3>
              $299
            </h3><strong>11–30 inquiries</strong><ul>
              <li>Three-bureau inquiry review</li><li>
                Defined service scope
              </li><li>Case status updates</li>
            </ul><a class="button" href="/free-inquiry-analysis/"
              >Start with an analysis <span>→</span></a
            >
          </article>
          <article>
            <p>Elite</p><h3>$499</h3><strong>31+ inquiries</strong><ul>
              <li>Three-bureau inquiry review</li><li>
                Defined service scope
              </li><li>Case status updates</li>
            </ul><a href="/free-inquiry-analysis/"
              >Start with an analysis <span>→</span></a
            >
          </article>
        </div>
      </div>
    </section>

    <section class="transparency-section dark-section">
      <div class="container transparency-grid">
        <div data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> Radical transparency
          </p><h2>Can I do this<br />myself?</h2><p class="yes">Yes.</p>
        </div>
        <div data-reveal>
          <p>
            Consumers can dispute inaccurate credit-report information
            themselves.
          </p><h3>So why hire us?</h3><div class="value-grid">
            <span>Specialized review</span><span>Organization</span><span
              >Documentation</span
            ><span>Process management</span><span>Follow-up</span><span
              >Inquiry experience</span
            >
          </div>
        </div>
      </div>
    </section>

    <section class="section guarantee-founder-section">
      <div class="container dual-feature">
        <article class="guarantee-card" data-reveal>
          <div class="shield" aria-hidden="true">90</div>
          <p class="eyebrow"><span></span> Risk reversal</p>
          <h2>The 90-Day<br />Guarantee</h2>
          <p>
            The final guarantee will explain its trigger, qualifications,
            consumer responsibilities, company responsibilities, and refund
            process in plain language.
          </p>
          <a class="text-link" href="/guarantee/"
            >Read the guarantee framework <span>→</span></a
          >
        </article>
        <article class="founder-card" data-reveal>
          <div class="founder-placeholder">
            <span>Founder photography</span><small>To be supplied</small>
          </div>
          <div>
            <p class="eyebrow eyebrow--light">
              <span></span> Founder authority
            </p><h2>Built from firsthand experience.</h2><p>
              Robert Garcia’s final founder story and substantiated professional
              background will be added here.
            </p><a class="text-link text-link--light" href="/about/"
              >Meet Robert <span>→</span></a
            >
          </div>
        </article>
      </div>
    </section>

    <section class="section faq-section">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow"><span></span> Questions, answered</p><h2>
            Clear answers.<br />No fine-print fog.
          </h2><p>
            Our standards are simple: educate clearly, avoid certainty we cannot
            support, and make the next step understandable.
          </p><a class="text-link" href="/faq/"
            >View all questions <span>→</span></a
          >
        </div>
        <div class="faq-list" data-reveal>
          {
            faqs.map(([question, answer], index) => (
              <details open={index === 0}>
                <>
                  <summary>
                    {question}
                    <span />
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="final-cta dark-section">
      <div class="final-lines" aria-hidden="true"><InquiryLine compact /></div>
      <div class="container final-content" data-reveal>
        <p class="eyebrow eyebrow--light centered">
          <span></span> The path forward
        </p>
        <h2>Understand what belongs.<br /><em>Challenge what doesn’t.</em></h2>
        <p>
          Start with a calm, no-pressure review of the inquiries appearing on
          your reports.
        </p>
        <a class="button button--large" href="/free-inquiry-analysis/"
          >Get My Free Inquiry Analysis <span>→</span></a
        >
      </div>
    </section>
  </main>
  <Footer />

  <script>
    const situationCards = document.querySelectorAll(".situation-card");
    situationCards.forEach((card) =>
      card.addEventListener("click", () => {
        situationCards.forEach((item) =>
          item.setAttribute("aria-pressed", String(item === card)),
        );
      }),
    );

    const explorer = document.querySelector("[data-explorer]");
    const result = explorer?.querySelector("[data-explorer-result]");
    const copy = explorer?.querySelector(".explorer-copy");
    const options = explorer?.querySelector(".explorer-options");
    explorer?.querySelectorAll("[data-answer]").forEach((button) =>
      button.addEventListener("click", () => {
        copy?.setAttribute("hidden", "");
        options?.setAttribute("hidden", "");
        result?.removeAttribute("hidden");
      }),
    );
    explorer?.querySelector("[data-reset]")?.addEventListener("click", () => {
      result?.setAttribute("hidden", "");
      copy?.removeAttribute("hidden");
      options?.removeAttribute("hidden");
    });
  </script>
</BaseLayout>
