---
import BaseLayout from "../layouts/BaseLayout.astro";
import { serviceSchema } from "@/lib/schema";
import AnnouncementBar from "@/src/components/AnnouncementBar.astro";
import Navigation from "@/src/components/Navigation.astro";
import Hero from "@/src/components/Hero.astro";
import TrustStrip from "@/src/components/TrustStrip.astro";
import ProblemMirror from "@/src/components/ProblemMirror.astro";
import Solution from "@/src/components/Solution.astro";
import HowItWorks from "@/src/components/HowItWorks.astro";
import SocialProof from "@/src/components/SocialProof.astro";
import FeatureBento from "@/src/components/FeatureBento.astro";
import Guarantee from "@/src/components/Guarantee.astro";
import FinalCTA from "@/src/components/FinalCTA.astro";
import FAQ from "@/src/components/FAQ.astro";
import Footer from "@/src/components/Footer.astro";
import "../styles/pages/home.css";

---


<BaseLayout
  title="Hard Inquiry Removal Service | Inquiry Removal"
  description="Remove unauthorized hard inquiries from your credit report — all 3 bureaus. 100,437+ deleted since 2015. Free consultation. Flat fee. 100% money-back guarantee."
  canonicalPath="/"
  ogImage="/og/home.png"
  ogImageAlt="Inquiry Removal hard inquiry removal service for Experian, Equifax, and TransUnion."
  schema={serviceSchema}
  pathname={Astro.url.pathname}
>

  <AnnouncementBar />
        <Navigation activePath="/" />
        <main id="main" class="home-page">
          <Hero />
          <TrustStrip />
          <ProblemMirror />
          <Solution />
          <HowItWorks />
          <SocialProof />
          <FeatureBento />
          <Guarantee />
          <FinalCTA />
          <FAQ />
        </main>
        <Footer />
</BaseLayout>
