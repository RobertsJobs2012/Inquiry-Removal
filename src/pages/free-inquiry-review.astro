---
import { editorialPlan } from "../data/editorial";

const revision = editorialPlan["/free-inquiry-review/"];
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import FreeReviewForm from "../components/FreeReviewForm.astro";
import Header from "../components/Header.astro";
import PhoneReviewPanel from "../components/PhoneReviewPanel.astro";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.inquiryremoval.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Free Inquiry Review",
        item: "https://www.inquiryremoval.com/free-inquiry-review/",
      },
    ],
  },
];
---

<BaseLayout
  title="Free Hard Inquiry Review | Inquiry Removal"
  description="Complete a private on-site review of unwanted hard inquiries across Experian, Equifax, and TransUnion, then hear directly from an Inquiry Removal specialist."
  robots="noindex, follow"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="page-hero review-page-hero">
      <div class="container page-hero-grid">
        <div>
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <span>Free Inquiry Review</span>
          </nav>
          <p class="eyebrow eyebrow--light">
            <span></span> A first step, not a commitment
          </p>
          <h1>{revision.title}</h1>
          <p class="hero-summary">{revision.supporting}</p>
          <div class="button-row">
            <a class="button" href="#online-review">
              {revision.primaryCta} <span>↓</span>
            </a>
            <a class="text-link text-link--light" href="tel:+16023776626">
              Call 602-377-6626 <span>↗</span>
            </a>
          </div>
        </div>
        <div class="page-hero-aside">
          <span>No payment required</span>
          <span>No report upload</span>
          <span>Follow-up by phone or email</span>
        </div>
      </div>
    </section>

    <section class="section review-form-section" id="online-review">
      <div class="container native-review-shell">
        <div class="review-form-intro" data-reveal>
          <p class="eyebrow">
            <span></span> Online review request
          </p>
          <h2>Send Your Review Request</h2>
          <p>
            Answer what you can. A specialist will contact you by phone or
            email, whichever you choose, to discuss the removal work. This
            request is free and does not enroll you in a plan.
          </p>
          <div class="review-form-safety">
            <strong>No sensitive documents needed</strong>
            <span>
              Don’t enter your Social Security number, date of birth,
              credit-report login or payment information here.
            </span>
          </div>
        </div>

        <FreeReviewForm />
      </div>
    </section>

    <PhoneReviewPanel
      eyebrow="Prefer a conversation?"
      title="Talk Through the Pulls You’re Unsure About"
      description="Call with whatever you know. We’ll help connect the company names and dates to the events you remember."
    />

    <section class="section review-prep-section">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
            <span></span> Helpful, not required
            </p>
            <h2>What Helps Us Understand Your Situation</h2>
          </div>
          <p>
            You don’t need to track down every detail first. If you have any
            of this information, keep it handy for the conversation.
          </p>
        </div>
        <div class="review-prep-grid" data-reveal>
          <article>
            <span>01</span>
            <h3>The affected reports</h3>
            <p>
              Note which report shows the inquiry. It’s fine if you’re not
              sure whether it appears elsewhere.
            </p>
          </article>
          <article>
            <span>02</span>
            <h3>What happened</h3>
            <p>
              Tell us what doesn’t match: the company name, the date or the
              application you remember making.
            </p>
          </article>
          <article>
            <span>03</span>
            <h3>Any upcoming application</h3>
            <p>
              If you’re working toward a home, vehicle, credit card or business
              loan, tell us what’s coming up and when.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
