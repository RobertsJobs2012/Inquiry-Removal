---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PhoneReviewPanel from "../components/PhoneReviewPanel.astro";

const reviewFormUrl =
  "https://docs.google.com/forms/d/e/1FAIpQLSceniKTv612SZVC6_jf0-vb-5pNaOs-1jrpT9Qv0P5yd-Qchw/viewform";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.inquiryremoval.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Free Inquiry Review",
        item: "https://www.inquiryremoval.com/free-inquiry-review/",
      },
    ],
  },
];
---

<BaseLayout
  title="Free Hard Inquiry Review | Inquiry Removal"
  description="Speak with an Inquiry Removal specialist for a free personal review of unwanted hard inquiries across Experian, Equifax, and TransUnion."
  robots="noindex, follow"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="page-hero review-page-hero">
      <div class="container page-hero-grid">
        <div>
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><span>Free Inquiry Review</span>
          </nav>
          <p class="eyebrow eyebrow--light">
            <span></span> Free personal review
          </p>
          <h1>Let’s Start With What Happened.</h1>
          <p>
            Every inquiry situation begins with context. Tell us what you see,
            what you remember, and what you are working toward next.
          </p>
          <div class="button-row">
            <a class="button" href="#online-review">
              Begin My Free Review <span>↓</span>
            </a>
            <a
              class="text-link text-link--light"
              href="tel:+16023776626"
              aria-label="Call Inquiry Removal at 602-377-6626"
            >
              Prefer to call? <span>↗</span>
            </a>
          </div>
        </div>
        <div class="page-hero-aside">
          <span>No pressure</span>
          <span>All three credit bureaus</span>
          <span>Nationwide service</span>
        </div>
      </div>
    </section>

    <section class="section review-form-section" id="online-review">
      <div class="container review-form-launch">
        <div data-reveal>
          <p class="eyebrow"><span></span> Online review request</p>
          <h2>Start with the facts you already have.</h2>
          <p>
            The secure review form asks for your contact information, the
            reports involved, the approximate inquiry count, and a short
            explanation of what happened.
          </p>
          <a
            class="button button--large"
            href={reviewFormUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track="free-review-primary"
          >
            Open My Free Review Form <span>↗</span>
          </a>
          <p class="review-form-privacy">
            The form opens in Google Forms. Do not provide a Social Security
            number, date of birth, credit-report login, payment information, or
            upload a credit report during this initial review.
          </p>
        </div>
        <aside data-reveal aria-label="What the free review covers">
          <p class="eyebrow"><span></span> What to expect</p>
          <ol>
            <li>
              <span>01</span>
              <div>
                <strong>Complete the focused intake</strong>
                <p>Share only the basic facts needed for an initial review.</p>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <strong>A specialist reviews the situation</strong>
                <p>
                  Your report pattern and circumstances guide the conversation.
                </p>
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <strong>We contact you directly</strong>
                <p>You choose whether you prefer a phone call or email.</p>
              </div>
            </li>
          </ol>
        </aside>
      </div>
    </section>

    <PhoneReviewPanel
      eyebrow="Prefer a conversation?"
      title="Call and talk through your inquiry situation."
      description="A specialist will help you organize the inquiry names, dates, affected credit reports, and circumstances surrounding what happened."
    />

    <section class="section review-prep-section">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Before you call</p>
            <h2>Bring the facts you already have.</h2>
          </div>
          <p>
            You do not need to understand every creditor name or know exactly
            which removal path applies. An estimate is enough to begin.
          </p>
        </div>
        <div class="review-prep-grid" data-reveal>
          <article>
            <span>01</span>
            <h3>The affected reports</h3>
            <p>
              Know whether the inquiries appear on Experian, Equifax,
              TransUnion, or more than one report.
            </p>
          </article>
          <article>
            <span>02</span>
            <h3>What happened</h3>
            <p>
              Think about the application, dealership visit, unfamiliar company,
              duplicate entry, or identity-theft event involved.
            </p>
          </article>
          <article>
            <span>03</span>
            <h3>Your next goal</h3>
            <p>
              Tell us whether you are preparing for a home, vehicle, business
              funding, credit card, or another important application.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
