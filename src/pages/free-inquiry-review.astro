---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PhoneReviewPanel from "../components/PhoneReviewPanel.astro";

const reviewFormAction =
  "https://docs.google.com/forms/d/e/1FAIpQLSceniKTv612SZVC6_jf0-vb-5pNaOs-1jrpT9Qv0P5yd-Qchw/formResponse";
const goals = [
  "A home loan",
  "A vehicle loan",
  "Business financing",
  "Credit cards or other personal credit",
  "Addressing possible identity theft",
  "Improving my overall credit profile",
];
const situations = [
  "A dealership sent my application to multiple lenders",
  "I did not authorize the inquiry",
  "I was told it would be a soft pull",
  "I do not recognize the company",
  "The inquiry appears to be a duplicate",
  "I may be dealing with identity theft",
  "The inquiry belongs to someone else",
  "I authorized it but want it reviewed",
];
const inquiryCounts = ["1–10", "11–30", "31 or more", "I am not sure"];
const bureaus = ["Experian", "Equifax", "TransUnion", "I am not sure"];
const reportCopies = ["Yes", "No", "I need help obtaining them"];
const contactMethods = ["Email", "Phone"];
const contactConsent =
  "I agree that Inquiry Removal may contact me about this free inquiry review using the phone number or email address I provided.";

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.inquiryremoval.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Free Inquiry Review",
        item: "https://www.inquiryremoval.com/free-inquiry-review/",
      },
    ],
  },
];
---

<BaseLayout
  title="Free Hard Inquiry Review | Inquiry Removal"
  description="Complete a private on-site review of unwanted hard inquiries across Experian, Equifax, and TransUnion, then hear directly from an Inquiry Removal specialist."
  robots="noindex, follow"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="page-hero review-page-hero">
      <div class="container page-hero-grid">
        <div>
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a><span>/</span><span>Free Inquiry Review</span>
          </nav>
          <p class="eyebrow eyebrow--light">
            <span></span> Free personal review
          </p>
          <h1>Let’s Start With What Happened.</h1>
          <p>
            Every inquiry situation begins with context. Tell us what you see,
            what you remember, and what you are working toward next.
          </p>
          <div class="button-row">
            <a class="button" href="#online-review">
              Begin My Free Review <span>↓</span>
            </a>
            <a
              class="text-link text-link--light"
              href="tel:+16023776626"
              aria-label="Call Inquiry Removal at 602-377-6626"
            >
              Prefer to call? <span>↗</span>
            </a>
          </div>
        </div>
        <div class="page-hero-aside">
          <span>No pressure</span>
          <span>All three credit bureaus</span>
          <span>Nationwide service</span>
        </div>
      </div>
    </section>

    <section class="section review-form-section" id="online-review">
      <div class="container native-review-shell">
        <div class="review-form-intro" data-reveal>
          <p class="eyebrow"><span></span> Online review request</p>
          <h2>Start with the facts you already have.</h2>
          <p>
            Complete the focused review here. Your answers are sent securely to
            Inquiry Removal so a specialist can review the situation and contact
            you using your preferred method.
          </p>
          <div class="review-form-safety">
            <strong>No sensitive documents needed</strong>
            <span>
              Never enter a Social Security number, date of birth, credit-report
              login, or payment information here.
            </span>
          </div>
        </div>

        <form
          class="native-review-form"
          action={reviewFormAction}
          method="post"
          target="review-form-response"
          data-review-form
          novalidate
          data-reveal
        >
          <input type="hidden" name="fvv" value="1" />
          <input type="hidden" name="pageHistory" value="0" />
          <input type="hidden" name="source_page" data-review-source-page />
          <input
            type="hidden"
            name="source_context"
            data-review-source-context
          />
          <input
            class="review-form-honeypot"
            type="text"
            name="website"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />

          <div class="review-experience-top">
            <span class="review-trust-chip"
              ><i aria-hidden="true">✓</i> Private review</span
            >
            <span class="review-time">About 2 minutes</span>
          </div>
          <div class="form-progress" aria-label="Review form progress">
            <div class="form-progress__copy">
              <span data-review-progress>Step 1 of 4</span>
              <strong data-review-stage>Contact</strong>
            </div>
            <div><i data-review-progress-bar></i></div>
          </div>

          <div data-review-form-body>
            <fieldset
              class="form-step native-review-step is-active"
              data-review-step="1"
              tabindex="-1"
            >
              <legend>How can we reach you?</legend>
              <p>
                Start with the basics. We only use this to respond to your
                review.
              </p>
              <div class="native-contact-grid">
                <label>
                  <span>Full name</span>
                  <input
                    type="text"
                    name="entry.1443643242"
                    autocomplete="name"
                    required
                  />
                </label>
                <label>
                  <span>Best email address</span>
                  <input
                    type="email"
                    name="entry.1525553918"
                    autocomplete="email"
                    inputmode="email"
                    required
                  />
                </label>
                <label>
                  <span>Best phone number</span>
                  <input
                    type="tel"
                    name="entry.330440410"
                    autocomplete="tel"
                    inputmode="tel"
                    required
                  />
                </label>
              </div>
            </fieldset>

            <fieldset
              class="form-step native-review-step"
              data-review-step="2"
              tabindex="-1"
              hidden
            >
              <legend>What are you preparing for?</legend>
              <p>Choose the goal that best matches your situation.</p>
              <div class="choice-grid native-choice-grid">
                {
                  goals.map((goal) => (
                    <label class="form-choice">
                      <input
                        type="radio"
                        name="entry.1481812974"
                        value={goal}
                        required
                      />
                      <span>{goal}</span>
                    </label>
                  ))
                }
              </div>
              <p class="field-heading native-field-heading">
                Which situation best describes what happened?
              </p>
              <div class="choice-grid native-choice-grid">
                {
                  situations.map((situation) => (
                    <label class="form-choice">
                      <input
                        type="radio"
                        name="entry.1677473071"
                        value={situation}
                        required
                      />
                      <span>{situation}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset
              class="form-step native-review-step"
              data-review-step="3"
              tabindex="-1"
              hidden
            >
              <legend>What appears on your reports?</legend>
              <p>Estimates are completely fine for the initial review.</p>
              <p class="field-heading">Approximate inquiry count</p>
              <div class="choice-grid">
                {
                  inquiryCounts.map((count) => (
                    <label class="form-choice">
                      <input
                        type="radio"
                        name="entry.1354254818"
                        value={count}
                        required
                      />
                      <span>{count}</span>
                    </label>
                  ))
                }
              </div>
              <p class="field-heading native-field-heading">
                Which credit reports show the inquiries?
              </p>
              <div class="choice-grid" data-bureau-group>
                {
                  bureaus.map((bureau) => (
                    <label class="form-choice">
                      <input
                        type="checkbox"
                        name="entry.766411755"
                        value={bureau}
                      />
                      <span>{bureau}</span>
                    </label>
                  ))
                }
              </div>
              <p class="field-heading native-field-heading">
                Do you have current copies of the affected reports?
              </p>
              <div class="choice-grid choice-grid--three">
                {
                  reportCopies.map((answer) => (
                    <label class="form-choice">
                      <input
                        type="radio"
                        name="entry.1594186053"
                        value={answer}
                        required
                      />
                      <span>{answer}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset
              class="form-step native-review-step"
              data-review-step="4"
              tabindex="-1"
              hidden
            >
              <legend>How should we contact you?</legend>
              <p>Choose the contact method that works best for you.</p>
              <p class="field-heading">
                How would you prefer that we contact you?
              </p>
              <div class="choice-grid">
                {
                  contactMethods.map((method) => (
                    <label class="form-choice">
                      <input
                        type="radio"
                        name="entry.1559834442"
                        value={method}
                        required
                      />
                      <span>{method}</span>
                    </label>
                  ))
                }
              </div>
              <details class="native-optional-note">
                <summary>Add a note <span>(optional)</span></summary>
                <label class="native-textarea-field">
                  <span>Brief description</span>
                  <textarea
                    name="entry.1182319941"
                    rows="5"
                    placeholder="Anything else you would like us to know?"
                  ></textarea>
                </label>
              </details>
              <label class="consent-check native-consent-check">
                <input
                  type="checkbox"
                  name="entry.1996946225"
                  value={contactConsent}
                  required
                />
                <span>{contactConsent}</span>
              </label>
            </fieldset>

            <p
              class="form-error"
              data-review-error
              aria-live="polite"
              tabindex="-1"
            >
            </p>
            <p
              class="review-auto-note"
              data-review-auto-note
              aria-live="polite"
            >
              Your answers stay here until you submit. You can go back anytime.
            </p>
            <div class="form-controls native-review-controls">
              <button class="reset-link" type="button" data-review-back hidden>
                ← Back
              </button>
              <button class="button" type="button" data-review-next>
                Continue <span>→</span>
              </button>
              <button class="button" type="submit" data-review-submit hidden>
                Submit My Free Review <span>→</span>
              </button>
            </div>
          </div>

          <div
            class="review-form-success"
            data-review-success
            tabindex="-1"
            hidden
          >
            <span aria-hidden="true">✓</span>
            <p class="eyebrow"><span></span> Request received</p>
            <h3>Thank you. Your review is now in our hands.</h3>
            <p>
              Inquiry Removal will review the information and contact you using
              the method you selected. Please do not send sensitive documents or
              account credentials by reply.
            </p>
          </div>
        </form>

        <iframe
          class="review-response-frame"
          name="review-form-response"
          title="Review submission response"
          data-review-response></iframe>
      </div>
    </section>

    <PhoneReviewPanel
      eyebrow="Prefer a conversation?"
      title="Call and talk through your inquiry situation."
      description="A specialist will help you organize the inquiry names, dates, affected credit reports, and circumstances surrounding what happened."
    />

    <section class="section review-prep-section">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Before you call</p>
            <h2>Bring the facts you already have.</h2>
          </div>
          <p>
            You do not need to understand every creditor name or know exactly
            which removal path applies. An estimate is enough to begin.
          </p>
        </div>
        <div class="review-prep-grid" data-reveal>
          <article>
            <span>01</span>
            <h3>The affected reports</h3>
            <p>
              Know whether the inquiries appear on Experian, Equifax,
              TransUnion, or more than one report.
            </p>
          </article>
          <article>
            <span>02</span>
            <h3>What happened</h3>
            <p>
              Think about the application, dealership visit, unfamiliar company,
              duplicate entry, or identity-theft event involved.
            </p>
          </article>
          <article>
            <span>03</span>
            <h3>Your next goal</h3>
            <p>
              Tell us whether you are preparing for a home, vehicle, business
              funding, credit card, or another important application.
            </p>
          </article>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <script>
    import { track } from "@vercel/analytics";

    const reviewForm =
      document.querySelector<HTMLFormElement>("[data-review-form]");
    const reviewSteps = Array.from(
      document.querySelectorAll<HTMLElement>("[data-review-step]"),
    );
    const reviewNext =
      document.querySelector<HTMLButtonElement>("[data-review-next]");
    const reviewBack =
      document.querySelector<HTMLButtonElement>("[data-review-back]");
    const reviewSubmit = document.querySelector<HTMLButtonElement>(
      "[data-review-submit]",
    );
    const reviewError = document.querySelector<HTMLElement>(
      "[data-review-error]",
    );
    const reviewProgress = document.querySelector<HTMLElement>(
      "[data-review-progress]",
    );
    const reviewProgressBar = document.querySelector<HTMLElement>(
      "[data-review-progress-bar]",
    );
    const reviewStage = document.querySelector<HTMLElement>(
      "[data-review-stage]",
    );
    const reviewAutoNote = document.querySelector<HTMLElement>(
      "[data-review-auto-note]",
    );
    const reviewBody = document.querySelector<HTMLElement>(
      "[data-review-form-body]",
    );
    const reviewSuccess = document.querySelector<HTMLElement>(
      "[data-review-success]",
    );
    const reviewResponse = document.querySelector<HTMLIFrameElement>(
      "[data-review-response]",
    );
    const reviewDescription = document.querySelector<HTMLTextAreaElement>(
      "textarea[name='entry.1182319941']",
    );
    const reviewSourcePage = document.querySelector<HTMLInputElement>(
      "[data-review-source-page]",
    );
    const reviewSourceContext = document.querySelector<HTMLInputElement>(
      "[data-review-source-context]",
    );
    const reviewParams = new URLSearchParams(window.location.search);
    const planMap: Record<string, string> = {
      focused: "1–10",
      complete: "11–30",
      extensive: "31 or more",
    };
    const goalMap: Record<string, string> = {
      home: "A home loan",
      vehicle: "A vehicle loan",
      business: "Business financing",
      cards: "Credit cards or other personal credit",
      identity: "Addressing possible identity theft",
      profile: "Improving my overall credit profile",
    };
    const bureauMap: Record<string, string> = {
      experian: "Experian",
      equifax: "Equifax",
      transunion: "TransUnion",
    };
    const situationMap: Record<string, string> = {
      dealership: "A dealership sent my application to multiple lenders",
      unauthorized: "I did not authorize the inquiry",
      "identity-theft": "I may be dealing with identity theft",
      "soft-pull": "I was told it would be a soft pull",
      duplicate: "The inquiry appears to be a duplicate",
      unrecognized: "I do not recognize the company",
      "incorrect-person": "The inquiry belongs to someone else",
      authorized: "I authorized it but want it reviewed",
    };
    const planParam = reviewParams.get("plan")?.toLowerCase() ?? "";
    const goalParam = reviewParams.get("goal")?.toLowerCase() ?? "";
    const bureauParam = reviewParams.get("bureau")?.toLowerCase() ?? "";
    const situationParam = reviewParams.get("situation")?.toLowerCase() ?? "";
    const contextParam =
      reviewParams
        .get("context")
        ?.toLowerCase()
        .replace(/[^a-z0-9-]/g, "") ?? "";
    const requestedSource = reviewParams.get("source") ?? "";
    const safeRequestedSource = /^\/[a-z0-9\-/]*\/$/i.test(requestedSource)
      ? requestedSource
      : "";
    let referrerSource = "";
    try {
      const referrer = new URL(document.referrer);
      if (referrer.origin === window.location.origin)
        referrerSource = referrer.pathname;
    } catch {
      referrerSource = "";
    }
    const sourcePage = safeRequestedSource || referrerSource || "direct";
    const sourceParts = [
      contextParam,
      planMap[planParam] ? `plan-${planParam}` : "",
      goalMap[goalParam] ? `goal-${goalParam}` : "",
      bureauMap[bureauParam] ? `bureau-${bureauParam}` : "",
      situationMap[situationParam] ? `situation-${situationParam}` : "",
    ].filter(Boolean);
    const sourceContext = sourceParts.join("|") || "general";
    let reviewStep = 0;
    let reviewSubmitted = false;
    let reviewStarted = false;
    let reviewAdvanceTimer: number | undefined;
    const reviewStageNames = [
      "Contact",
      "Your situation",
      "Your reports",
      "Final details",
    ];
    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reviewSourcePage) reviewSourcePage.value = sourcePage;
    if (reviewSourceContext) reviewSourceContext.value = sourceContext;

    const selectChoice = (name: string, value: string | undefined) => {
      if (!value) return;
      const field = Array.from(
        reviewForm?.querySelectorAll<HTMLInputElement>(
          `input[name='${name}']`,
        ) ?? [],
      ).find((input) => input.value === value);
      if (field) field.checked = true;
    };

    selectChoice("entry.1354254818", planMap[planParam]);
    selectChoice("entry.1481812974", goalMap[goalParam]);
    selectChoice("entry.766411755", bureauMap[bureauParam]);
    selectChoice("entry.1677473071", situationMap[situationParam]);

    const trackReviewStart = () => {
      if (reviewStarted) return;
      reviewStarted = true;
      track("Review Form Start", {
        page: window.location.pathname,
        source: sourcePage,
        context: sourceContext,
      });
    };

    reviewForm?.addEventListener("focusin", trackReviewStart, { once: true });

    const showReviewStep = (index: number, moveFocus = true) => {
      if (reviewAdvanceTimer) window.clearTimeout(reviewAdvanceTimer);
      reviewStep = Math.max(0, Math.min(index, reviewSteps.length - 1));
      reviewSteps.forEach((step, position) => {
        step.hidden = position !== reviewStep;
        step.classList.toggle("is-active", position === reviewStep);
      });
      if (reviewProgress)
        reviewProgress.textContent = `Step ${reviewStep + 1} of ${reviewSteps.length}`;
      if (reviewStage) reviewStage.textContent = reviewStageNames[reviewStep];
      if (reviewProgressBar)
        reviewProgressBar.style.width = `${((reviewStep + 1) / reviewSteps.length) * 100}%`;
      if (reviewBack) reviewBack.hidden = reviewStep === 0;
      if (reviewNext) {
        reviewNext.hidden = reviewStep === reviewSteps.length - 1;
        reviewNext.disabled = false;
      }
      if (reviewSubmit)
        reviewSubmit.hidden = reviewStep !== reviewSteps.length - 1;
      if (reviewError) reviewError.textContent = "";
      if (reviewAutoNote)
        reviewAutoNote.textContent =
          reviewStep === reviewSteps.length - 1
            ? "Nothing is sent until you select Submit My Free Review."
            : "Your selections stay in place. You can go back anytime.";
      if (moveFocus) reviewSteps[reviewStep]?.focus({ preventScroll: true });
    };

    const reviewStepIsComplete = () => {
      const step = reviewSteps[reviewStep];
      if (!step) return false;

      if (step.querySelector("[data-bureau-group]")) {
        const bureau = step.querySelector(
          "input[name='entry.766411755']:checked",
        );
        if (!bureau) return false;
      }

      return !Array.from(
        step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          "input[required], textarea[required]",
        ),
      ).some((field) => !field.checkValidity());
    };

    const validateReviewStep = () => {
      const step = reviewSteps[reviewStep];
      if (!step) return false;

      if (step.querySelector("[data-bureau-group]")) {
        const bureau = step.querySelector(
          "input[name='entry.766411755']:checked",
        );
        if (!bureau) {
          if (reviewError)
            reviewError.textContent =
              "Choose at least one credit report to continue.";
          step
            .querySelector<HTMLInputElement>("input[name='entry.766411755']")
            ?.focus();
          return false;
        }
      }

      const invalid = Array.from(
        step.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          "input[required], textarea[required]",
        ),
      ).find((field) => !field.checkValidity());

      if (invalid) {
        if (reviewError)
          reviewError.textContent =
            "Complete every required field to continue.";
        invalid.focus();
        return false;
      }

      return true;
    };

    const guideTo = (selector: string) => {
      const target =
        reviewSteps[reviewStep]?.querySelector<HTMLElement>(selector);
      if (!target || prefersReducedMotion) return;
      window.setTimeout(
        () => target.scrollIntoView({ behavior: "smooth", block: "center" }),
        120,
      );
    };

    const scheduleReviewAdvance = () => {
      if (!reviewStepIsComplete()) return;
      if (reviewAdvanceTimer) window.clearTimeout(reviewAdvanceTimer);
      if (reviewAutoNote)
        reviewAutoNote.textContent = "Perfect — moving you forward…";
      if (reviewNext) reviewNext.disabled = true;
      reviewAdvanceTimer = window.setTimeout(
        () => {
          if (reviewNext) reviewNext.disabled = false;
          showReviewStep(reviewStep + 1);
        },
        prefersReducedMotion ? 150 : 520,
      );
    };

    reviewForm?.addEventListener("change", (event) => {
      const field = event.target;
      if (!(field instanceof HTMLInputElement)) return;

      const choice = field.closest<HTMLElement>(".form-choice");
      choice?.classList.add("is-confirmed");
      window.setTimeout(() => choice?.classList.remove("is-confirmed"), 560);

      if (reviewStep === 1 && field.name === "entry.1481812974") {
        guideTo(".native-field-heading");
      }
      if (reviewStep === 1 && field.name === "entry.1677473071") {
        scheduleReviewAdvance();
      }
      if (reviewStep === 2 && field.name === "entry.1354254818") {
        guideTo("[data-bureau-group]");
      }
      if (reviewStep === 2 && field.name === "entry.1594186053") {
        scheduleReviewAdvance();
      }
      if (reviewStep === 3 && field.name === "entry.1559834442") {
        guideTo(".native-consent-check");
      }
    });

    reviewNext?.addEventListener("click", () => {
      if (validateReviewStep()) showReviewStep(reviewStep + 1);
    });
    reviewBack?.addEventListener("click", () => showReviewStep(reviewStep - 1));

    reviewForm?.addEventListener("submit", (event) => {
      if (reviewStep !== reviewSteps.length - 1) {
        event.preventDefault();
        if (validateReviewStep()) showReviewStep(reviewStep + 1);
        return;
      }
      if (!validateReviewStep()) {
        event.preventDefault();
        return;
      }
      const honeypot = reviewForm.elements.namedItem("website");
      if (honeypot instanceof HTMLInputElement && honeypot.value) {
        event.preventDefault();
        return;
      }
      if (reviewDescription) {
        const contextLine = `[Website context: source=${sourcePage}; context=${sourceContext}]`;
        const note = reviewDescription.value.trim();
        if (!note.includes("[Website context:")) {
          reviewDescription.value = note
            ? `${note}\n\n${contextLine}`
            : contextLine;
        }
      }
      reviewSubmitted = true;
      if (reviewSubmit) {
        reviewSubmit.disabled = true;
        reviewSubmit.textContent = "Sending…";
      }
    });

    reviewResponse?.addEventListener("load", () => {
      if (!reviewSubmitted) return;
      reviewSubmitted = false;
      reviewBody?.setAttribute("hidden", "");
      reviewSuccess?.removeAttribute("hidden");
      reviewSuccess?.focus();
      track("Review Form Submitted", {
        page: window.location.pathname,
        source: sourcePage,
        context: sourceContext,
      });
    });

    showReviewStep(0, false);
  </script>
</BaseLayout>
