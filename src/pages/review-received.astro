---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<BaseLayout
  title="Review Request Received | Inquiry Removal"
  description="Your free hard inquiry review request was received by Inquiry Removal."
  robots="noindex, follow"
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="page-hero review-page-hero">
      <div class="container page-hero-grid">
        <div>
          <p class="eyebrow eyebrow--light"><span></span> Request received</p>
          <h1>We Received Your Free Review Request</h1>
          <p>
            A specialist will review what you shared and follow up by the method
            you chose. You haven’t enrolled in a plan or paid for anything.
          </p>
          <div class="button-row">
            <a class="button" href="/">Return to Inquiry Removal <span>→</span></a>
            <a class="text-link text-link--light" href="tel:+16023776626">
              Call Inquiry Removal <span>↗</span>
            </a>
          </div>
        </div>
        <div class="page-hero-aside">
          <span>Request sent</span>
          <span>A specialist will follow up</span>
          <span>No payment required for the review</span>
        </div>
      </div>
    </section>

    <section class="section review-form-section">
      <div class="container">
        <div class="review-form-success" data-review-success>
          <span aria-hidden="true">✓</span>
          <p class="eyebrow"><span></span> What happens next</p>
          <h2>Keep the Inquiry Details Handy</h2>
          <p>
            If you have the company name, date or any response you’ve already
            received, keep it nearby for the conversation. Don’t send a Social
            Security number, birth date, credit-report login or payment details
            by reply. We’ll explain what else we need and how to provide it.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
