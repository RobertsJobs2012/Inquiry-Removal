---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
---

<BaseLayout
  title="Review Request Received | Inquiry Removal"
  description="Your free hard inquiry review request was received by Inquiry Removal."
  robots="noindex, follow"
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="page-hero review-page-hero">
      <div class="container page-hero-grid">
        <div>
          <p class="eyebrow eyebrow--light"><span></span> Request received</p>
          <h1>Your Free Review Request Was Received.</h1>
          <p>
            Thank you. Inquiry Removal will review the information you submitted
            and contact you using the method you selected.
          </p>
          <div class="button-row">
            <a class="button" href="/">Return to Inquiry Removal <span>→</span></a>
            <a class="text-link text-link--light" href="tel:+16023776626">
              Call Inquiry Removal <span>↗</span>
            </a>
          </div>
        </div>
        <div class="page-hero-aside">
          <span>Information received</span>
          <span>Specialist review next</span>
          <span>Personal follow-up</span>
        </div>
      </div>
    </section>

    <section class="section review-form-section">
      <div class="container">
        <div class="review-form-success" data-review-success>
          <span aria-hidden="true">✓</span>
          <p class="eyebrow"><span></span> What happens next</p>
          <h2>We’ll organize the facts and follow up personally.</h2>
          <p>
            Please do not send a Social Security number, date of birth,
            credit-report login, payment information, or other sensitive account
            credentials by reply. If additional information is needed, a
            specialist will explain what to provide and how to provide it.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
