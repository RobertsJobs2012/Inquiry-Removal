---
import BaseLayout from "../../layouts/BaseLayout.astro";
import AnnouncementBar from "@/src/components/AnnouncementBar.astro";
import Footer from "@/src/components/Footer.astro";
import FounderPhotoCard from "@/src/components/FounderPhotoCard.astro";
import Navigation from "@/src/components/Navigation.astro";
import PageHero from "@/src/components/PageHero.astro";
import PremiumIcon from "@/src/components/PremiumIcon.astro";
import { getAllBlogPosts, getBlogPostPath } from "@/lib/blog";

const metadata = {
  robots: {
    index: false,
    follow: true,
  },
  title: {
    absolute: "Inquiry Removal Blog | Hard Inquiry Removal Guides",
  },
  description:
    "Hard inquiry removal guides from Inquiry Removal covering Experian, Equifax, TransUnion, dealership inquiries, identity theft, and credit approval strategy.",
  alternates: {
    canonical: "/blog",
  },
  openGraph: {
    title: "Inquiry Removal Blog | Hard Inquiry Removal Guides",
    description:
      "Hard inquiry removal guides from Inquiry Removal covering Experian, Equifax, TransUnion, dealership inquiries, identity theft, and credit approval strategy.",
    url: "https://www.inquiryremoval.com/blog",
  },
  twitter: {
    title: "Inquiry Removal Blog | Hard Inquiry Removal Guides",
    description:
      "Hard inquiry removal guides from Inquiry Removal covering Experian, Equifax, TransUnion, dealership inquiries, identity theft, and credit approval strategy.",
  },
};

const posts = getAllBlogPosts();

const meta = metadata as any;
import "../../styles/pages/blog-index.css";

---


<BaseLayout
  title={meta.title.absolute}
  description={meta.description}
  canonicalPath={meta.alternates.canonical}
  ogImage="/og/blog.png"
  ogImageAlt="Hard inquiry removal guides and credit report education from Inquiry Removal."
  robots={meta.robots}
  pathname={Astro.url.pathname}
>

  <AnnouncementBar />
        <Navigation activePath="/blog" />
        <main id="main" class="blog-page">
          <PageHero
            id="blog-hero-heading"
            panelClassName="ir-page-hero-panel-founder"
            eyebrow="Inquiry removal guides"
          >
      <Fragment slot="title">
        Practical <span class="ir-gradient-text">Hard Inquiry Removal Guides</span>, Written for People Who Need Answers First.
      </Fragment>
      <Fragment slot="subtitle">
        <p>
                This blog is being structured for bureau-specific guides, dealership inquiry education, identity theft recovery, and approval-focused credit strategy. Full articles will be published here only when the exact website copy is ready.
              </p>
      </Fragment>
      <Fragment slot="actions">
        <a href="/get-started" class="btn btn-primary btn-large">
                  Get My Free Credit Analysis
                </a>
                <a href="/how-it-works" class="btn btn-secondary btn-large">
                  See How It Works →
                </a>
      </Fragment>
            <FounderPhotoCard priority />
          </PageHero>

          <section class="blog-index section-divider" aria-labelledby="blog-index-heading">
            <div class="container">
              <div class="ir-section-head ir-section-head-wide">
                <h2 id="blog-index-heading">Published Guides</h2>
                <p>
                  Articles will appear here after you provide the final approved
                  blog content.
                </p>
              </div>

              {posts.length > 0 ? (
                <div class="blog-card-grid">
                  {posts.map((post) => (
                    <a href={getBlogPostPath(post.slug)} class="blog-card">
                      <span class="ir-icon-surface" aria-hidden="true">
                        <PremiumIcon name="tailoredDispute" size={20} />
                      </span>
                      <span class="blog-card-meta">
                        {post.category} · {post.readTime}
                      </span>
                      <strong>{post.title}</strong>
                      <span>{post.description}</span>
                      <span class="blog-card-link">Read guide →</span>
                    </a>
                  ))}
                </div>
              ) : (
                <div class="blog-empty ir-card-featured">
                  <span class="ir-icon-surface" aria-hidden="true">
                    <PremiumIcon name="tailoredDispute" size={20} />
                  </span>
                  <h3>Article slots are ready.</h3>
                  <p>
                    Once the final article copy is provided, each guide can be
                    dropped into the template with a strong hero, mobile jump
                    links, a desktop table of contents, and clear conversion
                    paths.
                  </p>
                </div>
              )}
            </div>
          </section>
        </main>
        <Footer />
</BaseLayout>
