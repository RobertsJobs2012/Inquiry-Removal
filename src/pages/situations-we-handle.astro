---
import { editorialPlan } from "../data/editorial";
import PracticalContent from "../components/PracticalContent.astro";
const revision = editorialPlan["/situations-we-handle/"];
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import InquiryLine from "../components/InquiryLine.astro";
import PageJumpNav from "../components/PageJumpNav.astro";

const situations = [
  {
    id: "dealership",
    short: "Several pulls after a dealership visit",
    question: "Several Lenders After One Dealership Visit",
    problem: "One dealership visit created a trail of lender inquiries.",
    body: [
      "The dealership may have sent one application to several lenders. Compare the names and dates on your report with the application and any instructions you gave the dealer.",
      "Multiple entries aren’t automatically errors. We can help you find the ones that don’t match the visit or paperwork.",
    ],
    link: "Understand Dealership Hard Inquiries",
    href: "/dealership-inquiries/",
    visual: "split",
  },
  {
    id: "unauthorized",
    short: "I never authorized the inquiry",
    question: "Did a Company Pull Your Credit Without Permission?",
    problem: "A company accessed your credit without your permission.",
    body: [
      "Start with the exact company name and date. Ask what transaction or application prompted the check. The name alone doesn’t tell you why the company accessed your report.",
      "If you still can’t connect the pull to a legitimate reason, we can help you identify what to document before disputing it.",
    ],
    link: "Review a Potentially Unauthorized Pull",
    href: "/unauthorized-inquiries/",
    visual: "unauthorized",
  },
  {
    id: "identity-theft",
    short: "Someone used my identity",
    question: "Did Identity Theft Leave Inquiries Behind?",
    problem: "Applications you never made left hard inquiries behind.",
    body: [
      "An application made in your name can leave an inquiry even if no account was opened. If you suspect fraud, start with the protective steps in the identity theft guide.",
      "Keep a record of the affected report and the application you didn’t make. That helps separate a fraud issue from a lender name you simply don’t recognize.",
    ],
    link: "See the Identity Theft Steps",
    href: "/identity-theft-inquiries/",
    visual: "identity",
  },
  {
    id: "soft-pull",
    short: "I was promised a soft pull",
    question: "Were You Promised a Soft Pull but Received a Hard Inquiry?",
    problem: "A no-impact check became a hard inquiry.",
    body: [
      "You checked a rate, requested a prequalification, or agreed to an eligibility review because you were told it would not affect your credit. Then a hard inquiry appeared.",
      "Save the wording you saw and any application confirmation. The key question is whether the hard pull came from the initial check or a later application you authorized.",
    ],
    link: "Check How a Soft Pull Became Hard",
    href: "/soft-pull-became-hard-inquiry/",
    visual: "soft-hard",
  },
  {
    id: "duplicate",
    short: "The same inquiry appears more than once",
    question: "Does the Same Inquiry Appear More Than Once?",
    problem: "Repeated entries make one event look like many.",
    body: [
      "The same lender on two credit reports isn’t necessarily a duplicate. Compare the company, date and bureau on each entry.",
      "If one bureau appears to list the same pull twice, keep both entries so you can show exactly what looks wrong.",
    ],
    link: "Check for a Duplicate Inquiry",
    href: "/duplicate-inquiries/",
    visual: "duplicate",
  },
  {
    id: "unrecognized",
    short: "I do not recognize the company name",
    question: "Do You See a Creditor Name You Do Not Recognize?",
    problem:
      "The name on your report does not match the business you remember.",
    body: [
      "The company listed on a credit report is not always the business name a consumer remembers. A store card, dealership, financing offer, or online application may appear under the name of a bank or third-party lender.",
      "Match the name and date with the financing offers and applications you remember. If you can’t identify it, we can help you decide what to check next.",
    ],
    link: "Identify an Unfamiliar Company",
    href: "/unrecognized-inquiries/",
    visual: "resolve",
  },
  {
    id: "incorrect-person",
    short: "The inquiry belongs to someone else",
    question: "Does the Inquiry Appear to Belong to Someone Else?",
    problem: "Someone else’s activity may be mixed into your report.",
    body: [
      "An entry may be tied to someone else’s application or to information mixed into your report. Note which details don’t match your records.",
      "If the lender confirms it’s not your application, keep the response. It gives you something specific to point to when you ask for a correction.",
    ],
    link: "Check a Wrong-Person Inquiry",
    href: "/incorrect-person-inquiries/",
    visual: "crossed",
  },
  {
    id: "authorized",
    short: "I applied, but something looks wrong",
    question: "Did You Authorize the Inquiry but Still Want It Removed?",
    problem: "You remember the application but want the inquiry reviewed.",
    body: [
      "An accurate, authorized pull generally stays even if you didn’t open an account. If the lender, date or disclosure doesn’t match what happened, focus on that detail.",
      "We can help you decide whether you’re looking at a reporting issue or an accurate entry that needs no action.",
    ],
    link: "Review an Authorized Inquiry",
    href: "/authorized-inquiry-removal/",
    visual: "review",
  },
  {
    id: "different",
    short: "My situation is different",
    question: "Is Your Situation Different From Everything Listed Here?",
    problem: "Your inquiry problem does not fit neatly into one category.",
    body: [
      "Credit inquiries can come from unusual events that do not fit neatly into one category. You may have several situations happening at once, conflicting information across bureaus, or no idea where a particular inquiry originated.",
      "Start with the entry that concerns you most. You don’t need to classify it or upload a report to request a review.",
    ],
    link: "Tell Us What Happened",
    href: "/free-inquiry-review/?situation=different",
    visual: "focus",
  },
];

const reviewPoints = [
  "Who accessed your credit report",
  "When the inquiry appeared",
  "Which credit bureaus reported it",
  "What you were told before the credit check",
  "Whether one event produced multiple inquiries",
  "Whether you recognize the company or application",
  "Whether identity theft or incorrect information may be involved",
  "Any application or deadline you’re preparing for",
];

const process = [
  [
    "We review your reports and your story",
    "We identify the inquiry names, dates, bureaus, and circumstances. We also discuss how the inquiries are affecting you and what you want to do next.",
  ],
  [
    "We organize the affected inquiries",
    "We connect related inquiries to the event that caused them, separate unrelated situations, and prepare the information needed for the removal process.",
  ],
  [
    "We prepare disputes the facts support",
    "If you hire us, we prepare and send the communications to the appropriate companies and bureaus.",
  ],
  [
    "We review the responses and follow through",
    "You notify us when a bureau, creditor, app, email, or mailed letter reports an update. We review what changed and continue the necessary follow-up under your service agreement.",
  ],
];

const goals = [
  [
    "Prepare for a home purchase",
    "Keep the inquiry name and date handy. If you’re already working with a lender, ask how it wants you to handle a reporting issue during the application.",
  ],
  [
    "Return to the dealership with confidence",
    "Ask whether the dealer will check your credit and send your application to other lenders before you agree to a new check.",
  ],
  [
    "Apply for business funding",
    "Check whether the financing application involves your personal credit, and keep the earlier inquiry records separate from the new application.",
  ],
  [
    "Apply for new credit cards",
    "Save the prequalification terms and final application confirmation. They can help you tell which step triggered a hard pull.",
  ],
  [
    "Recover after identity theft",
    "Follow the protective steps in the identity theft guide. Keep copies of the entries and responses tied to applications you didn’t make.",
  ],
  [
    "Understand a pull without a new application",
    "You don’t need an upcoming loan to investigate an unfamiliar entry. Start with the company, date and report that lists it.",
  ],
];

const faqs = [
  [
    "Can one person have several inquiry situations at the same time?",
    "Yes. One report may contain dealership inquiries, an unfamiliar creditor name, a duplicate entry, and an inquiry connected to an unrelated application. We separate the situations during the free review so each inquiry is connected to the event and removal path that applies to it.",
  ],
  [
    "What if I do not recognize the creditor’s name?",
    "Start by showing us the exact name, date, and bureau listed on your report. The reporting name may belong to the bank or finance company behind a store, dealership, or online offer. We help identify the source before deciding how the inquiry should be handled.",
  ],
  [
    "What if the inquiries appear on different credit reports?",
    "Note which bureaus show the pulls. Experian, Equifax and TransUnion can list different entries. An estimate is enough for the request; we’ll explain which reports to have ready for the review.",
  ],
  [
    "Can you help if the inquiry came from identity theft?",
    "Yes. We can help you review the affected entries and explain what records may be useful. If you think someone used your identity, use the identity theft guide for protective steps you can take now.",
  ],
  [
    "What if I agreed to the credit check at the time?",
    "You can still ask us to check a specific discrepancy. If the entry accurately reflects a legitimate check, it generally stays. If a company, date or disclosure doesn’t match, tell us which detail concerns you.",
  ],
  [
    "What if none of these situations describes my case?",
    "Call for a free review and describe what happened in your own words. Inquiry problems do not always fit a standard category. We review the reports and circumstances rather than forcing your experience into the wrong box.",
  ],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hard Inquiry Situations We Handle",
    provider: {
      "@id": "https://www.inquiryremoval.com/#organization",
    },
    areaServed: "US",
    serviceType:
      "Hard inquiry review by situation across Experian, Equifax, and TransUnion",
    url: "https://www.inquiryremoval.com/situations-we-handle/",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.inquiryremoval.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Situations We Handle",
        item: "https://www.inquiryremoval.com/situations-we-handle/",
      },
    ],
  },
];
---

<BaseLayout
  title="Hard Inquiry Situations | Find Your Path | Inquiry Removal"
  description="Hard inquiry situations include dealership pulls, unauthorized inquiries, identity theft, duplicates, and more. Find the right guide and get a free review."
  ogTitle="What Caused Your Hard Inquiries? We Handle It."
  ogDescription="Find the inquiry situation that matches what happened and start your free review with a nationwide hard inquiry specialist."
  ogImage="/og-situations.jpg"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="situation-hub-hero dark-section">
      <div class="hub-orbit" aria-hidden="true">
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
        <b></b>
      </div>
      <div class="container situation-hub-hero__content" data-reveal>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>Situations We Handle</span>
        </nav>
        <p class="eyebrow eyebrow--light">
          <span></span> Nationwide Service | Experian, Equifax, and TransUnion
        </p>
        <h1>{revision.title}</h1>
        <p class="hero-summary">{revision.supporting}</p>
        <div class="button-row">
          <a class="button" href="#find-situation">
            {revision.primaryCta} <span>↓</span>
          </a>
          <a class="text-link text-link--light" href="/free-inquiry-review/">
            Start My Free Review <span>↗</span>
          </a>
        </div>
        <p class="cta-microcopy">
          You don’t need an exact count or copies of your reports to start.
        </p>
      </div>
    </section>

    <section class="trust-ribbon" aria-label="Company proof">
      <div class="container trust-grid">
        <div>
          <strong>100,437</strong>
          <span>Inquiries removed</span>
        </div>
        <div>
          <strong>1,123</strong>
          <span>Clients served</span>
        </div>
        <div>
          <strong>Since 2015</strong>
          <span>Focused credit experience</span>
        </div>
        <div>
          <strong>All three</strong>
          <span>Major credit bureaus</span>
        </div>
      </div>
    </section>

    <PageJumpNav
      items={[
        ["Find my situation", "#find-situation"],
        ["Situations", "#all-situations"],
        ["Why it matters", "#why-it-matters"],
        ["How it works", "#situation-process"],
        ["Goals", "#goals"],
        ["Questions", "#situation-questions"],
      ]}
    />

    <PracticalContent slug="situations-we-handle" />
    <section class="section hub-selector" id="find-situation">
      <div class="container">
        <div class="section-heading centered-heading" data-reveal>
          <p class="eyebrow centered">
            <span></span> Start with what happened
          </p>
          <h2>What Put the Hard Inquiries on Your Credit Reports?</h2>
          <p>
            Choose the situation that most closely matches your experience. You
            do not need to understand credit-report terminology or know which
            removal process applies.
          </p>
        </div>
        <div class="quick-select-grid" data-reveal>
          {situations.map((situation, index) => (
            <a href={`#${situation.id}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              {situation.short}
              <i>↓</i>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section scenario-section" id="all-situations">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> Match the real story
            </p>
            <h2>What to Check in Each Situation</h2>
          </div>
          <p>
            Each situation has a different clue to look for. Start there, then
            use the guide or ask a specialist if you’re unsure.
          </p>
        </div>
        <div class="scenario-list">
          {situations.map((situation) => (
            <article class="scenario-detail" id={situation.id} data-reveal>
              <div
                class={`scenario-visual scenario-visual--${situation.visual}`}
                aria-hidden="true"
              >
                <>
                  <span class="scenario-line" />
                  <i />
                  <i />
                  <i />
                  <b />
                </>
              </div>
              <div class="scenario-detail__copy">
                <h3>{situation.question}</h3>
                {situation.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                <div class="scenario-actions">
                  <>
                    <a class="text-link" href={situation.href}>
                      {situation.link} <span>→</span>
                    </a>
                    <a href={`/free-inquiry-review/?situation=${situation.id}`}>
                      Start My Free Review →
                    </a>
                  </>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section why-situation-section" id="why-it-matters">
      <div class="container why-situation-grid">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> Details determine the path
          </p>
          <h2>Why Does Your Exact Inquiry Situation Matter?</h2>
          <p class="lead">
            Two inquiries that look similar on a report may have completely
            different stories behind them. A dealership submission,
            identity-theft application, duplicate entry, and unexpected hard
            pull should not be treated like the same event.
          </p>
          <a class="button" href="/free-inquiry-review/">
            Review My Situation <span>→</span>
          </a>
        </div>
        <div class="review-point-grid" data-reveal>
          {reviewPoints.map((point, index) => (
            <div>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <strong>{point}</strong>
              </>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section process-section" id="situation-process">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> Three-bureau process
            </p>
            <h2>How Do We Handle Inquiry Removal Across All Three Bureaus?</h2>
          </div>
          <p>
            We work across Experian, Equifax, and TransUnion. You show us the
            affected reports. If you hire us, we organize the entries, send
            supported disputes and follow up as needed under your agreement.
          </p>
        </div>
        <div class="process-grid process-grid--four" data-reveal>
          {process.map(([title, body], index) => (
            <article>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
        <p class="process-timing">
          Timing depends on the issue and the responses. If you’re on a deadline,
          tell us during the review so we can discuss what’s realistic.
        </p>
        <div class="section-cta">
          <a class="button" href="/free-inquiry-review/">
            Start My Free Review <span>→</span>
          </a>
          <p>No plan or payment is required to request a review.</p>
          <a class="text-link" href="/how-it-works/">
            See How the Hard Inquiry Removal Process Works <span>→</span>
          </a>
          <a class="text-link" href="/pricing/">
            Compare Hard Inquiry Removal Pricing <span>→</span>
          </a>
          <a class="text-link" href="/transunion-hard-inquiry-removal/">
            Read the TransUnion Hard Inquiry Guide <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section goal-section dark-section" id="goals">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow eyebrow--light">
            <span></span> Your next decision
            </p>
            <h2>What to Do Before You Apply Again</h2>
          </div>
          <p>
            An upcoming application changes how urgent your questions feel, not
            whether an entry is accurate. Keep these details handy and tell us
            about your deadline so we can discuss the next step.
          </p>
        </div>
        <div class="goal-grid" data-reveal>
          {goals.map(([title, body], index) => (
            <article>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section faq-section" id="situation-questions">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> Questions, answered
          </p>
          <h2>Questions About the Situations We Handle</h2>
          <p>
            Start with what happened. We will help connect the report entries to
            the right next step.
          </p>
        </div>
        <div class="faq-list" data-reveal>
          {faqs.map(([question, answer], index) => (
            <details open={index === 0}>
              <>
                <summary>
                  {question}
                  <span />
                </summary>
                <p>{answer}</p>
              </>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta dark-section">
      <div class="final-lines" aria-hidden="true">
        <InquiryLine compact />
      </div>
      <div class="container final-content" data-reveal>
        <p class="eyebrow eyebrow--light centered">
          <span></span> Whatever caused the inquiries
        </p>
        <h2>Start With the Inquiry You Can’t Explain</h2>
        <p>
          You do not have to diagnose the issue yourself. We review the company,
          date, report and application facts, then explain whether
          investigation, supported disputes or normal aging is the appropriate
          next step.
        </p>
        <div class="button-row button-row--center">
          <a class="button button--large" href="/free-inquiry-review/">
            Start My Free Review <span>→</span>
          </a>
          <a class="text-link text-link--light" href="/eligibility/">
            See What May Be Disputed <span>→</span>
          </a>
        </div>
        <p class="cta-microcopy">
          A specialist will follow up by phone or email.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
