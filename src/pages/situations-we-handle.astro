---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import InquiryLine from "../components/InquiryLine.astro";
import PageJumpNav from "../components/PageJumpNav.astro";

const situations = [
  {
    id: "dealership",
    short: "The dealership ran my credit everywhere",
    question: "Did a Dealership Send Your Application Everywhere?",
    problem: "One dealership visit created a trail of lender inquiries.",
    body: [
      "You went to one dealership expecting help with one purchase. Afterward, you discovered a list of banks, finance companies, and auto lenders across your credit reports. You may have signed a credit application without realizing how widely it would be distributed, or you may have clearly asked the dealership to limit the submissions.",
      "Inquiry Removal helps you organize the dealership visit, identify the resulting lender inquiries, and begin removing the inquiries you do not want following you.",
    ],
    link: "Remove Dealership Inquiries",
    href: "/dealership-inquiries/",
    visual: "split",
  },
  {
    id: "unauthorized",
    short: "I never authorized the inquiry",
    question: "Did a Company Pull Your Credit Without Permission?",
    problem: "A company accessed your credit without your permission.",
    body: [
      "An unfamiliar hard inquiry can feel like someone entered your financial life without asking. It may come from a lender, landlord, service provider, contractor, financing company, or another business you never authorized to access your report.",
      "We examine the company name, inquiry date, affected bureau, and surrounding circumstances, then handle the removal process for the inquiry appearing on your report.",
    ],
    link: "Remove Unauthorized Inquiries",
    href: "/unauthorized-inquiries/",
    visual: "unauthorized",
  },
  {
    id: "identity-theft",
    short: "Someone used my identity",
    question: "Did Identity Theft Leave Inquiries Behind?",
    problem: "Applications you never made left hard inquiries behind.",
    body: [
      "Identity theft can damage a credit report even when the thief never successfully opens an account. Every attempted application may leave a hard inquiry, creating a visible record of credit-seeking activity that was never yours.",
      "We help connect the fraudulent applications to the inquiries left behind and work through the removal process across every affected credit bureau.",
    ],
    link: "Remove Identity Theft Inquiries",
    href: "/identity-theft-inquiries/",
    visual: "identity",
  },
  {
    id: "soft-pull",
    short: "I was promised a soft pull",
    question: "Were You Promised a Soft Pull but Received a Hard Inquiry?",
    problem: "A no-impact check became a hard inquiry.",
    body: [
      "You checked a rate, requested a prequalification, or agreed to an eligibility review because you were told it would not affect your credit. Then a hard inquiry appeared.",
      "That difference matters. Inquiry Removal reviews what was represented, what you expected, and what was ultimately reported before beginning the removal process.",
    ],
    link: "Remove an Unexpected Hard Pull",
    href: "/soft-pull-became-hard-inquiry/",
    visual: "soft-hard",
  },
  {
    id: "duplicate",
    short: "The same inquiry appears more than once",
    question: "Does the Same Inquiry Appear More Than Once?",
    problem: "Repeated entries make one event look like many.",
    body: [
      "Repeated company names, matching dates, or multiple entries from one financing event can make your inquiry section look more crowded than expected. Duplicates may appear on one report or across multiple reports.",
      "We compare the creditor names, dates, bureau records, and application event so every repeated inquiry can be addressed in the proper context.",
    ],
    link: "Remove Duplicate Inquiries",
    href: "/duplicate-inquiries/",
    visual: "duplicate",
  },
  {
    id: "unrecognized",
    short: "I do not recognize the company name",
    question: "Do You See a Creditor Name You Do Not Recognize?",
    problem:
      "The name on your report does not match the business you remember.",
    body: [
      "The company listed on a credit report is not always the business name a consumer remembers. A store card, dealership, financing offer, or online application may appear under the name of a bank or third-party lender.",
      "We help identify the company behind the inquiry and determine what happened before moving forward with removal.",
    ],
    link: "Remove Unrecognized Inquiries",
    href: "/unrecognized-inquiries/",
    visual: "resolve",
  },
  {
    id: "incorrect-person",
    short: "The inquiry belongs to someone else",
    question: "Does the Inquiry Appear to Belong to Someone Else?",
    problem: "Someone else’s activity may be mixed into your report.",
    body: [
      "An inquiry may appear because of incorrect identifying information, a mixed credit file, a data-entry problem, or another person’s application activity. You should not have to carry an inquiry that has nothing to do with you.",
      "We document the mismatch and handle the inquiry-removal process with the companies and bureaus involved.",
    ],
    link: "Remove Incorrect-Person Inquiries",
    href: "/incorrect-person-inquiries/",
    visual: "crossed",
  },
  {
    id: "authorized",
    short: "I authorized it but want it removed",
    question: "Did You Authorize the Inquiry but Still Want It Removed?",
    problem: "You remember the application but want the inquiry reviewed.",
    body: [
      "You may remember applying for the credit, yet still want the resulting inquiry gone. Perhaps the application never led anywhere, the disclosure was unclear, the inquiry appeared differently than expected, or your goals have changed.",
      "Tell us the complete story. We examine how the inquiry was made, disclosed, and reported, then determine the available removal path.",
    ],
    link: "Review an Authorized Inquiry",
    href: "/authorized-inquiry-removal/",
    visual: "review",
  },
  {
    id: "different",
    short: "My situation is different",
    question: "Is Your Situation Different From Everything Listed Here?",
    problem: "Your inquiry problem does not fit neatly into one category.",
    body: [
      "Credit inquiries can come from unusual events that do not fit neatly into one category. You may have several situations happening at once, conflicting information across bureaus, or no idea where a particular inquiry originated.",
      "You do not need to diagnose the problem before contacting us. Show us the reports, explain what you remember, and let our team sort through the details.",
    ],
    link: "Tell Us What Happened",
    href: "/get-started/?situation=different",
    visual: "focus",
  },
];

const reviewPoints = [
  "Who accessed your credit report",
  "When the inquiry appeared",
  "Which credit bureaus reported it",
  "What you were told before the credit check",
  "Whether one event produced multiple inquiries",
  "Whether you recognize the company or application",
  "Whether identity theft or incorrect information may be involved",
  "What you want to accomplish after removal",
];

const process = [
  [
    "We review your reports and your story",
    "We identify the inquiry names, dates, bureaus, and circumstances. We also discuss how the inquiries are affecting you and what you want to do next.",
  ],
  [
    "We organize the affected inquiries",
    "We connect related inquiries to the event that caused them, separate unrelated situations, and prepare the information needed for the removal process.",
  ],
  [
    "We send the disputes for you",
    "Inquiry Removal prepares and submits the dispute communications to the appropriate companies and credit bureaus. You do not have to build the process alone.",
  ],
  [
    "We review the responses and follow through",
    "You notify us when a bureau, creditor, app, email, or mailed letter reports an update. We review what changed and continue the necessary follow-up under your service agreement.",
  ],
];

const goals = [
  [
    "Prepare for a home purchase",
    "Reduce unwanted inquiry clutter before speaking with mortgage professionals or submitting a new home-loan application.",
  ],
  [
    "Return to the dealership with confidence",
    "Address the inquiry trail from an earlier dealership visit before shopping for another vehicle or financing offer.",
  ],
  [
    "Apply for business funding",
    "Clean up personal-credit inquiries that may be reviewed when you pursue business cards, credit lines, or other financing.",
  ],
  [
    "Apply for new credit cards",
    "Remove inquiries you do not want standing beside an otherwise strong credit profile before your next application.",
  ],
  [
    "Recover after identity theft",
    "Clear inquiry evidence connected to applications you never made and rebuild confidence in what appears on your reports.",
  ],
  [
    "Protect a strong credit profile",
    "You do not need “bad credit” to care about inquiries. Many clients want the rest of their profile represented as cleanly as possible.",
  ],
];

const faqs = [
  [
    "Can one person have several inquiry situations at the same time?",
    "Yes. One report may contain dealership inquiries, an unfamiliar creditor name, a duplicate entry, and an inquiry connected to an unrelated application. We separate the situations during the free review so each inquiry is connected to the event and removal path that applies to it.",
  ],
  [
    "What if I do not recognize the creditor’s name?",
    "Start by showing us the exact name, date, and bureau listed on your report. The reporting name may belong to the bank or finance company behind a store, dealership, or online offer. We help identify the source before deciding how the inquiry should be handled.",
  ],
  [
    "What if the inquiries appear on different credit reports?",
    "Provide current reports from every affected bureau. Experian, Equifax, and TransUnion may display different inquiry names, dates, or entries. Reviewing the affected reports together helps us see the full inquiry pattern and organize the removal process correctly.",
  ],
  [
    "Can you help if the inquiry came from identity theft?",
    "Yes. Identity-theft applications can leave hard inquiries even when no account was opened. Tell us what happened and provide the reports showing the inquiries. We will explain what supporting documentation may be needed and handle the inquiry-removal steps across the affected bureaus.",
  ],
  [
    "What if I agreed to the credit check at the time?",
    "You can still request a free review. We examine the application circumstances, disclosures, company identity, timing, reporting, and what you expected to happen. After reviewing the complete story, we explain the available inquiry-removal path and the next step.",
  ],
  [
    "What if none of these situations describes my case?",
    "Choose “My situation is different” on the free-review form and describe what happened in your own words. Inquiry problems do not always fit a standard category. Our team will review the reports and circumstances rather than forcing your experience into the wrong box.",
  ],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hard Inquiry Removal",
    provider: {
      "@type": "Organization",
      name: "Inquiry Removal",
      url: "https://inquiryremoval.com/",
    },
    areaServed: "US",
    serviceType:
      "Hard inquiry removal across Experian, Equifax, and TransUnion",
    url: "https://inquiryremoval.com/situations-we-handle/",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://inquiryremoval.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Situations We Handle",
        item: "https://inquiryremoval.com/situations-we-handle/",
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map(([question, answer]) => ({
      "@type": "Question",
      name: question,
      acceptedAnswer: { "@type": "Answer", text: answer },
    })),
  },
];
---

<BaseLayout
  title="Hard Inquiry Removal for Every Situation | Inquiry Removal"
  description="Remove hard inquiries caused by dealerships, identity theft, duplicates, unauthorized pulls, and more. Find your situation and get a free review."
  ogTitle="What Caused Your Hard Inquiries? We Handle It."
  ogDescription="Find the inquiry situation that matches what happened and start your free review with a nationwide hard inquiry specialist."
  ogImage="/og-situations.jpg"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="situation-hub-hero dark-section">
      <div class="hub-orbit" aria-hidden="true">
        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><b></b>
      </div>
      <div class="container situation-hub-hero__content" data-reveal>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><span>Situations We Handle</span>
        </nav>
        <p class="eyebrow eyebrow--light">
          <span></span> Nationwide Service | Experian, Equifax, and TransUnion
        </p>
        <h1>Hard Inquiry Removal for the Situations Affecting You</h1>
        <p>
          Hard inquiry removal is not limited to one type of credit problem.
          People come to Inquiry Removal after dealerships send applications to
          multiple lenders, companies run unexpected hard pulls, identity
          thieves apply for credit, duplicate inquiries appear, or unfamiliar
          names show up on their reports. We also help people who remember
          applying but still want their inquiries examined for removal. Find the
          situation that sounds like yours, then get a free review built around
          what actually happened.
        </p>
        <div class="button-row">
          <a class="button" href="/get-started/"
            >Get My Free Inquiry Review <span>→</span></a
          ><a
            class="text-link text-link--light"
            href="/get-started/?start=online"
            >Start My Inquiry Removal Online <span>↘</span></a
          >
        </div>
        <p class="cta-microcopy">
          Tell us what happened. We will respond within 24 hours.
        </p>
      </div>
    </section>

    <section class="trust-ribbon" aria-label="Company proof">
      <div class="container trust-grid">
        <div><strong>100,437</strong><span>Inquiries removed</span></div><div>
          <strong>1,123</strong><span>Clients served</span>
        </div><div>
          <strong>Since 2015</strong><span>Focused credit experience</span>
        </div><div>
          <strong>All three</strong><span>Major credit bureaus</span>
        </div>
      </div>
    </section>

    <PageJumpNav
      items={[
        ["Find my situation", "#find-situation"],
        ["Situations", "#all-situations"],
        ["Why it matters", "#why-it-matters"],
        ["How it works", "#situation-process"],
        ["Goals", "#goals"],
        ["Questions", "#situation-questions"],
      ]}
    />

    <section class="section hub-selector" id="find-situation">
      <div class="container">
        <div class="section-heading centered-heading" data-reveal>
          <p class="eyebrow centered">
            <span></span> Start with what happened
          </p><h2>Which Hard Inquiry Situation Brought You Here?</h2><p>
            Choose the situation that most closely matches your experience. You
            do not need to understand credit-report terminology or know which
            removal process applies.
          </p>
        </div>
        <div class="quick-select-grid" data-reveal>
          {
            situations.map((situation, index) => (
              <a href={`#${situation.id}`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                {situation.short}
                <i>↓</i>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section scenario-section" id="all-situations">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Match the real story</p><h2>
              What Happened to Your Credit Report?
            </h2>
          </div><p>
            Different events can leave similar-looking inquiries behind. The
            right starting point is the real story behind the names, dates, and
            bureau entries on your reports.
          </p>
        </div>
        <div class="scenario-list">
          {
            situations.map((situation) => (
              <article class="scenario-detail" id={situation.id} data-reveal>
                <div
                  class={`scenario-visual scenario-visual--${situation.visual}`}
                  aria-hidden="true"
                >
                  <>
                    <span class="scenario-line" />
                    <i />
                    <i />
                    <i />
                    <b />
                  </>
                </div>
                <div class="scenario-detail__copy">
                  <h3>{situation.question}</h3>
                  {situation.body.map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                  <div class="scenario-actions">
                    <>
                      <a class="text-link" href={situation.href}>
                        {situation.link} <span>→</span>
                      </a>
                      <a href={`/get-started/?situation=${situation.id}`}>
                        Review My Situation →
                      </a>
                    </>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section why-situation-section" id="why-it-matters">
      <div class="container why-situation-grid">
        <div data-reveal>
          <p class="eyebrow"><span></span> Details determine the path</p><h2>
            Why Does Your Exact Inquiry Situation Matter?
          </h2><p class="lead">
            Two inquiries that look similar on a report may have completely
            different stories behind them. A dealership submission,
            identity-theft application, duplicate entry, and unexpected hard
            pull should not be treated like the same event.
          </p><a class="button" href="/get-started/"
            >Review My Situation <span>→</span></a
          >
        </div>
        <div class="review-point-grid" data-reveal>
          {
            reviewPoints.map((point, index) => (
              <div>
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <strong>{point}</strong>
                </>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section process-section" id="situation-process">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow"><span></span> Three-bureau process</p><h2>
              How Does Inquiry Removal Work Across All Three Bureaus?
            </h2>
          </div><p>
            Inquiry Removal works with hard inquiries appearing on Experian,
            Equifax, and TransUnion reports. We build the case around the
            bureaus actually affected and continue reviewing responses as the
            removal process moves forward.
          </p>
        </div>
        <div class="process-grid process-grid--four" data-reveal>
          {
            process.map(([title, body], index) => (
              <article>
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </>
              </article>
            ))
          }
        </div>
        <p class="process-timing">
          Some removals can occur in as little as seven days. Many cases take
          longer, and rare cases can extend to 120 days.
        </p>
        <div class="section-cta">
          <a class="button" href="/get-started/"
            >Get My Free Inquiry Review <span>→</span></a
          ><p>Free review. No monthly fees. Response within 24 hours.</p><a
            class="text-link"
            href="/how-it-works/"
            >See How the Hard Inquiry Removal Process Works <span>→</span></a
          ><a class="text-link" href="/pricing/"
            >Compare Hard Inquiry Removal Pricing <span>→</span></a
          >
        </div>
      </div>
    </section>

    <section class="section goal-section dark-section" id="goals">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow eyebrow--light">
              <span></span> Forward movement
            </p><h2>What Could a Cleaner Inquiry Profile Help You Pursue?</h2>
          </div><p>
            A cleaner inquiry profile can help you move toward the next
            application with fewer unwanted inquiries distracting from the rest
            of your credit history. The goal is to help your profile better
            reflect your real financial behavior.
          </p>
        </div>
        <div class="goal-grid" data-reveal>
          {
            goals.map(([title, body], index) => (
              <article>
                <>
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  <h3>{title}</h3>
                  <p>{body}</p>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="section faq-section" id="situation-questions">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow"><span></span> Questions, answered</p><h2>
            Questions About the Situations We Handle
          </h2><p>
            Start with what happened. We will help connect the report entries to
            the right next step.
          </p>
        </div><div class="faq-list" data-reveal>
          {
            faqs.map(([question, answer], index) => (
              <details open={index === 0}>
                <>
                  <summary>
                    {question}
                    <span />
                  </summary>
                  <p>{answer}</p>
                </>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="final-cta dark-section">
      <div class="final-lines" aria-hidden="true">
        <InquiryLine compact />
      </div><div class="container final-content" data-reveal>
        <p class="eyebrow eyebrow--light centered">
          <span></span> Whatever caused the inquiries
        </p><h2>
          Ready to Remove the Inquiries Connected to Your Situation?
        </h2><p>
          You already know something about the inquiries does not feel right or
          no longer belongs on your reports. Now let a company that focuses
          exclusively on hard inquiry removal review the complete picture.
        </p><div class="button-row button-row--center">
          <a class="button button--large" href="/get-started/"
            >Get My Free Inquiry Review <span>→</span></a
          ><a
            class="text-link text-link--light"
            href="/get-started/?start=online"
            >Start My Inquiry Removal Online <span>→</span></a
          >
        </div><p class="cta-microcopy">
          Tell us what happened. We will respond within 24 hours.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
