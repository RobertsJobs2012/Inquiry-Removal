---
import AnnouncementBar from "@/src/components/AnnouncementBar.astro";
import Footer from "@/src/components/Footer.astro";
import Navigation from "@/src/components/Navigation.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found | Inquiry Removal"
  description="The page you were looking for is no longer available. Start with our main service pages or request a free inquiry analysis."
  canonicalPath="/404/"
  pathname="/404/"
  robots={{ index: false, follow: true }}
>
  <AnnouncementBar />
  <Navigation activePath="/404/" />
  <main id="main" class="section-divider-line">
    <section class="section-divider">
      <div class="container not-found-shell">
        <p class="section-eyebrow">404</p>
        <h1 class="not-found-title">That page is gone, but the site is fine.</h1>
        <p class="not-found-copy">
          Use one of the main routes below to keep moving. The fastest path is usually the
          free analysis.
        </p>
        <div class="not-found-actions">
          <a href="/get-started/" class="btn btn-primary btn-large" data-astro-prefetch>
            Start Free Analysis
          </a>
          <a href="/services/" class="btn btn-secondary btn-large" data-astro-prefetch>
            Browse Services
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<style>
  .not-found-shell {
    padding-block: clamp(5rem, 12vw, 8rem);
    text-align: center;
  }

  .not-found-title {
    max-width: 12ch;
    margin: 0 auto 1rem;
  }

  .not-found-copy {
    max-width: 44rem;
    margin: 0 auto 2rem;
  }

  .not-found-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
</style>
