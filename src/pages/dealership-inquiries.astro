---
import { editorialPlan } from "../data/editorial";
import PracticalContent from "../components/PracticalContent.astro";
const revision = editorialPlan["/dealership-inquiries/"];
import { PRICING_PLANS } from "../data/pricing";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhoneReviewPanel from "../components/PhoneReviewPanel.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageJumpNav from "../components/PageJumpNav.astro";
import { guideReviewDate } from "../data/contentDates";

const reviewed = guideReviewDate("dealership-inquiries");

const painPoints = [
  [
    "Did the dealer send your application to multiple lenders?",
    "You expected the dealership to find a financing option. You did not expect one application to create a row of hard inquiries across your reports.",
  ],
  [
    "Did you ask the dealer not to shop your credit around?",
    "Keep any written instructions and compare them with the authorization you signed. That gives you something specific to ask the dealer or lender about.",
  ],
  [
    "Were you told the first check would be a soft pull?",
    "You expected a prequalification or a credit check that would not affect your score. Instead, one or more hard inquiries appeared.",
  ],
  [
    "Did you leave without buying a vehicle?",
    "Not buying a vehicle doesn’t make a legitimate pull inaccurate. Check whether the lender and date match the financing application you made.",
  ],
  [
    "Do the lender names look unfamiliar?",
    "The company listed on a credit report may be the bank or finance company that received the application, not the dealership name you remember. We help organize those entries and connect them to what happened.",
  ],
  [
    "Did the same dealership visit affect more than one bureau?",
    "Experian, Equifax and TransUnion may show different lenders. Record the bureau next to each entry so you can check what appears where.",
  ],
];

const process = [
  [
    "We review what happened at the dealership",
    "Start with what you signed, what the dealer told you and the inquiries you found. We’ll help you decide whether any entry warrants follow-up.",
  ],
  [
    "We examine every affected credit report",
    "We review the dealership-related entries on Experian, Equifax, and TransUnion. If all three reports are affected, we need all three so nothing is overlooked.",
  ],
  [
    "We connect the lender names to the dealership visit",
    "We match the names and dates with the financing paperwork. That helps separate an expected lender from an entry that doesn’t fit.",
  ],
  [
    "We prepare and send the disputes",
    "If you hire us, we prepare and send the disputes supported by the facts. You don’t have to write them or work out where they go.",
  ],
  [
    "You tell us when a response arrives",
    "You may receive updates through a credit-monitoring app, email, or mail. Send us what you receive, and we will explain what changed and what comes next.",
  ],
  [
    "We verify removals and continue the follow-through",
    "We compare replies and updated reports with the original entries. If another step is warranted, we handle it as needed under your agreement.",
  ],
];

const reasons = [
  [
    "Hard inquiries are our only specialty",
    "You can get help with the dealership pulls without signing up for work on unrelated account issues.",
  ],
  [
    "We work across all three credit bureaus",
    "We handle affected inquiries on Experian, Equifax, and TransUnion so the process is not limited to a single report.",
  ],
  [
    "We do the dispute work for you",
    "We prepare and send the disputes. You keep us informed when responses arrive, and we tell you what each update means.",
  ],
  [
    "We include the follow-through",
    "The process does not stop after one letter. We continue with additional rounds as needed under your service agreement.",
  ],
  [
    "We charge one time, not every month",
    "Your plan is based on the total number of inquiries involved. There is no recurring monthly membership.",
  ],
  [
    "We understand the dealership problem personally",
    "The company exists because Robert went through the same frustration. That experience still shapes how every dealership inquiry case is reviewed.",
  ],
];

const faqs = [
  [
    "Can you review dealership inquiries across all three bureaus?",
    "Yes. We can review affected Experian, Equifax and TransUnion reports together. Whether any entry warrants a dispute depends on what it shows and what happened.",
  ],
  [
    "What if the dealership ran my credit multiple times?",
    "List each company, date and bureau, then compare them with the application. We can help check which pulls are explained by that visit and which don’t match.",
  ],
  [
    "Why are banks listed when I only visited a dealership?",
    "The dealership may have sent your credit application to banks or finance companies while looking for financing. Those lenders can appear by their own names on your reports, even if you never spoke with them directly.",
  ],
  [
    "Do multiple auto-loan inquiries count as one inquiry?",
    "Some scoring models may group qualifying auto-loan inquiries made within a short rate-shopping window for score calculation. The individual inquiries may still appear separately on your credit reports, which is why consumers can see several lender names after one dealership visit.",
  ],
  [
    "Can you help if I bought the vehicle?",
    "Yes. Purchasing the vehicle does not prevent us from reviewing the dealership inquiries you want removed. We look at the complete situation, the affected reports, and what happened during the financing process.",
  ],
  [
    "What if I remember agreeing to a credit check?",
    "If the pull is accurate and legitimate, it generally stays. If the inquiry doesn’t match what you signed or what the dealer told you, bring the specific discrepancy to the review.",
  ],
  [
    "Do I have to contact the dealership or send the disputes myself?",
    "No. Inquiry Removal prepares and sends the disputes for you. We may ask you for information about the dealership visit or for copies of the responses you receive.",
  ],
  [
    "How quickly can dealership inquiries be removed?",
    "It depends on the evidence and when the companies or bureaus respond. Tell us about your deadline during the free review. We can discuss what’s realistic but can’t promise a removal date.",
  ],
  [
    "What if I do not have all three credit reports yet?",
    "Start with the free inquiry review. We will help you understand which reports are needed based on where the dealership inquiries appear.",
  ],
  [
    "Is dealership inquiry removal a monthly service?",
    "No. Pricing is one time and starts at $199. There are no monthly service fees.",
  ],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Dealership Inquiry Removal",
    serviceType: "Hard Inquiry Removal",
    provider: { "@id": "https://www.inquiryremoval.com/#organization" },
    areaServed: { "@type": "Country", name: "United States" },
    audience: {
      "@type": "Audience",
      audienceType: "Consumers with unwanted dealership-related hard inquiries",
    },
    url: "https://www.inquiryremoval.com/dealership-inquiries/",
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.inquiryremoval.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Situations We Handle",
        item: "https://www.inquiryremoval.com/situations-we-handle/",
      },
      {
        "@type": "ListItem",
        position: 3,
        name: "Dealership Inquiries",
        item: "https://www.inquiryremoval.com/dealership-inquiries/",
      },
    ],
  },
];
---

<BaseLayout
  title="Dealership Inquiry Removal | 3 Bureaus | Inquiry Removal"
  description="Dealership inquiry removal for unwanted hard pulls across Experian, Equifax, and TransUnion. One-time service. Get a free dealership inquiry review."
  ogTitle="Car Dealership Ran Your Credit Multiple Times?"
  ogDescription="Understand dealership inquiry clusters and get a free specialist review across all three credit reports."
  ogImage="/og-dealership-inquiries.jpg"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="dealer-hero dark-section">
      <div class="container dealer-hero__grid">
        <div class="dealer-hero__copy" data-reveal>
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span>/</span>
            <a href="/situations-we-handle/">Situations We Handle</a>
            <span>/</span>
            <span>Dealership Inquiries</span>
          </nav>
          <p class="eyebrow eyebrow--light">
            <span></span> Dealership Inquiry Removal
          </p>
          <h1>{revision.title}</h1>
          <p class="hero-summary">{revision.supporting}</p>
          <div class="button-row">
            <a
              class="button button--large"
              href="/free-inquiry-review/?situation=dealership#online-review"
              data-track="dealer-hero-review"
            >
              {revision.primaryCta} <span>→</span>
            </a>
            <a class="text-link text-link--light" href="#dealership-overview">
              Why So Many Pulls? <span>↓</span>
            </a>
          </div>
          <p class="cta-microcopy">
            The review is free. Multiple entries or leaving without a vehicle
            do not, by themselves, make a pull inaccurate.
          </p>
        </div>

        <div
          class="dealer-inquiry-visual"
          aria-label="One dealership application branching into several lender inquiries across Experian, Equifax, and TransUnion"
          data-reveal
        >
          <div class="dealer-application">
            <span>01</span>
            <strong>One application</strong>
          </div>
          <div class="dealer-lender-lines" aria-hidden="true">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <div class="dealer-bureaus">
            <div>
              <span>E</span>
              <strong>Experian</strong>
              <i></i>
              <i></i>
              <i></i>
            </div>
            <div>
              <span>EQ</span>
              <strong>Equifax</strong>
              <i></i>
              <i></i>
            </div>
            <div>
              <span>TU</span>
              <strong>TransUnion</strong>
              <i></i>
              <i></i>
              <i></i>
            </div>
          </div>
          <p>
            One visit → several lender inquiries → one focused removal process
          </p>
        </div>
      </div>
    </section>

    <section class="trust-ribbon dealer-trust" aria-label="Company proof">
      <div class="container trust-grid">
        <div>
          <strong>100,437</strong>
          <span>Inquiries removed</span>
        </div>
        <div>
          <strong>1,123</strong>
          <span>Clients served</span>
        </div>
        <div>
          <strong>Since 2015</strong>
          <span>Inquiry specialists</span>
        </div>
        <div>
          <strong>4.9</strong>
          <span>Client rating</span>
        </div>
      </div>
    </section>

    <PageJumpNav
      items={[
        ["What happened", "#dealership-overview"],
        ["How it works", "#process"],
        ["Why choose us", "#why-dealership"],
        ["Free review", "#free-review"],
        ["Questions", "#dealership-faq"],
      ]}
    />

    <PracticalContent slug="dealership-inquiries" />
    <section class="section dealer-pain-section" id="dealership-overview">
      <div class="container">
        <div class="section-heading split-heading" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> One application, many names
            </p>
            <h2>Why Did One Dealership Visit Create So Many Hard Inquiries?</h2>
          </div>
          <div>
            <p>
              A dealership may send one credit application to several lenders
              while looking for financing, and each lender that accesses a
              credit report may appear as a separate hard inquiry.
            </p>
            <p>
              If the report lists a bank you don’t recognize, ask the dealer
              which lenders received your application. Compare that list with
              the report before assuming a pull was unauthorized.
            </p>
          </div>
        </div>
        <div class="dealer-pain-grid">
          {painPoints.map(([title, body], index) => (
            <article data-reveal>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
        <div class="dealer-inline-cta" data-reveal>
          <div>
            <strong>Tell us what happened at the dealership.</strong>
            <p>
              We will review it with you for free and connect it to the other{" "}
              <a href="/situations-we-handle/">
                hard inquiry situations we handle
              </a>
              .
            </p>
          </div>
          <a class="button" href="/free-inquiry-review/?situation=dealership#online-review">
            {revision.primaryCta} <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section dealer-founder-section dark-section">
      <div class="container dealer-founder-grid">
        <div class="dealer-founder-mark" aria-hidden="true" data-reveal>
          <span>RG</span>
          <i></i>
          <i></i>
          <i></i>
        </div>
        <div data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> Why Inquiry Removal exists
          </p>
          <h2>Why Was Inquiry Removal Created?</h2>
          <p>
            Founder Robert Garcia went to one dealership and found several
            lenders on his reports. That experience led him to build a
            service focused on hard inquiries.
          </p>
          <blockquote>
            “I went to a dealership and specifically asked them not to send my
            application everywhere. They did it anyway. The inquiries appeared,
            my score dropped by about 100 points, and suddenly I could not get
            approved for things I had qualified for before. I had worked hard
            for excellent credit, but lenders were still looking at the number
            of inquiries. I started Inquiry Removal so other people would have a
            specialist to call when the same thing happened to them.”
          </blockquote>
          <p class="dealer-founder-attribution">
            <strong>Robert Garcia</strong>
            <span>Founder and Senior Credit Analyst</span>
          </p>
          <p>
            Today, that means tracing the lender entries back to the visit
            before deciding what to dispute. Robert’s account describes his
            experience, not a typical score change or a promised result.
          </p>
          <a class="button" href="#free-review">
            See How to Call Us <span>↓</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section dealer-process-section" id="process">
      <div class="container">
        <div class="dealer-process-heading" data-reveal>
          <p class="eyebrow">
            <span></span> Review to follow-through
          </p>
          <h2>How We Review and Dispute Dealership Hard Inquiries</h2>
          <p class="lead">
            We start by tracing each pull to the application. If we find a
            reason to dispute an entry and you hire us, we handle the
            paperwork and follow-up.
          </p>
        </div>
        <div class="dealer-process-list">
          {process.map(([title, body], index) => (
            <article data-reveal>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <>
                    <h3>{title}</h3>
                    <p>{body}</p>
                  </>
                </div>
              </>
            </article>
          ))}
        </div>
        <div class="dealer-time-pricing" data-reveal>
          <div>
            <p class="eyebrow">
              <span></span> Timing varies
            </p>
            <h3>How long can dealership inquiry removal take?</h3>
            <p>
              Different lenders may respond at different times. If a reply
              calls for more information, follow-up can take longer. Tell us
              about any upcoming application during your review.
            </p>
          </div>
          <div>
            <p class="eyebrow">
              <span></span> One-time pricing
            </p>
            <h3>Pricing based on your total inquiry count</h3>
            <ul>
              {PRICING_PLANS.map((plan) => (
                <li>
                  <strong>{plan.rangeLabel} inquiries</strong>
                  <span>{plan.price} one time</span>
                </li>
              ))}
              <li>
                <strong>Monthly fees</strong>
                <span>$0</span>
              </li>
            </ul>
            <a class="text-link" href="/pricing/">
              View All Pricing <span>→</span>
            </a>
          </div>
        </div>
        <div class="section-cta">
          <a class="button" href="/free-inquiry-review/?situation=dealership#online-review">
            {revision.primaryCta} <span>→</span>
          </a>
          <p>
            Not sure how many inquiries you have? We will help you count them.
          </p>
        </div>
      </div>
    </section>

    <section class="section rate-shopping-section">
      <div class="container rate-shopping-grid">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> What “counted as one” means
          </p>
          <h2>Will Rate Shopping Make the Dealership Inquiries Disappear?</h2>
          <p class="rate-answer">No.</p>
        </div>
        <div data-reveal>
          <p>
            Some credit-scoring models may group qualifying auto-loan inquiries
            made within a short shopping window when calculating a score, but
            the individual lender inquiries can still remain visible on the
            credit reports.
          </p>
          <p>
            <strong>
              “Counted as one” does not necessarily mean “shown as one.”
            </strong>{" "}
            A future lender reviewing the report can still see the individual
            inquiry entries, dates, and creditor names that appear in the file.
          </p>
          <p>
            Check the report entry and the score separately. A change to one
            doesn’t tell you exactly what will happen to the other. We focus
            on whether the inquiry accurately reflects what happened.
          </p>
          <p>
            Learn more about{" "}
            <a class="inline-link" href="/how-it-works/">
              how the inquiry removal process works
            </a>
            .
          </p>
        </div>
      </div>
      <div class="container next-goal-card" data-reveal>
        <div>
          <p class="eyebrow eyebrow--light">
            <span></span> Your next move
          </p>
          <h3>
            Have Another Application Coming Up?
          </h3>
          <p>
            Tell us when you plan to apply and which entries concern you. We’ll
            explain what you can check now and whether follow-up makes sense,
            without promising a change by your deadline.
          </p>
        </div>
        <a class="button" href="/free-inquiry-review/?situation=dealership#online-review">
          {revision.primaryCta} <span>→</span>
        </a>
      </div>
    </section>

    <section class="section dealer-why-section" id="why-dealership">
      <div class="container">
        <div class="dealer-why-heading" data-reveal>
          <p class="eyebrow">
            <span></span> Focused on this problem
          </p>
          <h2>Why Choose Inquiry Removal for Dealership Inquiries?</h2>
          <p class="lead">
            You don’t have to explain the same visit to several lenders on
            your own. We organize the affected entries together and tell you
            what each response means.
          </p>
        </div>
        <div class="dealer-why-grid">
          {reasons.map(([title, body], index) => (
            <article data-reveal>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
      </div>
    </section>

    <PhoneReviewPanel
      title="Talk Through the Dealership Visit"
      description="Call with the details you have: when you visited, which lenders appeared and what you remember agreeing to. An exact count isn’t necessary."
    />

    <section class="section faq-section dealer-faq-section" id="dealership-faq">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> Questions, answered
          </p>
          <h2>Dealership Inquiry Removal Questions, Answered</h2>
          <p>
            Each affected report may show a different lender list. Review the
            <a class="inline-link" href="/situations-we-handle/">
              hard inquiry situations we handle
            </a>{" "}
            or see the complete{" "}
            <a class="inline-link" href="/how-it-works/">
              inquiry removal process
            </a>
            .
          </p>
        </div>
        <div class="faq-list" data-reveal>
          {faqs.map(([question, answer]) => (
            <details>
              <>
                <summary>
                  {question}
                  <span aria-hidden="true" />
                </summary>
                <p>{answer}</p>
              </>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta dark-section dealer-final-cta">
      <div class="container" data-reveal>
        <p class="eyebrow eyebrow--light centered">
          <span></span> Move forward with a cleaner inquiry profile
        </p>
        <h2>Find Out Which Pulls Trace Back to the Dealer</h2>
        <p>
          Start with the lender names you don’t recognize. We’ll help you
          separate what the visit explains from what deserves a closer look.
        </p>
        <div class="button-row button-row--center">
          <a class="button button--large" href="/free-inquiry-review/?situation=dealership#online-review">
            {revision.primaryCta} <span>→</span>
          </a>
          <a class="text-link text-link--light" href="tel:+16023776626">
            Call 602-377-6626 <span>↗</span>
          </a>
        </div>
        <p class="cta-microcopy">
          No payment or plan selection is required to request a review.
        </p>
        <p class="dealer-closing-trust">
          Nationwide service <span>•</span> Experian, Equifax, and TransUnion{" "}
          <span>•</span> Inquiry-focused experience since 2015
        </p>
        <p class="last-reviewed">
          Page updated{" "}
          <time datetime={reviewed.iso}>{reviewed.label}</time>.
          Robert Garcia, Founder and Senior Credit Analyst.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
