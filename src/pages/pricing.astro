---
import { editorialPlan } from "../data/editorial";
import PracticalContent from "../components/PracticalContent.astro";
const revision = editorialPlan["/pricing/"];
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PageJumpNav from "../components/PageJumpNav.astro";
import {
  PRICING_PLANS as plans,
  PLAN_FEATURES as planFeatures,
} from "../data/pricing";

const included = [
  [
    "A personal inquiry review",
    "We review the affected reports with you and explain which inquiries are in scope and why.",
  ],
  [
    "Experian, Equifax, and TransUnion as needed",
    "There is no separate plan for each bureau. We work with every affected report included in your service.",
  ],
  [
    "One list for all affected reports",
    "We record the company, date and bureau for each inquiry so you know what we’re working on.",
  ],
  [
    "Disputes prepared and sent for you",
    "We prepare supported disputes for the appropriate companies and bureaus. You don’t have to write the letters or work out where to send them.",
  ],
  [
    "Every response reviewed",
    "Share the letters, emails or alerts you receive. We check them against your inquiry list and explain what changed, if anything.",
  ],
  [
    "Continued follow-through",
    "If a response calls for another step, we handle the follow-up as needed under your written agreement.",
  ],
  [
    "Direct communication",
    "Updates happen by phone, text, or email. There is no client portal, dashboard, or login requirement.",
  ],
];

const countingSteps = [
  [
    "Count the inquiry entries you want reviewed",
    "Look at the hard inquiry section of each affected report. Estimate how many entries you want us to review, even if you don’t recognize every company.",
  ],
  [
    "Include every affected report",
    "Note which of Experian, Equifax and TransUnion show the entries. You don’t need to upload your reports to request the free review.",
  ],
  [
    "Choose “I am not sure” when needed",
    "Creditor names can be unfamiliar, and one event may create several inquiries. You do not need to determine the final count before contacting us.",
  ],
  [
    "We confirm the correct plan before you begin",
    "We confirm which entries are in scope and which price applies. The written agreement explains the work, your responsibilities and the payment terms.",
  ],
];

const comparisonRows = [
  ["One-time price", ...plans.map((plan) => plan.price)],
  [
    "Total hard inquiries",
    ...plans.map((plan) => (plan.id === "extensive" ? "31+" : plan.range)),
  ],
  ...[
    "All affected bureaus",
    "Personal inquiry review",
    "Inquiry list organization",
    "Dispute preparation and submission",
    "Response review",
    "Additional rounds as needed",
    "Phone, text, or email updates",
  ].map((label) => [label, ...plans.map(() => "Included")]),
  ["Monthly fee", ...plans.map(() => "None")],
];

const faqs = [
  [
    "Is the price monthly or one time?",
    "Every Inquiry Removal plan has a one-time price. Focused Removal is $199, Expanded Removal is $299, Complete Removal is $399, and Extensive Removal is $499. The service does not become a monthly membership when responses or additional rounds take longer.",
  ],
  [
    "Is the price charged separately for each credit bureau?",
    "No. Each plan includes all affected credit bureaus needed for the inquiry count and service scope. If Experian, Equifax, and TransUnion are affected, the included work covers all three reports rather than creating three separate bureau subscriptions.",
  ],
  [
    "What if I do not know how many inquiries I have?",
    "Choose the free inquiry review instead of guessing. Provide the affected reports and explain what happened. We organize the inquiry entries, confirm the total included count, and tell you which one-time plan matches the service.",
  ],
  [
    "Does the price include additional removal rounds?",
    "Yes. Inquiry Removal does not impose a one-round cutoff. We review incoming responses and continue with additional rounds as needed under the signed service agreement. The agreement defines client responsibilities and when the service is considered complete.",
  ],
  [
    "How do I begin?",
    "Start with a free personal review. A specialist will discuss the situation, help organize the inquiry count, and explain which one-time plan matches the service before you decide how to proceed.",
  ],
  [
    "Can I request a free review before choosing a plan?",
    "Yes. You can ask us to check the count or explain a plan before you choose. A free review request does not enroll you or require payment.",
  ],
];

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    name: "Hard Inquiry Removal",
    serviceType: "Hard inquiry removal across affected credit reports",
    provider: {
      "@id": "https://www.inquiryremoval.com/#organization",
    },
    areaServed: "US",
    url: "https://www.inquiryremoval.com/pricing/",
    offers: plans.map((plan) => ({
      "@type": "Offer",
      name: plan.name,
      description: `${plan.rangeLabel} total hard inquiries. One-time pricing; all affected credit bureaus included.`,
      price: plan.price.replace("$", ""),
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: `https://www.inquiryremoval.com/free-inquiry-review/?plan=${plan.id}`,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: "https://www.inquiryremoval.com/",
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Pricing",
        item: "https://www.inquiryremoval.com/pricing/",
      },
    ],
  },
];
---

<BaseLayout
  title="Hard Inquiry Removal Pricing and Plans | Inquiry Removal"
  description="Compare one-time hard inquiry removal plans: 1–10 for $199, 11–20 for $299, 21–30 for $399, and 31+ for $499. No monthly fees. Request a free review."
  ogTitle="Hard Inquiry Removal Starting at $199"
  ogDescription="Choose one clear plan based on your total inquiries. One-time pricing, all affected bureaus, and no monthly fees."
  ogImage="/og-pricing.jpg"
  {schema}
  theme="dark"
>
  <Header dark />
  <main id="main-content" tabindex="-1">
    <section class="pricing-hero dark-section">
      <div class="container pricing-hero__content" data-reveal>
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span>/</span>
          <span>Pricing</span>
        </nav>
        <p class="eyebrow eyebrow--light">
          <span></span> Four plans · No monthly fees
        </p>
        <h1>{revision.title}</h1>
        <p class="hero-summary">{revision.supporting}</p>
        <div class="button-row">
          <a
            class="button button--large"
            href="/free-inquiry-review/"
            data-track="pricing-hero-start"
          >
            {revision.primaryCta} <span>→</span>
          </a>
          <a
            class="text-link text-link--light"
            href="#plans"
            data-track="pricing-hero-review"
          >
            Compare the Four Plans <span>↓</span>
          </a>
        </div>
        <p class="cta-microcopy">
          No payment or plan selection is required to request a review.
        </p>
      </div>
    </section>

    <PageJumpNav
      items={[
        ["Choose a plan", "#plan-selector"],
        ["Plans", "#plans"],
        ["What is included", "#included"],
        ["Count inquiries", "#count-inquiries"],
        ["Questions", "#pricing-questions"],
      ]}
    />

    <section
      class="plan-selector-section"
      id="plan-selector"
      aria-labelledby="selector-heading"
    >
      <div class="container plan-selector" data-reveal>
        <div>
          <p class="eyebrow">
            <span></span> Find your plan
          </p>
          <h2 id="selector-heading">
            About how many hard inquiries do you want reviewed?
          </h2>
        </div>
        <div
          class="plan-selector__controls"
          role="group"
          aria-label="Choose an estimated hard inquiry count"
        >
          {plans.map((plan) => (
            <button
              type="button"
              data-plan-choice={plan.id}
              aria-pressed="false"
            >
              {plan.rangeLabel} <span>See {plan.name}</span>
            </button>
          ))}
          <button type="button" data-plan-choice="review" aria-pressed="false">
            I’m not sure <span>Start with a free review</span>
          </button>
        </div>
        <div
          class="plan-selector__result"
          aria-live="polite"
          aria-atomic="true"
        >
          <span data-result-kicker>Choose a range above</span>
          <strong data-result-name>See the plan for your estimated count.</strong>
          <a
            class="button button--small"
            href="#plans"
            data-result-link
            data-track="pricing-selector-start"
          >
            View All Plans <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section waiting-cost">
      <div class="container waiting-cost__grid">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> A practical comparison
          </p>
          <h2>What Are You Paying Us to Handle?</h2>
          <p class="lead">
            You can dispute a factual error yourself for free. If you’d rather
            have someone organize several entries, prepare the disputes and
            make sense of the responses, that’s what the one-time plan covers.
          </p>
        </div>
        <ol class="waiting-cost__list" data-reveal>
          <li>Wait and monitor legitimate, accurately reported inquiries.</li>
          <li>
            <a class="inline-link" href="/how-to-dispute-a-hard-inquiry/">
              Dispute an error yourself for free
            </a>{" "}if you want to manage the paperwork.
          </li>
          <li>
            Consider broader help if the report issues extend beyond inquiries.
          </li>
          <li>
            Ask us to handle the inquiry work and follow-up if you’d rather
            not manage it yourself.
          </li>
        </ol>
      </div>
      <p class="container waiting-cost__summary" data-reveal>
        A plan covers the work in your agreement. It does not buy a guaranteed
        removal, score increase or approval.
      </p>
    </section>

    <section class="section pricing-page-plans" id="plans">
      <div class="container">
        <div class="pricing-heading" data-reveal>
          <p class="eyebrow centered">
            <span></span> Compare prices
          </p>
          <h2>Four Plans, Based on the Number of Inquiries</h2>
          <p>
            Use these ranges to estimate your price. Each plan covers the
            applicable work on the affected Experian, Equifax and TransUnion
            reports.
          </p>
        </div>
        <div class="pricing-plan-grid">
          {plans.map((plan) => (
            <article
              id={`plan-${plan.id}`}
              class="pricing-plan-card"
              data-reveal
            >
              <p class="pricing-plan-card__name">{plan.name}</p>
              <h3>{plan.price}</h3>
              <strong>One-time price</strong>
              <p class="pricing-plan-card__best">
                <b>Best for:</b> {plan.bestFor}
              </p>
              <ul>
                <li class="pricing-plan-card__count">
                  {plan.rangeLabel} total hard inquiries
                </li>
                {planFeatures.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
              <a
                class="button"
                href={`/free-inquiry-review/?plan=${plan.id}`}
                data-track={`pricing-card-${plan.id}`}
              >
                Ask About {plan.name} <span>→</span>
              </a>
            </article>
          ))}
        </div>
        <p class="below-card-note">
          Not sure which plan fits?{" "}
          <a href="/free-inquiry-review/?review=free">
            Get a free personal review before choosing.
          </a>
        </p>
      </div>
    </section>

    <section
      class="section comparison-section"
      aria-labelledby="comparison-heading"
    >
      <div class="container">
        <div class="comparison-heading" data-reveal>
          <p class="eyebrow">
            <span></span> Compare every plan
          </p>
          <h2 id="comparison-heading">
            The Work Is the Same at Every Price
          </h2>
        </div>
        <p class="pricing-table-hint" aria-hidden="true">
          Swipe to compare plans <span>→</span>
        </p>
        <div
          class="pricing-table-wrap"
          data-reveal
          tabindex="0"
          role="region"
          aria-label="Scrollable pricing comparison"
        >
          <table class="pricing-table">
            <thead>
              <tr>
                <th scope="col">Included</th>
                {plans.map((plan) => (
                  <th scope="col">{plan.name}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {comparisonRows.map((row) => (
                <tr>
                  {row.map((cell, index) =>
                    index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>,
                  )}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section included-section" id="included">
      <div class="container">
        <div class="included-heading" data-reveal>
          <p class="eyebrow">
            <span></span> The same complete service
          </p>
          <h2>What We Handle Under Every Plan</h2>
          <p class="lead">
            You’ll know which entries we’re working on, what we sent and what
            the replies mean. You don’t need to manage the dispute paperwork
            yourself.
          </p>
        </div>
        <div class="included-grid">
          {included.map(([title, body], index) => (
            <article data-reveal>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
        <a class="text-link" href="/how-it-works/">
          See How the Inquiry Removal Process Works <span>→</span>
        </a>
      </div>
    </section>

    <PracticalContent slug="pricing" />
    <section class="section counting-section dark-section" id="count-inquiries">
      <div class="container">
        <div class="counting-heading" data-reveal>
          <p class="eyebrow eyebrow--light">
            <span></span> You do not have to guess
          </p>
          <h2>How We Confirm Your Inquiry Count</h2>
          <p>
            If the same lender appears on more than one report, point it out
            during your review. We’ll explain which entries are included and
            how they affect the price.
          </p>
        </div>
        <div class="counting-grid">
          {countingSteps.map(([title, body], index) => (
            <article data-reveal>
              <>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </>
            </article>
          ))}
        </div>
        <div class="button-row">
          <a
            class="button"
            href="/free-inquiry-review/?review=free"
            data-track="pricing-help-choose"
          >
            {revision.primaryCta} <span>→</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section faq-section" id="pricing-questions">
      <div class="container faq-layout">
        <div data-reveal>
          <p class="eyebrow">
            <span></span> Clear answers
          </p>
          <h2>Hard Inquiry Removal Pricing Questions</h2>
          <p>
            Still deciding whether this is the right service? See{" "}
            <a class="inline-link" href="/faq/">
              common questions about hard inquiry removal
            </a>{" "}
            or{" "}
            <a class="inline-link" href="/situations-we-handle/">
              hard inquiry situations we handle
            </a>
            .
          </p>
        </div>
        <div class="faq-list" data-reveal>
          {faqs.map(([question, answer]) => (
            <details>
              <>
                <summary>
                  {question}
                  <span aria-hidden="true" />
                </summary>
                <p>{answer}</p>
              </>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="final-cta dark-section pricing-final-cta">
      <div class="container" data-reveal>
        <p class="eyebrow eyebrow--light centered">
          <span></span> Start with an estimate
        </p>
        <h2>Confirm Your Price Before You Decide</h2>
        <p>
          Tell us what’s on your reports, even if you’re not sure of the count.
          We’ll help you see whether the service fits and which plan covers
          the work.
        </p>
        <div class="button-row button-row--center">
          <a
            class="button button--large"
            href="/free-inquiry-review/?plan=help"
            data-track="pricing-final-start"
          >
            {revision.primaryCta} <span>→</span>
          </a>
          <a
            class="text-link text-link--light"
            href="#plans"
            data-track="pricing-final-review"
          >
            Back to the Four Plans <span>↑</span>
          </a>
        </div>
        <p class="cta-microcopy">
          The review is free and does not enroll you in a plan.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { PRICING_PLANS } from "../data/pricing";
  const choices =
    document.querySelectorAll<HTMLButtonElement>("[data-plan-choice]");
  const resultKicker = document.querySelector<HTMLElement>(
    "[data-result-kicker]",
  );
  const resultName = document.querySelector<HTMLElement>("[data-result-name]");
  const resultLink =
    document.querySelector<HTMLAnchorElement>("[data-result-link]");
  const results: Record<string, string[]> = {
    ...Object.fromEntries(
      PRICING_PLANS.map((plan) => [
        plan.id,
        [
          `${plan.rangeLabel} inquiries`,
          `${plan.name} · ${plan.price} one time`,
          `#plan-${plan.id}`,
          `See ${plan.name}`,
        ],
      ]),
    ),
    review: [
      "Not sure of your count?",
      "We can help confirm which inquiries are in scope.",
      "/free-inquiry-review/?review=free",
      "Start My Free Review",
    ],
  };

  choices.forEach((choice) => {
    choice.addEventListener("click", () => {
      const key = choice.dataset.planChoice as keyof typeof results;
      const [kicker, name, href, label] = results[key];
      choices.forEach((button) => {
        button.classList.toggle("is-selected", button === choice);
        button.setAttribute("aria-pressed", String(button === choice));
      });
      if (resultKicker) resultKicker.textContent = kicker;
      if (resultName) resultName.textContent = name;
      if (resultLink) {
        resultLink.href = href;
        resultLink.innerHTML = `${label} <span>→</span>`;
      }
    });
  });
</script>
