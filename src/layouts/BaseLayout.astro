---
import { localBusinessSchema, organizationSchema, websiteSchema } from "@/lib/schema";
import MobileDock from "../components/MobileDock.astro";
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/utilities.css";

const {
  title,
  description,
  canonicalPath,
  ogImage = "/og/home.png",
  ogImageAlt = "Inquiry Removal hard inquiry removal service preview.",
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogImageType = "image/png",
  schema = [],
  pathname = "/",
} = Astro.props;

function normalizeCanonicalPath(path = "/") {
  const cleanPath = path || "/";
  const [pathnameWithMaybeHash, search = ""] = cleanPath.split("?");
  const [pathnameOnly, hash = ""] = pathnameWithMaybeHash.split("#");
  const lastSegment = pathnameOnly.split("/").filter(Boolean).pop() || "";
  const looksLikeFile = /\.[a-z0-9]{2,8}$/i.test(lastSegment);
  const normalizedPath = pathnameOnly === "/" || looksLikeFile || pathnameOnly.endsWith("/")
    ? pathnameOnly
    : `${pathnameOnly}/`;
  return `${normalizedPath}${hash ? `#${hash}` : ""}${search ? `?${search}` : ""}`;
}

const siteOrigin = import.meta.env.SITE_URL || "https://www.inquiryremoval.com";
const pageUrl = new URL(normalizeCanonicalPath(canonicalPath), siteOrigin).toString();
const socialImageUrl = new URL(ogImage, siteOrigin).toString();
const extraSchema = Array.isArray(schema) ? schema : [schema];
// If the current page isn't the homepage, generate a BreadcrumbList schema.
const breadcrumbSchema = pathname && pathname !== "/"
  ? (() => {
	      // Derive a text-only version of the title. If title is not a string,
	      // coerce it before calling replace().
      const titleText = typeof title === "string" ? title : String(title);
      return {
        "@type": "BreadcrumbList",
        itemListElement: [
          {
            "@type": "ListItem",
            position: 1,
            name: "Home",
            item: `${siteOrigin}/`,
          },
          {
            "@type": "ListItem",
            position: 2,
            name: titleText.replace(/<[^>]*>?/gm, ""), // strip any HTML tags
            item: pageUrl,
          },
        ],
      };
    })()
  : null;
const schemaPayload = [
  organizationSchema,
  localBusinessSchema,
  websiteSchema,
  ...extraSchema,
  breadcrumbSchema,
].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js-enabled");</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="Inquiry Removal" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" content="#0A0A0F" />
    {Astro.props.robots ? (
      <meta
        name="robots"
        content={`${Astro.props.robots.index === false ? 'noindex' : 'index'}, ${Astro.props.robots.follow === false ? 'nofollow' : 'follow'}`}
      />
    ) : null}
    <link rel="icon" href="/favicon.png" sizes="64x64" type="image/png" />
    <link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
      {
        schemaPayload.map((item) => (
          <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
        ))
      }
    <script type="speculationrules" is:inline>
      {JSON.stringify({
        prerender: [
          {
            urls: ["/get-started/", "/pricing/", "/services/"],
            eagerness: "moderate",
          },
        ],
        prefetch: [
          {
            urls: ["/results/", "/about/", "/how-it-works/"],
            eagerness: "moderate",
          },
        ],
      })}
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <slot />
    <MobileDock pathname={pathname} />
    <script type="module" is:inline>
      (() => {
        // Instant page warm on hover/touch/focus
        const seen = new Set();
        const conn = navigator.connection || {};
        const canPrefetch = conn.saveData !== true && !/(^2g$|^slow-2g$)/i.test(conn.effectiveType || '');

        const isInternal = (anchor) => {
          if (!anchor || anchor.target || anchor.hasAttribute('download')) return false;
          const href = anchor.getAttribute('href') || '';
          if (!href || href.startsWith('#') || href.startsWith('tel:') || href.startsWith('mailto:')) return false;
          const url = new URL(href, location.href);
          return url.origin === location.origin && !url.pathname.match(/\.[a-z]{2,8}(?:$|\?)/i);
        };

        const warm = (anchor) => {
          if (!canPrefetch || !isInternal(anchor)) return;
          const url = new URL(anchor.href);
          url.hash = '';
          url.search = '';
          if (!url.pathname.endsWith('/')) url.pathname += '/';
          const key = url.href;
          if (seen.has(key)) return;
          seen.add(key);
          fetch(key, {
            credentials: 'same-origin',
            headers: { accept: 'text/html' },
            cache: 'force-cache',
            priority: 'low',
          }).catch(() => {});
        };

        const onIntent = (e) => {
          const anchor = e.target instanceof Element ? e.target.closest('a[href]') : null;
          if (anchor) warm(anchor);
        };

        addEventListener('pointerover', onIntent, { capture: true, passive: true });
        addEventListener('touchstart', onIntent, { capture: true, passive: true });
        addEventListener('focusin', onIntent, { passive: true });
      })();

    </script>
  </body>
</html>
