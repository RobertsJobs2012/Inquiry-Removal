---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { SITE_ORIGIN } from "../data/discovery.mjs";

interface Props {
  title: string;
  description: string;
  theme?: "dark" | "light";
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  robots?: string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  theme = "light",
  ogTitle = title,
  ogDescription = description,
  ogImage = "/og.jpg",
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  schema,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE_ORIGIN);
const socialImage = new URL(ogImage, canonical);
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const bingSiteVerification = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${canonical.href}#webpage`,
  url: canonical.href,
  name: title,
  description,
  inLanguage: "en-US",
  isPartOf: { "@id": `${SITE_ORIGIN}/#website` },
  about: { "@id": `${SITE_ORIGIN}/#organization` },
};
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${SITE_ORIGIN}/#organization`,
  name: "Inquiry Removal",
  url: `${SITE_ORIGIN}/`,
  telephone: "+1-602-377-6626",
  founder: { "@id": `${SITE_ORIGIN}/about/#robert-garcia` },
  areaServed: { "@type": "Country", name: "United States" },
  logo: {
    "@type": "ImageObject",
    url: `${SITE_ORIGIN}/brand/logo-mark-dark.png`,
    width: 512,
    height: 512,
  },
};
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE_ORIGIN}/#website`,
  name: "Inquiry Removal",
  url: `${SITE_ORIGIN}/`,
  publisher: { "@id": `${SITE_ORIGIN}/#organization` },
  inLanguage: "en-US",
};
const schemaGraph = schema
  ? [
      organizationSchema,
      websiteSchema,
      pageSchema,
      ...(Array.isArray(schema) ? schema : [schema]),
    ]
  : [organizationSchema, websiteSchema, pageSchema];
const serializedSchema = JSON.stringify(schemaGraph).replaceAll("<", "\\u003c");
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {
      googleSiteVerification && (
        <meta
          name="google-site-verification"
          content={googleSiteVerification}
        />
      )
    }
    {
      bingSiteVerification && (
        <meta name="msvalidate.01" content={bingSiteVerification} />
      )
    }
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#081B2C" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Inquiry Removal" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Inquiry Removal — Hard Inquiry Specialists. Nothing Else."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" />
    <link
      rel="icon"
      href="/brand/logo-mark-dark.png"
      type="image/png"
      sizes="512x512"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      href="/brand/logo-mark-light.png"
      type="image/png"
      sizes="512x512"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="manifest" href="/site.webmanifest" />
    <script is:inline type="application/ld+json" set:html={serializedSchema} />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      onload="this.setAttribute('rel','stylesheet')"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Newsreader:opsz,wght@6..72,500&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap"
      />
    </noscript>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
    <Analytics />
    <SpeedInsights />
    <script>
      import { track } from "@vercel/analytics";

      document.addEventListener("click", (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;

        const link = target.closest<HTMLAnchorElement>(
          "a[data-track], a[href^='tel:']",
        );
        if (!link) return;

        const isCall = link.href.startsWith("tel:");
        const eventName = isCall
          ? "Call Intent"
          : (link.dataset.event ?? "Review Form Open");
        track(eventName, {
          placement: link.dataset.track ?? "sitewide",
          context: link.dataset.context ?? "general",
          page: window.location.pathname,
        });
      });
    </script>
    <script is:inline>
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (!reduceMotion) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting)
                entry.target.classList.add("is-visible");
            });
          },
          { threshold: 0.12 },
        );
        document
          .querySelectorAll("[data-reveal]")
          .forEach((node) => observer.observe(node));
      } else {
        document
          .querySelectorAll("[data-reveal]")
          .forEach((node) => node.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
