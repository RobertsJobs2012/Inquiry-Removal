{
  "name": "inquiry-removal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "check:routes": "node scripts/route-hygiene.mjs",
    "check:pricing": "node --test scripts/pricing.test.mjs",
    "check:intake": "node --test scripts/intake.test.mjs",
    "check:security": "node --test scripts/security-policy.test.mjs",
    "check:indexnow": "node --test scripts/indexnow.test.mjs",
    "check:tools": "node --test scripts/inquiry-tools.test.mjs",
    "check:editorial": "node scripts/editorial-audit.mjs",
    "check:secrets": "node scripts/run-secret-scan.mjs",
    "build": "npm run check:pricing && npm run check:intake && npm run check:security && npm run check:indexnow && npm run check:tools && npm run check:routes && astro check && tsc --noEmit && astro build && node scripts/discovery-audit.mjs && node scripts/technical-audit.mjs && node scripts/security-policy.mjs && node scripts/build-budgets.mjs && npm run check:editorial",
    "check:discovery": "node scripts/discovery-audit.mjs",
    "check:technical": "node scripts/technical-audit.mjs",
    "indexnow:dry-run": "node scripts/submit-indexnow.mjs --dry-run",
    "indexnow:submit": "node scripts/submit-indexnow.mjs --live",
    "smoke:live": "node scripts/live-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3"
  }
}
