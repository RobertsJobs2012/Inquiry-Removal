{
  "name": "inquiry-removal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit",
    "build": "astro check && tsc --noEmit && astro build && node scripts/discovery-audit.mjs && node scripts/technical-audit.mjs",
    "check:discovery": "node scripts/discovery-audit.mjs",
    "check:technical": "node scripts/technical-audit.mjs",
    "smoke:live": "node scripts/live-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "6.0.3"
  }
}
